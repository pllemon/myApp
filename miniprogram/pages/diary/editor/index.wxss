/* 编辑页独有：输入区与选择面板（布局/状态走 m2-* 全局类） */
.title-field { padding: 8rpx 0; }
.title-input { font-size: var(--font-xl); font-weight: 700; color: var(--text); text-align: left; }

.editor-content-wrap { position: relative; padding: 12rpx 0 48rpx; }
.editor-content { width: 100%; min-height: 320rpx; font-size: var(--font-base); color: var(--text); line-height: 1.7; box-sizing: border-box; }
.content-counter { position: absolute; right: 8rpx; bottom: 12rpx; font-size: var(--font-sm); color: var(--text-3); }

.field-arrow { font-size: var(--font-sm); color: var(--text-3); margin-left: 8rpx; }
.picker-value { text-align: right; }
.picker-chips { border-bottom: 1rpx solid var(--border); }
.mood-item, .weather-item { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.mood-label { font-size: var(--font-sm); color: var(--text-2); }
.weather-clear { width: 100%; text-align: center; font-size: var(--font-md); color: var(--danger); padding: 12rpx 0; }

.tag-manager { padding: 8rpx 0; }
.tag-section { margin-bottom: 20rpx; }
.tag-section-title { font-size: var(--font-md); color: var(--text-2); margin-bottom: 12rpx; }
.tag-remove { margin-left: 8rpx; color: var(--danger); font-weight: 700; }
.add-tag-row { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; }
.tag-input { flex: 1; background: var(--surface-2); border-radius: var(--radius-full); padding: 12rpx 24rpx; font-size: var(--font-md); }
.add-tag-btn { font-size: var(--font-md); color: var(--text-inverse); background: linear-gradient(135deg, var(--primary), var(--primary-dark)); padding: 12rpx 28rpx; border-radius: var(--radius-full); }
.selected-tag { pointer-events: none; }
.no-tags { font-size: var(--font-md); color: var(--text-3); padding: 8rpx 0; }
