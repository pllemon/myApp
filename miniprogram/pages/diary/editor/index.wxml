<view class="m2-page m2-edit" style="{{themeStyle}}">
  <view class="m2-edit-hero">
    <view class="m2-edit-hero-icon" style="background: var(--primary-light)"><m-icon name="note" size="48" /></view>
    <view>
      <view class="m2-edit-title">{{isEdit ? '编辑日记' : '写一篇日记'}}</view>
      <view class="m2-edit-desc">记录今天的心情、天气与想法</view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-field title-field">
      <input class="m2-field-value title-input" placeholder="今天的标题..." value="{{title}}" bindinput="onTitleInput" maxlength="30" />
    </view>
    <view class="editor-content-wrap">
      <textarea
        class="editor-content"
        placeholder="今天发生了什么？记录下你的想法和感受吧~ 试试#标签# 可以添加标签"
        value="{{content}}"
        bindinput="onContentInput"
        auto-height
        maxlength="2000"
      />
      <view class="content-counter">{{contentLen}}/2000</view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">图片</view>
    <m-image-picker images="{{images}}" bind:change="onImagesChange" />
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">日记信息</view>

    <view class="m2-field" bindtap="toggleMoodPicker">
      <view class="m2-field-label">心情</view>
      <view class="m2-field-value {{mood ? '' : 'placeholder'}}">
        <m-icon wx:if="{{mood}}" value="{{mood}}" tone="category" size="36" inline /> {{moodLabel || '未选择'}}
      </view>
      <text class="field-arrow">{{showMoodPicker ? '▲' : '▼'}}</text>
    </view>
    <view wx:if="{{showMoodPicker}}" class="m2-chip-row picker-chips">
      <view
        wx:for="{{moodOptions}}"
        wx:key="emoji"
        class="m2-chip mood-item {{mood === item.value ? 'active' : ''}}"
        data-emoji="{{item.emoji}}"
        data-value="{{item.value}}"
        bindtap="selectMood"
      >
        <m-icon value="{{item.value}}" size="44" tone="category" />
        <text class="mood-label">{{item.label}}</text>
      </view>
      <view wx:if="{{mood}}" class="weather-clear" bindtap="clearMood"><m-icon name="close" size="24" inline /> 清除</view>
    </view>

    <view class="m2-field" bindtap="toggleWeatherPicker">
      <view class="m2-field-label">天气</view>
      <view class="m2-field-value {{weather ? '' : 'placeholder'}}">
        <m-icon wx:if="{{weather}}" value="{{weather}}" tone="category" size="32" inline /> {{weatherLabel || '未选择'}}
      </view>
      <text class="field-arrow">{{showWeatherPicker ? '▲' : '▼'}}</text>
    </view>
    <view wx:if="{{showWeatherPicker}}" class="m2-chip-row picker-chips">
      <view
        wx:for="{{weatherOptions}}"
        wx:key="label"
        class="m2-chip weather-item {{weather === item.value ? 'active' : ''}}"
        data-label="{{item.label}}"
        data-value="{{item.value}}"
        bindtap="selectWeather"
      >
        <m-icon value="{{item.value}}" size="40" tone="category" />
        <text class="mood-label">{{item.label}}</text>
      </view>
      <view wx:if="{{weather}}" class="weather-clear" bindtap="clearWeather"><m-icon name="close" size="24" inline /> 清除</view>
    </view>

    <view class="m2-field">
      <view class="m2-field-label">日期</view>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="m2-field-value picker-value">{{date}}</view>
      </picker>
      <view class="m2-field-arrow"><m-icon name="chevronRight" size="28" inline /></view>
    </view>

    <view class="m2-field">
      <view class="m2-field-label">地点</view>
      <input class="m2-field-value" placeholder="地点（可选）" value="{{location}}" bindinput="onLocationInput" />
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-card-head">
      <view class="m2-card-title">标签</view>
      <view class="m2-card-action tag-toggle" bindtap="toggleTagManager">{{showTagManager ? '收起' : '管理'}} ›</view>
    </view>

    <view wx:if="{{showTagManager}}" class="tag-manager">
      <view class="tag-section">
        <view class="tag-section-title">预设标签</view>
        <view class="m2-chip-row">
          <view
            wx:for="{{presetTags}}"
            wx:key="*this"
            class="m2-chip {{tags.indexOf(item) >= 0 ? 'active' : ''}}"
            data-tag="{{item}}"
            bindtap="toggleTag"
          >#{{item}}</view>
        </view>
      </view>

      <view class="tag-section" wx:if="{{customTags.length > 0}}">
        <view class="tag-section-title">自定义标签</view>
        <view class="m2-chip-row">
          <view
            wx:for="{{customTags}}"
            wx:key="*this"
            class="m2-chip {{tags.indexOf(item) >= 0 ? 'active' : ''}}"
            data-tag="{{item}}"
            bindtap="toggleTag"
          >
            #{{item}}
            <view class="tag-remove" data-tag="{{item}}" catchtap="removeCustomTag"><m-icon name="close" size="24" inline /></view>
          </view>
        </view>
      </view>

      <view class="add-tag-row">
        <input class="tag-input" placeholder="添加自定义标签" value="{{newTag}}" bindinput="onNewTagInput" maxlength="10" />
        <view class="add-tag-btn" bindtap="addCustomTag">添加</view>
      </view>
    </view>

    <view class="m2-chip-row" wx:if="{{tags.length > 0}}">
      <view wx:for="{{tags}}" wx:key="*this" class="m2-chip active selected-tag">#{{item}}</view>
    </view>
    <view wx:if="{{tags.length === 0 && !showTagManager}}" class="no-tags">点击管理添加标签</view>
  </view>

  <m-save-bar save-text="保存" bind:save="save" />
</view>
