/* 页面独有样式：骨架屏 / 日历 / 日记行补充（布局与状态走 m2-* 全局类） */
.skeleton-wrap { padding-top: 24rpx; }
.m2-skeleton { background: var(--surface-2); border-radius: var(--radius-md); margin-bottom: 20rpx; animation: sk-blink 1.2s ease-in-out infinite; }
.sk-hero { height: 240rpx; border-radius: 36rpx; }
.sk-line { height: 28rpx; width: 80%; }
.sk-line.short { width: 50%; }
.sk-card { height: 180rpx; background: var(--surface); }
@keyframes sk-blink { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }

.hero-actions { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; justify-content: flex-end; }

.diary-calendar { padding: 28rpx; }
.cal-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.cal-nav-btn { width: 64rpx; height: 64rpx; border-radius: var(--radius-sm); background: var(--surface-2); display: flex; align-items: center; justify-content: center; }
.cal-prev { transform: rotate(180deg); }
.cal-month { font-size: var(--font-lg); font-weight: 700; color: var(--text); }
.cal-weekdays { display: flex; margin-bottom: 8rpx; }
.cal-weekdays text { flex: 1; text-align: center; font-size: var(--font-sm); color: var(--text-3); }
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell { width: calc(100% / 7); height: 92rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: var(--radius-sm); }
.cal-cell.empty { visibility: hidden; }
.cal-cell.has { background: var(--primary-light); }
.cal-cell.selected { background: var(--primary); }
.cal-day { font-size: var(--font-md); color: var(--text); }
.cal-cell.selected .cal-day { color: var(--text-inverse); }
.cal-mood { display: flex; align-items: center; justify-content: center; }
.cal-detail { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--border); }
.cal-detail-title { font-size: var(--font-md); font-weight: 600; color: var(--text-2); margin-bottom: 8rpx; }
.cal-diary { min-height: 88rpx; }
.cal-tip { font-size: var(--font-sm); color: var(--text-3); text-align: center; margin-top: 16rpx; }

.diary-row { align-items: flex-start; }
.diary-row-icon { background: var(--primary-light); }
.diary-row-head { display: flex; align-items: center; gap: 12rpx; }
.diary-weather { flex-shrink: 0; font-size: var(--font-sm); color: var(--text-2); background: var(--surface-2); padding: 4rpx 12rpx; border-radius: var(--radius-xs); }
.diary-row-meta { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.diary-date, .diary-tags { font-size: var(--font-sm); color: var(--text-3); }
.diary-tags { color: var(--primary-dark); max-width: 340rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.diary-thumb { width: 120rpx; height: 120rpx; border-radius: var(--radius-sm); flex-shrink: 0; }
