.stats-header {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary-light) 0%, #FFFFFF 100%);
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(74, 144, 217, 0.08);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background-color: rgba(74, 144, 217, 0.2);
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 8rpx;
}

.toolbar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.toolbar-search {
  font-size: 26rpx;
  color: var(--primary);
}

.search-box {
  margin-bottom: 20rpx;
}

.search-input {
  background-color: #FFFFFF;
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.date-group {
  margin-bottom: 32rpx;
}

.date-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 8rpx 12rpx;
  margin-bottom: 16rpx;
  background-color: rgba(0, 0, 0, 0.02);
  border-radius: 8rpx;
  display: inline-block;
}

.diary-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.diary-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
  display: flex;
  gap: 20rpx;
}

.diary-main {
  flex: 1;
  min-width: 0;
}

.diary-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.diary-mood-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.diary-mood {
  font-size: 40rpx;
}

.diary-weather {
  font-size: 24rpx;
  color: var(--text-secondary);
  background-color: #F5F5F5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.diary-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.diary-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.diary-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.diary-tags {
  color: var(--primary);
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}


