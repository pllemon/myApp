.detail-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.detail-header {
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.detail-date-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.detail-date {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}

.detail-date-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.detail-info-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.info-item {
  font-size: 28rpx;
  padding: 6rpx 16rpx;
  background-color: var(--primary-light);
  color: var(--primary);
  border-radius: 20rpx;
}

.detail-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.detail-content {
  font-size: 30rpx;
  color: var(--text);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 32rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}

.detail-tag {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  background-color: #F5F5F5;
  color: var(--text-secondary);
  border-radius: 16rpx;
}

.detail-stats {
  display: flex;
  justify-content: space-between;
  padding-top: 24rpx;
  margin-top: 24rpx;
  border-top: 1rpx solid #F0F0F0;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.action-bar {
  display: flex;
  justify-content: space-around;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 32rpx;
}

.action-icon {
  font-size: 44rpx;
}

.action-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.action-btn.edit .action-text {
  color: var(--primary);
}

.action-btn.copy .action-text {
  color: var(--success);
}

.action-btn.share .action-text {
  color: var(--warning);
}

.action-btn.delete .action-text {
  color: var(--danger);
}