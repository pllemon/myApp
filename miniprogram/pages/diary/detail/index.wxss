/* 详情页独有：徽章排布 / 图片网格（状态与布局走 m2-detail-* 全局类） */
.badge-row { display: flex; flex-wrap: wrap; margin-top: 4rpx; }
.m2-detail-images { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; }
.m2-detail-image { width: calc((100% - 24rpx) / 3); aspect-ratio: 1; border-radius: var(--radius-md); overflow: hidden; background: var(--surface-2); }
.m2-detail-image image { width: 100%; height: 100%; display: block; }
.tag-row { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--border); }
.m2-btn { gap: 8rpx; font-size: var(--font-md); }
