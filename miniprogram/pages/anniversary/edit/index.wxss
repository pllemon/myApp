.preview {
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}
.preview-icon {
  font-size: 64rpx;
  margin-right: 20rpx;
}
.preview-title {
  font-size: 36rpx;
  font-weight: 600;
  opacity: 0.95;
}

.m-form-label:first-child { margin-top: 0; }

.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.icon-cell {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  border: 2rpx solid transparent;
}
.icon-active {
  background: var(--primary-light);
  border-color: var(--primary);
}

.color-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.color-cell {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}
.color-active {
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 3rpx var(--primary), 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}
.color-check {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: 2rpx solid var(--divider);
  color: var(--text-secondary);
  background: var(--bg-card);
}

.date-arrow {
  font-size: 40rpx;
  color: var(--text-secondary);
}
