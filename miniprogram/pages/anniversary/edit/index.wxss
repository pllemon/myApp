/* 纪念日编辑独有：渐变预览 Hero（表单字段与底部按钮走 m2-* 全局类） */
.m2-edit-hero.anni-edit-hero { color: var(--text-inverse); }
.m2-edit-hero.anni-edit-hero .m2-edit-title { color: var(--text-inverse); }
.m2-edit-hero.anni-edit-hero .m2-edit-desc { color: var(--text-inverse); opacity: .85; }
/* 图标/颜色选择器在字段行内自适应宽度 */
.m2-field > m-icon-picker,
.m2-field > m-color-picker { flex: 1; min-width: 0; }
