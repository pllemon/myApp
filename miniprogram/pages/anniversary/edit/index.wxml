<view class="m2-page m2-edit" style="{{themeStyle}}">
  <!-- 编辑 Hero：实时预览 -->
  <view class="m2-edit-hero anni-edit-hero" style="background: linear-gradient(135deg, {{color}} 0%, {{colorTranslucent}} 100%);">
    <view class="m2-edit-hero-icon" style="background: var(--surface)"><m-icon value="{{icon}}" size="48" /></view>
    <view>
      <view class="m2-edit-title">{{title || '纪念日名称'}}</view>
      <view class="m2-edit-desc">{{isEdit ? '编辑纪念日' : '新建纪念日'}} · 记录值得纪念的日子</view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="m2-form-card">
    <view class="m2-form-title">基本信息</view>
    <view class="m2-field">
      <view class="m2-field-label">名称</view>
      <input class="m2-field-value" placeholder="例如：结婚纪念日" value="{{title}}" maxlength="30" bindinput="onTitleInput" focus="{{!isEdit}}" />
    </view>
    <view class="m2-field">
      <view class="m2-field-label">图标</view>
      <m-icon-picker icons="{{icons}}" value="{{icon}}" bind:select="selectIcon" />
    </view>
    <view class="m2-field">
      <view class="m2-field-label">颜色</view>
      <m-color-picker colors="{{colors}}" color="{{color}}" bind:change="selectColor" />
    </view>
    <view class="m2-field">
      <view class="m2-field-label">重复</view>
      <view class="m2-chip-row">
        <view
          wx:for="{{repeatOptions}}"
          wx:key="key"
          class="m2-chip {{repeat === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="selectRepeat"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="m2-field">
      <view class="m2-field-label">日期</view>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="m2-field-value">{{date || '未选择'}}</view>
      </picker>
      <view class="m2-field-arrow">›</view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="m2-form-card">
    <view class="m2-form-title">备注</view>
    <textarea class="m2-field-value" placeholder="补充说明（可选）" value="{{note}}" maxlength="200" bindinput="onNoteInput" auto-height />
  </view>

  <!-- 纪念图片 -->
  <view class="m2-form-card">
    <view class="m2-form-title">纪念图片</view>
    <m-image-picker images="{{images}}" bind:change="onImagesChange" />
  </view>

  <view class="m2-footer">
    <view class="m2-btn m2-btn-primary" bindtap="save">保存</view>
    <view wx:if="{{isEdit}}" class="m2-btn m2-btn-danger" bindtap="remove">删除</view>
  </view>
</view>
