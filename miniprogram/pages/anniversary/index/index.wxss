/* 纪念日列表独有：空态 Hero / 封面图标 / 倒计时状态色（segment、列表、FAB 走 m2-* 全局类） */
.m2-hero.hero-empty { background: var(--surface); color: var(--text); }

.anni-row-icon { width: 80rpx; height: 80rpx; border-radius: 20rpx; }
.anni-icon-img { width: 100%; height: 100%; border-radius: 20rpx; }
.anni-countdown { color: var(--primary); }
.anni-countdown.anni-today { color: var(--danger); }
.anni-countdown.anni-past { color: var(--text-3); font-weight: 400; }
