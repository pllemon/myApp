.hero-card {
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}
.hero-empty {
  background: var(--bg-card);
  color: var(--text);
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.hero-top {
  display: flex;
  align-items: center;
}
.hero-icon {
  font-size: 52rpx;
  margin-right: 16rpx;
}
.hero-empty .hero-icon { margin: 0 0 12rpx; }
.hero-title {
  font-size: 34rpx;
  font-weight: 600;
}
.hero-empty .hero-title { justify-content: center; font-size: 30rpx; }
.hero-days {
  display: flex;
  align-items: baseline;
  margin-top: 20rpx;
}
.hero-num {
  font-size: 88rpx;
  font-weight: 700;
  line-height: 1;
  margin-right: 12rpx;
}
.hero-unit {
  font-size: 28rpx;
  opacity: 0.9;
}
.hero-sub {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 12rpx;
}
.hero-empty .hero-sub { color: var(--text-secondary); opacity: 1; }

.anni-list { padding-bottom: 180rpx; }
.anni-card {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.anni-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: #F0F0F0;
}
.anni-icon-img {
  width: 100%;
  height: 100%;
}
.anni-body { flex: 1; min-width: 0; }
.anni-title {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}
.anni-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}
.anni-countdown {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
  flex-shrink: 0;
  margin-left: 16rpx;
}
.anni-today { color: var(--danger); }
.anni-past { color: var(--text-secondary); font-weight: 400; }