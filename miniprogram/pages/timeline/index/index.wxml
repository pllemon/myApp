<view class="m2-page with-tabbar" style="{{themeStyle}}">
  <!-- 分段筛选 -->
  <view class="m2-segment">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="m2-seg-item {{item.active ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchFilter"
    >{{item.label}}</view>
  </view>

  <!-- 空态 -->
  <m-empty
    wx:if="{{showEmpty}}"
    title="还没有记录"
    desc="去各模块添加一些吧"
  />

  <!-- 时间线 -->
  <view wx:else class="timeline">
    <m-day-group
      wx:for="{{groups}}"
      wx:for-item="group"
      wx:key="dayKey"
      label="{{group.dayLabel}}"
      count="{{group.items.length}}"
      dot
      sticky
      bare
    >
      <view class="day-items">
        <view
          wx:for="{{group.items}}"
          wx:for-item="item"
          wx:key="_id"
          class="m2-row tl-item"
          data-path="{{item.targetPath}}"
          bindtap="goItem"
        >
          <view class="tl-time">{{item.timeLabel}}</view>
          <view class="m2-row-icon tl-icon" style="background:{{item.moduleColor}}"><m-icon value="{{item.moduleIcon}}" size="36" color="#FFFFFF" /></view>
          <view class="m2-row-body">
            <view class="tl-title-row">
              <text class="m2-row-title">{{item.title}}</text>
              <text wx:if="{{item.amount}}" class="tl-amount" style="color:{{item.amount[0] === '-' ? 'var(--danger)' : (item.amount[0] === '+' ? 'var(--success)' : item.moduleColor)}}">{{item.amount}}</text>
            </view>
            <view wx:if="{{item.subtitle}}" class="m2-row-sub">{{item.subtitle}}</view>
            <view class="tl-module" style="color:{{item.moduleColor}}">{{item.moduleLabel}}</view>
          </view>
        </view>
      </view>
    </m-day-group>
  </view>
</view>
<m-tab-bar id="tabbar" />
