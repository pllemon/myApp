/* 时间线工具独有：竖向时间轴 / 模块色标（segment、空态、列表行走 m2-* 全局类） */
.day-items { position: relative; padding-left: 48rpx; margin-bottom: 16rpx; }
.day-items::before { content: ''; position: absolute; left: 20rpx; top: 16rpx; bottom: -16rpx; width: 4rpx; background: var(--border); border-radius: 2rpx; }
.tl-item { align-items: flex-start; background: var(--surface); border-radius: 14rpx; padding: 20rpx 24rpx; margin-bottom: 12rpx; box-shadow: var(--shadow-sm); position: relative; }
.tl-item::before { content: ''; position: absolute; left: -36rpx; top: 28rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--surface); border: 4rpx solid var(--border); z-index: 2; }
.tl-time { font-size: 22rpx; color: var(--text-3); width: 72rpx; flex-shrink: 0; padding-top: 6rpx; }
.tl-icon { width: 56rpx; height: 56rpx; border-radius: 12rpx; }
.tl-title-row { display: flex; justify-content: space-between; align-items: center; }
.tl-amount { font-size: 28rpx; font-weight: 600; flex-shrink: 0; margin-left: 12rpx; }
.tl-module { font-size: 20rpx; margin-top: 6rpx; opacity: .7; }
