.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}
.timeline { padding-bottom: 100rpx; }

.day-header {
  display: flex;
  align-items: center;
  padding: 32rpx 0 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--bg);
}
.day-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-right: 16rpx;
}
.day-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  flex: 1;
}
.day-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.day-items {
  position: relative;
  padding-left: 48rpx;
  margin-bottom: 16rpx;
}
.day-items::before {
  content: '';
  position: absolute;
  left: 20rpx;
  top: 16rpx;
  bottom: -16rpx;
  width: 4rpx;
  background: var(--divider);
  border-radius: 2rpx;
}

.tl-item {
  display: flex;
  align-items: flex-start;
  background: var(--bg-card);
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  position: relative;
}
.tl-item::before {
  content: '';
  position: absolute;
  left: -36rpx;
  top: 28rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--bg-card);
  border: 4rpx solid var(--divider);
  z-index: 2;
}

.tl-time {
  font-size: 22rpx;
  color: var(--text-secondary);
  width: 72rpx;
  flex-shrink: 0;
  padding-top: 6rpx;
}
.tl-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.tl-body { flex: 1; min-width: 0; }
.tl-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.tl-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
  word-break: break-all;
  flex: 1;
}
.tl-amount {
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.tl-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tl-module {
  font-size: 20rpx;
  margin-top: 6rpx;
  opacity: 0.7;
}
