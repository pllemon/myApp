/* 番茄钟独有：计时圆环与专注反馈（segment、卡片、按钮走 m2-* 全局类） */
.pomo-page { display: flex; flex-direction: column; align-items: center; padding-top: 48rpx; }
.todo-link { display: inline-flex; align-items: center; gap: 8rpx; max-width: 90%; margin: 0 24rpx 20rpx; }
.todo-link-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.mode-bar { width: calc(100% - 48rpx); margin-bottom: 56rpx; }
.ring-wrap { display: flex; align-items: center; justify-content: center; padding: 28rpx; margin-bottom: 24rpx; }
.ring { width: 480rpx; height: 480rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.ring-inner { width: 380rpx; height: 380rpx; border-radius: 50%; background: var(--surface); display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: var(--shadow-sm); }
.ring-time { font-size: 88rpx; font-weight: 700; color: var(--text); letter-spacing: 4rpx; }
.ring-status { font-size: var(--font-md); color: var(--text-3); margin-top: 8rpx; }

.count-card { display: flex; align-items: center; justify-content: center; gap: 10rpx; font-size: var(--font-md); color: var(--text-2); }
