.pomo-page { display: flex; flex-direction: column; align-items: center; padding-top: 48rpx; }
.todo-link { display: flex; align-items: center; background: var(--primary-light); color: var(--primary); padding: 14rpx 28rpx; border-radius: 32rpx; font-size: 26rpx; margin-bottom: 32rpx; max-width: 90%; }
.todo-link-icon { margin-right: 10rpx; }
.todo-link-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.mode-bar { display: flex; background: var(--bg-card); border-radius: 40rpx; padding: 8rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); margin-bottom: 64rpx; }
.mode-item { padding: 16rpx 40rpx; font-size: 28rpx; color: var(--text-secondary); border-radius: 32rpx; }
.mode-active { background: var(--primary); color: #fff; font-weight: 600; }

.ring-wrap { margin-bottom: 64rpx; }
.ring { width: 480rpx; height: 480rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; position: relative; }
.ring-inner { width: 380rpx; height: 380rpx; border-radius: 50%; background: var(--bg-card); display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: inset 0 2rpx 12rpx rgba(0,0,0,0.04); }
.ring-time { font-size: 88rpx; font-weight: 600; color: var(--text); letter-spacing: 4rpx; }
.ring-status { font-size: 26rpx; color: var(--text-secondary); margin-top: 8rpx; }

.control-row { display: flex; gap: 24rpx; margin-bottom: 48rpx; }
.control-btn { padding: 22rpx 56rpx; border-radius: 48rpx; font-size: 30rpx; }
.control-primary { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); color: #fff; }
.control-pause { background: var(--warning); color: #fff; }
.control-ghost { background: var(--bg-card); color: var(--text-secondary); border: 1rpx solid var(--divider); }

.count-info { font-size: 26rpx; color: var(--text-secondary); }