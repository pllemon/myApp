<view class="m2-page pomo-page" style="{{themeStyle}}">
  <view wx:if="{{hasTodo}}" class="m2-badge todo-link">
    <m-icon name="link" size="28" inline />
    <text class="todo-link-text">{{todoTitle}}</text>
  </view>

  <view class="m2-segment mode-bar">
    <view
      wx:for="{{modes}}"
      wx:key="key"
      class="m2-seg-item {{mode === item.key ? 'mode-active active' : ''}}"
      data-key="{{item.key}}"
      bindtap="selectMode"
    >{{item.label}}</view>
  </view>

  <view class="m2-card ring-wrap">
    <view class="ring" style="background: conic-gradient({{ringColor}} {{progress * 100}}%, var(--surface-3) 0deg)">
      <view class="ring-inner">
        <view class="ring-time">{{display}}</view>
        <view class="ring-status">{{status === 'running' ? '专注中' : (status === 'paused' ? '已暂停' : (status === 'finished' ? '已完成' : '准备开始'))}}</view>
      </view>
    </view>
  </view>

  <view class="m2-card count-card">
    <m-icon name="star" size="32" tone="system" inline />
    <text>今日已完成 {{completedCount}} 个番茄</text>
  </view>

  <view class="m2-footer">
    <view wx:if="{{status !== 'running'}}" class="m2-btn m2-btn-primary" bindtap="start">{{status === 'paused' ? '继续' : '开始'}}</view>
    <view wx:else class="m2-btn m2-btn-ghost" bindtap="pause">暂停</view>
    <view class="m2-btn m2-btn-danger" bindtap="reset">重置</view>
  </view>
</view>
