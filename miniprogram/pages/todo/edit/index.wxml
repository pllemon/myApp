<view class="m2-page m2-edit" style="{{themeStyle}}">
  <view class="m2-edit-hero">
    <view class="m2-edit-hero-icon" style="background: var(--primary-light)"><m-icon name="note" size="48" /></view>
    <view>
      <view class="m2-edit-title">{{isEdit ? '编辑待办' : '新建待办'}}</view>
      <view class="m2-edit-desc">写下要做的事，剩下的交给清单</view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-field">
      <view class="m2-field-label">待办内容</view>
      <input class="m2-field-value title-input" placeholder="例如：完成项目周报" value="{{title}}" maxlength="60" bindinput="onTitleInput" focus="{{!isEdit}}" />
    </view>

    <m-field label="所属清单" click bind:fieldtap="openListPicker">
      <view class="m-form-picker-value">
        <text>{{selectedListName || '不指定清单'}}</text>
        <text class="m-picker-arrow">›</text>
      </view>
    </m-field>

    <view class="m2-field">
      <view class="m2-field-label">优先级</view>
      <view class="priority-row">
        <view
          wx:for="{{priorityOptions}}"
          wx:key="key"
          class="m2-chip priority-chip {{priority === item.key ? 'priority-active active' : ''}}"
          style="{{priority === item.key ? 'color:' + item.color + ';background:' + item.bg + ';border-color:' + item.color : ''}}"
          data-key="{{item.key}}"
          bindtap="selectPriority"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="m2-field">
      <view class="m2-field-label">截止日期</view>
      <picker mode="date" value="{{dueDate}}" bindchange="onDateChange">
        <view class="m2-field-value {{dueDate ? '' : 'placeholder'}}">{{dueDate || '选填'}}</view>
      </picker>
      <view wx:if="{{dueDate}}" class="date-clear" catchtap="clearDate"><m-icon name="close" size="24" inline /> 清除</view>
    </view>

    <view class="m2-field" wx:if="{{dueDate}}">
      <view class="m2-field-label">截止时间</view>
      <picker mode="time" value="{{dueTime}}" bindchange="onTimeChange">
        <view class="m2-field-value {{dueTime ? '' : 'placeholder'}}">{{dueTime ? '时间 ' + dueTime : '选填'}}</view>
      </picker>
      <view wx:if="{{dueTime}}" class="date-clear" catchtap="clearTime"><m-icon name="close" size="24" inline /> 清除</view>
    </view>

    <view class="m2-field" wx:if="{{dueDate}}">
      <view class="m2-field-label">标记提醒</view>
      <switch checked="{{remind}}" color="var(--primary)" bindchange="toggleRemind" />
    </view>

    <view class="m2-field" wx:if="{{dueDate}}">
      <view class="m2-field-label">重复</view>
      <picker mode="selector" range="{{repeatOptions}}" value="{{repeatIndex}}" bindchange="onRepeatChange">
        <view class="m2-field-value">{{repeatOptions[repeatIndex]}}</view>
      </picker>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">标签</view>
    <view class="m2-chip-row" wx:if="{{tags.length > 0}}">
      <view wx:for="{{tags}}" wx:key="*this" class="m2-chip active tag-chip">
        <text>#{{item}}</text>
        <view class="tag-close" data-tag="{{item}}" catchtap="removeTag"><m-icon name="close" size="24" inline /></view>
      </view>
    </view>
    <view class="tag-input-row">
      <input class="tag-input" placeholder="输入标签后按回车" value="{{newTag}}" bindinput="onNewTagInput" bindconfirm="addTag" />
      <view class="m2-btn m2-btn-ghost tag-add-btn" bindtap="addTag">添加</view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">子任务</view>
    <view class="subtask-list" wx:if="{{subtasks.length > 0}}">
      <view wx:for="{{subtasks}}" wx:key="index" class="subtask-item">
        <switch checked="{{item.done}}" color="var(--primary)" data-index="{{index}}" bindchange="toggleSubtask" />
        <input class="subtask-input {{item.done ? 'subtask-done' : ''}}" value="{{item.title}}" placeholder="子任务" data-index="{{index}}" bindinput="onSubtaskTitle" />
        <view class="subtask-del" data-index="{{index}}" catchtap="removeSubtask"><m-icon name="close" size="24" inline /></view>
      </view>
    </view>
    <view class="subtask-add-row">
      <input class="subtask-add-input" placeholder="添加子任务..." value="{{newSubtask}}" bindinput="onNewSubtaskInput" bindconfirm="addSubtask" />
      <view class="subtask-add-btn" bindtap="addSubtask"><m-icon name="add" size="36" color="#FFFFFF" /></view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">备注</view>
    <textarea class="m2-note note-input" placeholder="补充说明（可选）" value="{{note}}" maxlength="200" bindinput="onNoteInput" auto-height />
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">附件图片</view>
    <m-image-picker images="{{images}}" size="sm" bind:change="onImagesChange" />
  </view>

  <view wx:if="{{isEdit}}" class="focus-entry" bindtap="goPomodoro"><m-icon name="clock" size="32" inline /> 专注此任务</view>

  <m-save-bar save-text="保存" show-delete="{{isEdit}}" bind:save="save" bind:delete="remove" />

  <m-modal show="{{showListPicker}}" title="选择清单" bind:close="closeListPicker">
    <view class="list-picker-body">
      <view class="m2-row list-option {{!listId ? 'list-option-active active' : ''}}" bindtap="clearList">
        <view class="m2-row-icon list-option-icon"><m-icon name="inbox" size="36" tone="system" /></view>
        <view class="m2-row-body list-option-name">不指定</view>
      </view>
      <view
        wx:for="{{lists}}"
        wx:key="_id"
        class="m2-row list-option {{listId === item._id ? 'list-option-active active' : ''}}"
        data-id="{{item._id}}"
        bindtap="selectList"
      >
        <view class="m2-row-icon list-option-icon" style="background:{{item.color ? item.color + '20' : 'var(--primary-light)'}};color:{{item.color || 'var(--primary-dark)'}}"><m-icon value="{{item.icon || 'note'}}" size="36" /></view>
        <view class="m2-row-body list-option-name">{{item.name}}</view>
      </view>
    </view>
  </m-modal>
</view>
