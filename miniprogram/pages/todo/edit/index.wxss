/* 待办编辑独有：选择行 / 子任务 / 清单弹层（表单骨架走 m2-* 全局类） */
.title-input { font-size: var(--font-lg); font-weight: 600; text-align: left; }
.m-form-picker-value { display: flex; align-items: center; gap: 8rpx; }
.m-picker-arrow { font-size: var(--font-base); color: var(--text-3); }
.date-clear { font-size: var(--font-sm); color: var(--danger); margin-left: 8rpx; }

.priority-row { display: flex; gap: 12rpx; flex: 1; justify-content: flex-end; }
.priority-chip { padding: 10rpx 20rpx; border-color: var(--border); }

.tag-chip { gap: 4rpx; }
.tag-close { font-size: var(--font-sm); opacity: .7; margin-left: 4rpx; }
.tag-input-row { display: flex; gap: 12rpx; padding: 8rpx 0; }
.tag-input { flex: 1; font-size: var(--font-md); padding: 12rpx 20rpx; background: var(--surface-2); border-radius: var(--radius-sm); }
.tag-add-btn { flex: 0 0 auto; min-height: 0; padding: 0 28rpx; font-size: var(--font-md); }

.subtask-list { padding: 8rpx 0; }
.subtask-item { display: flex; align-items: center; margin-bottom: 12rpx; }
.subtask-input { flex: 1; font-size: var(--font-base); color: var(--text); margin: 0 14rpx; padding: 10rpx 0; border-bottom: 1rpx solid var(--border); }
.subtask-done { text-decoration: line-through; color: var(--text-3); }
.subtask-del { font-size: var(--font-xl); color: var(--text-3); padding: 0 8rpx; }
.subtask-add-row { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 0 16rpx; }
.subtask-add-input { flex: 1; font-size: var(--font-base); padding: 12rpx 20rpx; background: var(--surface-2); border-radius: var(--radius-sm); }
.subtask-add-btn { width: 60rpx; height: 60rpx; background: var(--primary); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.note-input { padding: 12rpx 0; min-height: 120rpx; }

.focus-entry { margin: 8rpx 24rpx 20rpx; padding: 24rpx; text-align: center; border-radius: var(--radius-md); background: var(--primary-light); color: var(--primary-dark); font-size: var(--font-base); }

.list-picker-body { padding: 8rpx 32rpx 32rpx; max-height: 70vh; overflow-y: auto; }
.list-option { border-radius: var(--radius-md); margin-bottom: 8rpx; }
.list-option.active { background: var(--primary-light); }
.list-option-icon { background: var(--surface-2); }
.list-option-name { font-size: var(--font-lg); color: var(--text); }
