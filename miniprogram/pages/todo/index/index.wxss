/* 待办列表独有：进度条 / 清单筛选 / 任务状态（segment、列表骨架走 m2-* 全局类） */
.hero-progress { position: relative; z-index: 1; height: 14rpx; border-radius: var(--radius-full); background: var(--surface-3); overflow: hidden; margin-top: 24rpx; opacity: .6; }
.hero-progress-fill { height: 100%; border-radius: var(--radius-full); background: var(--text-inverse); transition: width .4s var(--ease); }

.todo-list-tabs, .todo-tag-bar { white-space: nowrap; margin: 0 24rpx 20rpx; padding-bottom: 4rpx; }
.todo-list-tab, .todo-tag-chip { display: inline-flex; align-items: center; gap: 6rpx; margin-right: 12rpx; }
.todo-list-manage { margin-right: 0; }
.todo-tag-chip { font-size: var(--font-sm); }

.todo-list { padding: 0 28rpx; }
.todo-card { align-items: flex-start; border-left: 8rpx solid transparent; }
.todo-card.due-overdue { border-left-color: var(--danger); background: linear-gradient(90deg, var(--danger-light), var(--surface) 30%); }
.todo-card.due-today { border-left-color: var(--warning); }
.todo-card.due-soon { border-left-color: var(--warning); }
.todo-card.done .todo-title { color: var(--success); }
.todo-card.done { background: var(--surface-2); }

.todo-check { width: 48rpx; height: 48rpx; border-radius: 50%; border: 3rpx solid var(--primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2rpx; box-sizing: border-box; }
.todo-check-done { background: var(--success); border-color: var(--success); }
.todo-body { min-width: 0; }
.todo-title-row { display: flex; align-items: center; gap: 12rpx; }
.todo-title { font-weight: 500; }
.todo-soon-badge { flex-shrink: 0; font-size: var(--font-xs); color: var(--text-inverse); background: var(--warning-dark); padding: 2rpx 12rpx; border-radius: var(--radius-full); }
.todo-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; margin-top: 10rpx; }
.todo-tag { font-size: var(--font-sm); padding: 4rpx 14rpx; border-radius: var(--radius-full); }
.todo-listname { font-size: var(--font-sm); color: var(--text-3); }
.todo-due { font-size: var(--font-sm); color: var(--text-2); }
.todo-overdue { color: var(--danger); font-weight: 600; }
.todo-repeat { font-size: var(--font-sm); color: var(--primary-dark); background: var(--primary-light); padding: 4rpx 12rpx; border-radius: var(--radius-xs); }

.todo-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.todo-tagitem { font-size: var(--font-sm); color: var(--primary-dark); background: var(--primary-light); padding: 4rpx 12rpx; border-radius: var(--radius-xs); }
.todo-subtasks-preview { margin-top: 14rpx; }
.sub-row { display: flex; align-items: center; margin-bottom: 6rpx; }
.sub-text { font-size: var(--font-md); color: var(--text); margin-left: 10rpx; flex: 1; }
.sub-done { text-decoration: line-through; color: var(--text-3); }
.todo-sub-progress { height: 6rpx; background: var(--surface-3); border-radius: var(--radius-full); margin-top: 10rpx; overflow: hidden; }
.todo-sub-progress-fill { height: 100%; background: var(--primary); border-radius: var(--radius-full); transition: width .3s var(--ease); }
.todo-thumb { width: 120rpx; height: 120rpx; border-radius: var(--radius-sm); flex-shrink: 0; margin-left: 16rpx; }

.lm-list { max-height: 60vh; }
.lm-row { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 4rpx; border-bottom: 1rpx solid var(--border); }
.lm-row:last-child { border-bottom: none; }
.lm-name { flex: 1; min-width: 0; font-size: var(--font-base); color: var(--text); }
.lm-builtin, .lm-count { font-size: var(--font-sm); color: var(--text-3); background: var(--surface-2); padding: 4rpx 12rpx; border-radius: var(--radius-xs); }
.lm-act { display: flex; align-items: center; justify-content: center; padding: 8rpx; color: var(--text-2); }
.lm-act.lm-danger { color: var(--danger); }
.lm-add { display: flex; align-items: center; gap: 16rpx; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--border); }
.lm-input { flex: 1; min-width: 0; height: 72rpx; padding: 0 24rpx; background: var(--surface-2); border-radius: var(--radius-md); font-size: var(--font-base); color: var(--text); }
.lm-add-btn { padding: 16rpx 32rpx; background: var(--primary); color: var(--text-inverse); border-radius: var(--radius-md); font-size: var(--font-base); font-weight: 600; }
