<view class="m2-page" style="{{themeStyle}}">
  <view wx:if="{{item}}">
    <view class="m2-detail-hero">
      <view class="m2-detail-icon" style="background:{{priorityBg}};color:{{priorityColor}}">
        <m-icon wx:if="{{item.completed}}" name="check" size="56" color="#FFFFFF" />
        <m-icon wx:else name="list" size="56" color="#FFFFFF" />
      </view>
      <view class="m2-detail-main">
        <view class="m2-detail-title {{item.completed ? 'is-done' : ''}}">{{item.title}}</view>
        <view class="badge-row">
          <view wx:if="{{item.completed}}" class="m2-badge m2-badge-success"><m-icon name="check" size="26" inline />已完成</view>
          <view wx:elif="{{overdue}}" class="m2-badge m2-badge-danger">已逾期</view>
          <view class="m2-badge" style="color:{{priorityColor}};background:{{priorityBg}}">{{priorityLabel}}优先级</view>
        </view>
      </view>
    </view>

    <view class="m2-card">
      <view class="m2-detail-row">
        <view class="m2-detail-label">所属清单</view>
        <view class="m2-detail-value">{{listName || '收集箱'}}</view>
      </view>
      <view class="m2-detail-row">
        <view class="m2-detail-label">截止时间</view>
        <view class="m2-detail-value {{overdue ? 'text-danger' : ''}}">{{dueLabel || '未设置'}}</view>
      </view>
      <view class="m2-detail-row">
        <view class="m2-detail-label">提醒</view>
        <view class="m2-detail-value">{{item.remind ? '已开启' : '未开启'}}</view>
      </view>
      <view wx:if="{{repeatLabel}}" class="m2-detail-row">
        <view class="m2-detail-label">重复</view>
        <view class="m2-detail-value">{{repeatLabel}}</view>
      </view>
      <view wx:if="{{item.cycleCount}}" class="m2-detail-row">
        <view class="m2-detail-label">已完成周期</view>
        <view class="m2-detail-value">{{item.cycleCount}} 次</view>
      </view>
      <view wx:if="{{item.tags && item.tags.length > 0}}" class="m2-detail-row">
        <view class="m2-detail-label">标签</view>
        <view class="m2-detail-value detail-tags">
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="m2-chip active">{{tag}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{item.subtasks && item.subtasks.length > 0}}" class="m2-card">
      <view class="m2-card-head"><view class="m2-card-title">子任务 {{subtaskDone}}/{{subtaskTotal}}</view></view>
      <view class="detail-progress">
        <view class="detail-progress-fill" style="width:{{subtaskPercent}}%;background:var(--primary)"></view>
      </view>
      <view class="detail-subtasks">
        <view wx:for="{{item.subtasks}}" wx:for-item="sub" wx:key="title" class="m2-row detail-subtask {{sub.done ? 'done' : ''}}" data-index="{{index}}" bindtap="toggleSubtask">
          <view class="todo-check {{sub.done ? 'todo-check-done done' : ''}}"><m-icon wx:if="{{sub.done}}" name="check" size="28" color="#FFFFFF" /></view>
          <view class="m2-row-body m2-row-title">{{sub.title}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{item.note}}" class="m2-card">
      <view class="m2-card-head"><view class="m2-card-title">备注</view></view>
      <view class="m2-note">{{item.note}}</view>
    </view>

    <view wx:if="{{item.images && item.images.length > 0}}" class="m2-card">
      <view class="m2-card-head"><view class="m2-card-title">图片</view></view>
      <view class="detail-images">
        <image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" class="detail-image" src="{{img}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage" />
      </view>
    </view>

    <view class="m2-card">
      <view class="m2-detail-row">
        <view class="m2-detail-label">创建时间</view>
        <view class="m2-detail-value">{{createdAtLabel || '—'}}</view>
      </view>
      <view wx:if="{{updatedAtLabel}}" class="m2-detail-row">
        <view class="m2-detail-label">最近编辑</view>
        <view class="m2-detail-value">{{updatedAtLabel}}</view>
      </view>
    </view>

    <view class="m2-footer">
      <view class="m2-btn m2-btn-ghost" bindtap="quickAction"><m-icon name="check" size="32" inline /> {{quickLabel}}</view>
      <view class="m2-btn m2-btn-primary" bindtap="goEdit"><m-icon name="edit" size="28" inline /> 编辑</view>
      <view class="m2-btn m2-btn-danger" bindtap="deleteItem"><m-icon name="trash" size="28" inline /> 删除</view>
    </view>
  </view>
</view>
