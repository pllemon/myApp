/* 统计页独有：骨架屏尺寸 / 柱状图 / 打卡栅格 / 完成率环形 / 洞察条目（骨架走全局 m-skeleton） */
.skeleton-hero { height: 300rpx; border-radius: 36rpx; margin-bottom: 20rpx; }
.skeleton-grid { height: 240rpx; border-radius: 28rpx; margin-bottom: 20rpx; }
.skeleton-card { height: 300rpx; border-radius: 28rpx; margin-bottom: 20rpx; }

.overview-grid { margin: 0 0 20rpx; }
.overview-cell { text-align: center; }
.stat-unit { font-size: 22rpx; color: var(--text-3); font-weight: 400; margin-left: 4rpx; }

.chart { display: flex; align-items: flex-end; justify-content: space-between; height: 300rpx; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; margin: 0 6rpx; }
.bar-value { font-size: 20rpx; color: var(--text-3); margin-bottom: 8rpx; min-height: 28rpx; }
.bar-track { width: 100%; height: 220rpx; display: flex; align-items: flex-end; justify-content: center; }
.bar-fill { width: 70%; background: linear-gradient(180deg, var(--primary), var(--primary-dark)); border-radius: 8rpx 8rpx 0 0; min-height: 6rpx; transition: height .4s var(--ease); }
.bar-label { font-size: 20rpx; color: var(--text-3); margin-top: 10rpx; }

.checkin-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12rpx; }
.checkin-cell { display: flex; flex-direction: column; align-items: center; padding: 8rpx 0; }
.checkin-cell .m2-stat-num.accent { color: var(--accent); }
.checkin-cell .m2-stat-label { text-align: center; }

.todo-summary { display: flex; align-items: center; }
.todo-ring { width: 180rpx; height: 180rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.todo-ring-inner { width: 130rpx; height: 130rpx; border-radius: 50%; background: var(--surface); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.todo-rate { font-size: 34rpx; font-weight: 600; color: var(--primary); }
.todo-rate-sub { font-size: 20rpx; color: var(--text-3); }
.todo-recent { flex: 1; margin-left: 28rpx; min-width: 0; }
.recent-item { display: flex; align-items: center; padding: 10rpx 0; border-bottom: 1rpx solid var(--border); }
.recent-item:last-child { border-bottom: none; }
.recent-dot { display: flex; align-items: center; justify-content: center; width: 36rpx; color: var(--text-3); }
.recent-done .recent-dot { color: var(--success); }
.recent-done .recent-text { text-decoration: line-through; color: var(--text-3); }
.recent-text { font-size: 26rpx; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.insight-item { display: flex; align-items: flex-start; gap: 16rpx; padding: 20rpx 0; border-bottom: 2rpx solid var(--border); }
.insight-item:last-of-type { border-bottom: none; }
.insight-icon { width: 56rpx; height: 56rpx; border-radius: 16rpx; background: var(--surface-2); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.insight-item.positive .insight-icon { background: var(--success-light); }
.insight-item.warning .insight-icon { background: var(--warning-light); }
.insight-body { flex: 1; min-width: 0; }
.insight-title { font-size: 28rpx; font-weight: 600; color: var(--text); }
.insight-detail { font-size: 24rpx; color: var(--text-2); margin-top: 6rpx; line-height: 1.6; }
.insight-sample { font-size: 20rpx; color: var(--text-3); margin-top: 6rpx; }
.insight-disclaimer { font-size: 20rpx; color: var(--text-3); text-align: center; margin-top: 16rpx; padding-top: 16rpx; border-top: 2rpx dashed var(--border); }
