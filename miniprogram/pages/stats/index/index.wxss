.page-title { font-size: 32rpx; font-weight: 600; color: var(--text); margin: 8rpx 0 24rpx; }

.overview-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-bottom: 8rpx; }
.overview-card { background: var(--bg-card); border-radius: 16rpx; padding: 28rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.ov-label { font-size: 24rpx; color: var(--text-secondary); margin-bottom: 12rpx; }
.ov-value { font-size: 38rpx; font-weight: 600; color: var(--text); }
.ov-value.expense { color: var(--danger); }
.ov-value.income { color: var(--success); }
.ov-unit { font-size: 24rpx; color: var(--text-secondary); font-weight: 400; margin-left: 6rpx; }

.card { background: var(--bg-card); border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.card-title { font-size: 30rpx; font-weight: 600; color: var(--text); margin-bottom: 24rpx; }

.chart { display: flex; align-items: flex-end; justify-content: space-between; height: 300rpx; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; margin: 0 6rpx; }
.bar-value { font-size: 20rpx; color: var(--text-secondary); margin-bottom: 8rpx; min-height: 28rpx; }
.bar-track { width: 100%; height: 220rpx; display: flex; align-items: flex-end; justify-content: center; }
.bar-fill { width: 70%; background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%); border-radius: 8rpx 8rpx 0 0; min-height: 6rpx; transition: height 0.4s; }
.bar-label { font-size: 20rpx; color: var(--text-secondary); margin-top: 10rpx; }

.stat-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12rpx; }
.stat-cell { display: flex; flex-direction: column; align-items: center; padding: 16rpx 0; }
.stat-num { font-size: 40rpx; font-weight: 600; color: var(--text); }
.stat-num.accent { color: var(--accent); }
.stat-cap { font-size: 22rpx; color: var(--text-secondary); margin-top: 8rpx; }

.todo-summary { display: flex; align-items: center; }
.todo-ring { width: 180rpx; height: 180rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.todo-ring-inner { width: 130rpx; height: 130rpx; border-radius: 50%; background: var(--bg-card); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.todo-rate { font-size: 34rpx; font-weight: 600; color: var(--primary); }
.todo-rate-sub { font-size: 20rpx; color: var(--text-secondary); }
.todo-recent { flex: 1; margin-left: 28rpx; min-width: 0; }
.recent-empty { font-size: 26rpx; color: var(--text-secondary); text-align: center; }
.recent-item { display: flex; align-items: center; padding: 10rpx 0; border-bottom: 1rpx solid var(--divider); }
.recent-item:last-child { border-bottom: none; }
.recent-dot { width: 36rpx; color: var(--text-secondary); font-size: 26rpx; }
.recent-done .recent-dot { color: var(--success); }
.recent-done .recent-text { text-decoration: line-through; color: var(--text-secondary); }
.recent-text { font-size: 26rpx; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }