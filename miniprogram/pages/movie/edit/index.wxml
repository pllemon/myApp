<view class="m2-page m2-edit" style="{{themeStyle}}">
  <!-- 编辑 Hero -->
  <view class="m2-edit-hero">
    <view class="m2-edit-hero-icon" style="background: var(--primary-light)"><m-icon name="play" size="48" /></view>
    <view>
      <view class="m2-edit-title">{{isEdit ? '编辑影片' : '添加影片'}}</view>
      <view class="m2-edit-desc">记录影片信息与你的观影感受</view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">封面 / 剧照</view>
    <m-image-picker images="{{images}}" bind:change="onImagesChange" />
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">影片信息</view>
    <view class="m2-field">
      <view class="m2-field-label">影片名称</view>
      <input class="m2-field-value" placeholder="例如：肖申克的救赎" value="{{title}}" maxlength="50" bindinput="onTitleInput" focus="{{!isEdit}}" />
    </view>
    <view class="m2-field">
      <view class="m2-field-label">类型</view>
      <view class="m2-chip-row">
        <view
          wx:for="{{categoryOptions}}"
          wx:key="key"
          class="m2-chip {{category === item.key ? 'active' : ''}}"
          style="{{category === item.key ? 'color:' + item.color + ';border-color:' + item.color + ';background:' + item.soft : ''}}"
          data-key="{{item.key}}"
          bindtap="selectCategory"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="m2-field">
      <view class="m2-field-label">观看状态</view>
      <view class="m2-chip-row">
        <view
          wx:for="{{statusOptions}}"
          wx:key="key"
          class="m2-chip {{status === item.key ? 'active' : ''}}"
          style="{{status === item.key ? 'color:' + item.color + ';border-color:' + item.color + ';background:' + item.soft : ''}}"
          data-key="{{item.key}}"
          bindtap="selectStatus"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="m2-field">
      <view class="m2-field-label">导演</view>
      <input class="m2-field-value" placeholder="可选" value="{{director}}" maxlength="30" bindinput="onDirectorInput" />
    </view>
    <view class="m2-field">
      <view class="m2-field-label">主演</view>
      <input class="m2-field-value" placeholder="可选，多个用逗号分隔" value="{{actors}}" maxlength="80" bindinput="onActorsInput" />
    </view>
    <view class="field-row">
      <view class="m2-field">
        <view class="m2-field-label">上映年份</view>
        <input class="m2-field-value" type="number" placeholder="例如：1994" value="{{releaseYear}}" maxlength="4" bindinput="onYearInput" />
      </view>
      <view class="m2-field">
        <view class="m2-field-label">时长（分钟）</view>
        <input class="m2-field-value" type="number" placeholder="可选" value="{{duration}}" maxlength="4" bindinput="onDurationInput" />
      </view>
    </view>
  </view>

  <view class="m2-form-card" wx:if="{{status === 'watched' || status === 'watching'}}">
    <view class="m2-form-title">观看记录</view>
    <view class="m2-field">
      <view class="m2-field-label">观看日期</view>
      <picker mode="date" value="{{watchedDate}}" bindchange="onDateChange">
        <view class="m2-field-value {{watchedDate ? '' : 'placeholder'}}">{{watchedDate || '选填'}}</view>
      </picker>
      <view wx:if="{{watchedDate}}" class="date-clear" catchtap="clearDate"><m-icon name="close" size="24" inline /> 清除</view>
    </view>
  </view>

  <view class="m2-form-card" wx:if="{{status === 'watched'}}">
    <view class="m2-form-title">评分 · {{rating > 0 ? rating + ' / 5' : '未评分'}}</view>
    <view class="m2-field">
      <view class="m2-field-label">我的评分</view>
      <view class="rating-row">
        <view
          wx:for="{{stars}}"
          wx:key="*this"
          class="star-wrap {{item <= rating ? 'star-on' : ''}}"
          data-r="{{item}}"
          bindtap="selectRating"
        ><m-icon name="star" size="44" tone="system" /></view>
        <text wx:if="{{rating > 0}}" class="rating-num">{{rating}} / 5</text>
      </view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">短评</view>
    <textarea class="m2-field-value" placeholder="记录你的感想（可选）" value="{{note}}" maxlength="300" bindinput="onNoteInput" auto-height />
  </view>

  <view class="m2-footer">
    <view class="m2-btn m2-btn-primary" bindtap="save">保存</view>
    <view wx:if="{{isEdit}}" class="m2-btn m2-btn-danger" bindtap="remove">删除</view>
  </view>
</view>
