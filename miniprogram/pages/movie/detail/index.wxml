<view class="m2-page" wx:if="{{item}}" style="{{themeStyle}}">
  <!-- 详情 Hero -->
  <view class="m2-detail-hero">
    <image wx:if="{{item.images && item.images.length > 0}}" class="m2-detail-hero-img" src="{{item.images[0]}}" mode="aspectFill" data-index="0" bindtap="previewImage" />
    <view wx:else class="m2-detail-icon" style="background:{{item.categoryTile}}"><m-icon value="{{item.categoryIcon}}" size="56" color="{{item.categoryColor}}" /></view>
    <view class="m2-detail-main">
      <view class="m2-detail-title">{{item.title}}</view>
      <view wx:if="{{item.releaseYear || item.director}}" class="m2-detail-sub">{{item.releaseYear}} {{item.director}}</view>
      <view class="m2-badge-row">
        <view class="m2-badge" style="color:{{item.statusColor}};background:{{item.statusSoft}}">{{item.statusLabel}}</view>
        <view class="m2-badge" style="color:{{item.categoryColor}};background:{{item.categorySoft}}">{{item.categoryLabel}}</view>
      </view>
    </view>
  </view>

  <!-- 影片信息 -->
  <view class="m2-card">
    <view class="m2-card-head"><view class="m2-card-title">影片信息</view></view>
    <view class="m2-detail-row">
      <view class="m2-detail-label">导演</view>
      <view class="m2-detail-value">{{item.director || '未填写'}}</view>
    </view>
    <view class="m2-detail-row">
      <view class="m2-detail-label">主演</view>
      <view class="m2-detail-value">{{item.actors || '未填写'}}</view>
    </view>
    <view class="m2-detail-row">
      <view class="m2-detail-label">年份</view>
      <view class="m2-detail-value">{{item.releaseYear || '未填写'}}</view>
    </view>
    <view class="m2-detail-row">
      <view class="m2-detail-label">时长</view>
      <view class="m2-detail-value">{{item.durationText || '未填写'}}</view>
    </view>
    <view wx:if="{{item.watchedDate}}" class="m2-detail-row">
      <view class="m2-detail-label">观看日期</view>
      <view class="m2-detail-value">{{item.watchedDate}}</view>
    </view>
    <view wx:if="{{item.status === 'watched'}}" class="m2-detail-row">
      <view class="m2-detail-label">评分</view>
      <view class="m2-detail-value detail-stars">
        <view
          wx:for="{{[1,2,3,4,5]}}"
          wx:for-item="idx"
          wx:key="*this"
          class="star-wrap {{idx <= item.rating ? 'star-on' : ''}}"
          data-rating="{{idx}}"
          bindtap="rateMovie"
        >
          <m-icon name="star" size="32" tone="system" />
        </view>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view wx:if="{{item.note}}" class="m2-card">
    <view class="m2-card-head"><view class="m2-card-title">备注</view></view>
    <view class="m2-note">{{item.note}}</view>
  </view>

  <!-- 剧照 -->
  <view wx:if="{{item.images && item.images.length > 0}}" class="m2-card">
    <view class="m2-card-head"><view class="m2-card-title">剧照</view></view>
    <view class="m2-detail-images">
      <image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" class="m2-detail-image" src="{{img}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage" />
    </view>
  </view>

  <!-- 时间信息 -->
  <view class="m2-card">
    <view class="m2-detail-row">
      <view class="m2-detail-label">创建时间</view>
      <view class="m2-detail-value">{{createdAtLabel || '—'}}</view>
    </view>
    <view wx:if="{{updatedAtLabel}}" class="m2-detail-row">
      <view class="m2-detail-label">最近编辑</view>
      <view class="m2-detail-value">{{updatedAtLabel}}</view>
    </view>
  </view>

  <view class="m2-footer">
    <view class="m2-btn m2-btn-ghost" bindtap="quickAction">标为{{nextStatusLabel}}</view>
    <view class="m2-btn m2-btn-primary" bindtap="goEdit"><m-icon name="edit" size="28" inline /> 编辑</view>
    <view class="m2-btn m2-btn-danger" bindtap="deleteItem"><m-icon name="trash" size="28" inline /> 删除</view>
  </view>
</view>
