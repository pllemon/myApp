<view class="m2-page with-tabbar" style="{{themeStyle}}">
  <!-- 观影概览 Hero -->
  <view class="m2-hero">
    <view class="m2-hero-head">
      <view>
        <view class="m2-hero-title">观影清单</view>
        <view class="m2-hero-sub">记录每一部打动你的作品</view>
      </view>
    </view>
    <view class="m2-hero-stats">
      <view class="m2-hero-stat" wx:for="{{summaryItems}}" wx:key="label">
        <view class="m2-hero-stat-value">{{item.value}}<text wx:if="{{item.total}}" class="m2-hero-unit">/{{item.total}}</text></view>
        <view class="m2-hero-stat-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 分段筛选 -->
  <view class="m2-segment">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="m2-seg-item {{activeFilter === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchFilter"
    >{{item.label}}</view>
  </view>

  <!-- 空态 -->
  <m-empty
    wx:if="{{showEmpty}}"
    title="暂无影片"
    desc="点击右下角 + 添加你想看的电影或剧"
    action="去添加"
    bindaction="goNew"
  />

  <!-- 影片列表（封面图） -->
  <view wx:else class="m2-list">
    <view
      wx:for="{{list}}"
      wx:key="_id"
      class="m2-row movie-card"
      data-id="{{item._id}}"
      bindtap="goDetail"
    >
      <view class="movie-poster" style="{{item.images && item.images.length > 0 ? '' : 'background:' + item.categoryTile + ';color:' + item.categoryColor}}">
        <image wx:if="{{item.images && item.images.length > 0}}" class="poster-img" src="{{item.images[0]}}" mode="aspectFill" />
        <block wx:else>
          <view class="poster-emoji"><m-icon value="{{item.categoryIcon}}" size="56" color="{{item.categoryColor}}" /></view>
          <text class="poster-year" wx:if="{{item.releaseYear}}">{{item.releaseYear}}</text>
        </block>
      </view>
      <view class="m2-row-body">
        <view class="m2-row-title movie-title">{{item.title}}</view>
        <view class="movie-meta">
          <text wx:if="{{item.director}}" class="movie-director">导演 · {{item.director}}</text>
          <text wx:if="{{item.director && item.actors}}" class="movie-sep">·</text>
          <text wx:if="{{item.actors}}" class="movie-actors">{{item.actors}}</text>
        </view>
        <view class="movie-tags">
          <view class="movie-tag" style="color:{{item.categoryColor}};background:{{item.categorySoft}}">{{item.categoryLabel}}</view>
          <view class="movie-tag movie-status" style="color:{{item.statusColor}};background:{{item.statusSoft}}"
            data-id="{{item._id}}" catchtap="toggleStatus"><m-icon name="{{item.status === 'watched' ? 'checkCircle' : (item.status === 'watching' ? 'playCircle' : 'bookmark')}}" tone="system" size="24" inline /> {{item.statusLabel}}</view>
          <text wx:if="{{item.duration}}" class="movie-duration">{{item.duration}}</text>
        </view>
        <view wx:if="{{item.status === 'watched'}}" class="movie-rating">
          <view class="stars">
            <view wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:key="*this" class="star-wrap {{s <= item.rating ? 'star-on' : ''}}">
              <m-icon name="star" size="32" tone="system" />
            </view>
          </view>
          <text wx:if="{{item.watchedDate}}" class="movie-date">看于 {{item.watchedDate}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="m2-fab" bindtap="goNew"><m-icon name="add" size="44" inline /></view>
</view>
<m-tab-bar id="tabbar" />
