/* 观影列表独有：封面海报 / 元信息标签 / 星级（segment、列表、空态、FAB 走 m2-* 全局类） */
.movie-card { align-items: flex-start; }
.movie-poster { width: 140rpx; height: 200rpx; border-radius: 12rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 24rpx; overflow: hidden; background: var(--surface-3); }
.poster-img { width: 100%; height: 100%; }
.poster-emoji { display: flex; align-items: center; justify-content: center; }
.poster-year { font-size: 22rpx; opacity: .7; margin-top: 8rpx; }
.movie-title { font-size: 30rpx; font-weight: 600; word-break: break-all; }
.movie-meta { font-size: 24rpx; color: var(--text-3); margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.movie-sep { margin: 0 8rpx; }
.movie-tags { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; margin-top: 10rpx; }
.movie-tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: var(--radius-full); }
.movie-duration { font-size: 22rpx; color: var(--text-3); }
.movie-rating { display: flex; align-items: center; justify-content: space-between; margin-top: 10rpx; }
.stars { display: flex; gap: 4rpx; }
.star-wrap { opacity: .3; }
.star-wrap.star-on { opacity: 1; }
.movie-date { font-size: 22rpx; color: var(--text-3); }
