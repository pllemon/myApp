/* 今日驾驶舱 · 首页专用样式。全部走主题 token，不写死颜色。 */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding-top: 24rpx;
}

/* ---------- ① 驾驶舱 ---------- */
.cockpit {
  position: relative;
  overflow: hidden;
  margin: 0 24rpx 20rpx;
  padding: 32rpx 32rpx 28rpx;
  border-radius: 36rpx;
  background: linear-gradient(140deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: #FFFFFF;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.12);
}

.glow {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.13);
  pointer-events: none;
}
.glow-1 { width: 280rpx; height: 280rpx; top: -150rpx; right: -70rpx; }
.glow-2 { width: 180rpx; height: 180rpx; bottom: -110rpx; left: -50rpx; background: rgba(255, 255, 255, 0.08); }

.cockpit-head {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  z-index: 1;
}
.hello { font-size: 40rpx; font-weight: 700; line-height: 1.2; letter-spacing: 1rpx; }
.date-line { font-size: 24rpx; opacity: 0.78; margin-top: 8rpx; }
.mode-pill {
  font-size: 20rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

.cockpit-main { position: relative; z-index: 1; margin-top: 34rpx; }
.main-label { font-size: 24rpx; opacity: 0.8; }
.main-value { font-size: 76rpx; font-weight: 700; line-height: 1.15; margin-top: 4rpx; letter-spacing: -2rpx; }
.currency { font-size: 36rpx; font-weight: 500; margin-right: 6rpx; opacity: 0.9; }
.main-income { font-size: 24rpx; opacity: 0.85; margin-top: 6rpx; }

.budget-strip { position: relative; z-index: 1; margin-top: 26rpx; }
.budget-line {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  opacity: 0.9;
  margin-bottom: 12rpx;
}
.budget-track {
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  overflow: hidden;
}
.budget-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #FFFFFF;
  transition: width 0.4s ease;
}

.cockpit-stats {
  position: relative;
  z-index: 1;
  display: flex;
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
}
.cstat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.cs-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.12);
}
.cs-value { font-size: 28rpx; font-weight: 600; margin-top: 10rpx; }
.cs-label { font-size: 20rpx; opacity: 0.78; margin-top: 2rpx; }

/* ---------- ② 速记条 ---------- */
.quick-bar {
  display: flex;
  margin: 0 24rpx 20rpx;
  padding: 20rpx 8rpx;
  background: var(--surface);
  border-radius: 28rpx;
  box-shadow: var(--shadow-sm);
}
.quick-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.quick-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
}
.quick-label { font-size: 22rpx; color: var(--text-2); margin-top: 10rpx; }

/* ---------- 通用卡片 ---------- */
.card {
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
  background: var(--surface);
  border-radius: 28rpx;
  box-shadow: var(--shadow-sm);
}
.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 22rpx;
}
.card-title { font-size: 30rpx; font-weight: 700; color: var(--text); }
.card-sub { font-size: 22rpx; color: var(--text-3); }

/* ---------- ③ 今日进度 ---------- */
.metric { display: flex; align-items: flex-start; padding: 18rpx 0; }
.metric + .metric { border-top: 1rpx solid var(--border); }
.metric-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.metric-body { flex: 1; min-width: 0; }
.metric-top { display: flex; justify-content: space-between; align-items: center; }
.metric-name { font-size: 27rpx; font-weight: 600; color: var(--text); }
.metric-num { font-size: 24rpx; color: var(--text-3); font-weight: 600; }
.metric-track {
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--surface-3);
  overflow: hidden;
  margin: 12rpx 0 16rpx;
}
.metric-fill { height: 100%; border-radius: 999rpx; transition: width 0.4s ease; }

.habit-row { display: flex; flex-wrap: wrap; gap: 10rpx; }
.habit-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  font-size: 22rpx;
  color: var(--text-2);
}
.habit-chip.done { background: var(--success-light); color: var(--text); }
.hc-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }

.empty-habit {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  font-size: 22rpx;
  color: var(--primary);
}

.todo-row { display: flex; align-items: center; padding: 10rpx 0; gap: 14rpx; }
.todo-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.todo-title { flex: 1; font-size: 25rpx; color: var(--text); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.todo-title.done { color: var(--text-3); text-decoration: line-through; }
.todo-title.overdue { color: var(--danger); }
.todo-tag {
  font-size: 20rpx;
  color: var(--danger);
  background: var(--danger-light);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

/* ---------- ④ 本月小报 ---------- */
.digest-grid {
  display: flex;
  flex-wrap: wrap;
}
.digest-cell {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 20rpx;
  box-sizing: border-box;
}
.dig-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}
.dig-value { font-size: 30rpx; font-weight: 700; color: var(--text); line-height: 1.2; }
.dig-label { font-size: 20rpx; color: var(--text-3); margin-top: 4rpx; }

/* ---------- ⑤ 今日时间线 ---------- */
.tl { display: flex; flex-direction: column; }
.tl-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  gap: 14rpx;
}
.tl-time { width: 68rpx; font-size: 21rpx; color: var(--text-3); flex-shrink: 0; }
.tl-rail { position: relative; width: 18rpx; align-self: stretch; flex-shrink: 0; }
.tl-rail::before {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: var(--border);
}
.tl-item:first-child .tl-rail::before { top: 44rpx; }
.tl-item:last-child .tl-rail::before { bottom: 44rpx; }
.tl-dot {
  position: absolute;
  left: 2rpx;
  top: 50%;
  margin-top: -7rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 3rpx solid var(--surface);
  box-shadow: 0 0 0 2rpx var(--border);
}
.tl-icon { width: 40rpx; display: flex; justify-content: center; flex-shrink: 0; }
.tl-body { flex: 1; min-width: 0; }
.tl-title { font-size: 26rpx; color: var(--text); font-weight: 500; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.tl-sub { font-size: 21rpx; color: var(--text-3); margin-top: 4rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.tl-amount { font-size: 25rpx; font-weight: 600; flex-shrink: 0; }
.tl-arrow { display: flex; color: var(--text-3); flex-shrink: 0; }
.empty-line { text-align: center; padding: 30rpx 0; font-size: 23rpx; color: var(--text-3); }

/* ---------- ⑥ 近期日子 ---------- */
.anni-scroll { width: 100%; white-space: nowrap; }
.anni-track { display: flex; gap: 16rpx; }
.anni-chip {
  display: inline-flex;
  flex-direction: column;
  min-width: 168rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: var(--warning-light);
  box-sizing: border-box;
}
.anni-chip.today { background: linear-gradient(135deg, var(--accent), var(--primary)); }
.anni-chip.today .anni-name,
.anni-chip.today .anni-days { color: #FFFFFF; }
.anni-name { font-size: 25rpx; font-weight: 600; color: var(--text); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.anni-days { font-size: 21rpx; color: var(--primary-dark); margin-top: 8rpx; }

/* ---------- ⑦ 更多入口 ---------- */
.more-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.more-item {
  width: calc((100% - 24rpx) / 3);
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 12rpx;
  border-radius: 18rpx;
  background: var(--surface-2);
  box-sizing: border-box;
}
.more-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.more-label {
  font-size: 22rpx;
  color: var(--text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bottom-space { height: 180rpx; }
