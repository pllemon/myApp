<view class="container m-edit-page">
  <view class="m-form-card">
    <view class="m-form-title">🩺 血压记录</view>

    <m-field label="日期">
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="m-form-picker-value">{{date}}</view>
      </picker>
    </m-field>

    <m-field label="时间">
      <picker mode="time" value="{{time}}" bindchange="onTimeChange">
        <view class="m-form-picker-value">{{time}}</view>
      </picker>
    </m-field>

    <view class="m-form-row">
      <m-field label="收缩压 (mmHg)" half>
        <input class="m-form-input" type="number" value="{{systolic}}" placeholder="参考 90-140" bindinput="onSystolicInput" />
      </m-field>
      <m-field label="舒张压 (mmHg)" half>
        <input class="m-form-input" type="number" value="{{diastolic}}" placeholder="参考 60-90" bindinput="onDiastolicInput" />
      </m-field>
    </view>

    <m-field label="脉搏 (次/分)">
      <input class="m-form-input" type="number" value="{{pulse}}" placeholder="选填" bindinput="onPulseInput" />
    </m-field>

    <m-option-picker label="测量来源" options="{{sourceOptions}}" currentValue="{{source}}" bind:change="onSourceChange">
      {{source}}
    </m-option-picker>

    <m-field wx:if="{{preview}}" label="状态预览">
      <view class="m-form-picker-value">
        <m-status-badge text="{{preview.label}}" color="{{preview.color}}" />
      </view>
    </m-field>
  </view>

  <view class="m-form-card">
    <view class="m-form-title">📝 备注</view>
    <m-field block>
      <textarea class="m-form-textarea" placeholder="选填" value="{{notes}}" bindinput="onNotesInput" auto-height maxlength="200" />
    </m-field>
  </view>

  <m-save-bar save-text="{{isEdit ? '保存修改' : '保存记录'}}" bind:save="save" />
</view>