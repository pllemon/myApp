.profile-hero {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.hero-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.08);
}

.hero-avatar-emoji {
  font-size: 64rpx;
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.hero-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
}

.hero-gender {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  background-color: var(--primary-light);
  color: var(--primary);
  border-radius: 16rpx;
}

.hero-age {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.hero-basic {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.hero-basic-item {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  background-color: rgba(255, 255, 255, 0.6);
  color: var(--text);
  border-radius: 12rpx;
}

.hero-action {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
}

.tab-bar {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.tab-item.active {
  background: linear-gradient(135deg, var(--primary-light) 0%, #FFFFFF 100%);
}

.tab-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.tab-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.tab-item.active .tab-label {
  color: var(--primary);
  font-weight: 600;
}

.tab-content {
  min-height: 400rpx;
}

.info-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.info-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #F5F5F5;
  margin-bottom: 10rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #FAFAFA;
}

.info-row:last-child {
  border-bottom: none;
}

.info-key {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.info-val {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
  max-width: 60%;
  text-align: right;
}

.info-text {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.7;
  padding: 8rpx 0;
}

.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.stat-tile {
  flex: 1;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.2;
}

.stat-lbl {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.cycle-card {
  background: linear-gradient(135deg, #FFF0F5 0%, #FFE4EC 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.cycle-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.cycle-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.cycle-ring {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E91E63 0%, #FF80AB 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cycle-day {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.cycle-total {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.cycle-info {
  flex: 1;
}

.cycle-stage {
  display: inline-block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.cycle-stage.period { color: #E91E63; }
.cycle-stage.ovulation { color: #FF9800; }
.cycle-stage.fertile { color: #4CAF50; }
.cycle-stage.safe { color: #2196F3; }

.cycle-next {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 8rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.section-add {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
}

.section-empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.group-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 16rpx 8rpx 8rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.record-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

.record-del {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 28rpx;
  opacity: 0.4;
}

.med-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.med-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.med-dosage {
  font-size: 24rpx;
  color: var(--primary);
  background-color: var(--primary-light);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.med-frequency, .med-date {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}

.med-notes {
  font-size: 26rpx;
  color: var(--text);
  margin-top: 8rpx;
  line-height: 1.5;
}

.visit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.visit-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.visit-date {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.visit-meta {
  font-size: 26rpx;
  color: var(--text);
  margin-bottom: 6rpx;
}

.visit-diagnosis {
  font-size: 26rpx;
  color: var(--danger);
  margin: 6rpx 0;
}

.visit-notes {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  line-height: 1.5;
}

.period-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.period-card {
  background: linear-gradient(135deg, #FFF0F5 0%, #FFE4EC 100%);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

.period-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #E91E63;
  margin-bottom: 8rpx;
}

.period-duration {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}

.period-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.period-chip {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  background-color: #FFFFFF;
  color: var(--text);
  border-radius: 16rpx;
}

.period-notes {
  font-size: 26rpx;
  color: var(--text);
  margin-top: 8rpx;
}