/* 档案详情页 · 仅保留 m2-* 全局构件之外的独有样式 */

.detail-avatar { background: var(--primary-light); }
.hero-basic { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.hero-basic-item {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  background: var(--surface-2);
  color: var(--text-2);
  border-radius: 999rpx;
}
.hero-actions { display: flex; gap: 24rpx; margin-top: 16rpx; }
.hero-action { display: flex; align-items: center; gap: 6rpx; font-size: 24rpx; color: var(--primary); font-weight: 500; }

/* 概览统计 */
.stats-row { margin: 0 24rpx 20rpx; }
.stat-tile { text-align: center; padding: 18rpx 8rpx; }
.m2-stat-cell + .m2-stat-cell { border-left: 1rpx solid var(--border); }

/* 生理周期卡 */
.cycle-card { border-left: 6rpx solid var(--primary); }
.cycle-main { display: flex; align-items: center; gap: 24rpx; }
.cycle-ring {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(140deg, var(--primary), var(--primary-dark));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cycle-day { font-size: 28rpx; font-weight: 700; color: #FFFFFF; }
.cycle-total { font-size: 21rpx; color: var(--surface); margin-top: 4rpx; }
.cycle-info { flex: 1; display: flex; flex-direction: column; align-items: flex-start; }
.cycle-next { font-size: 23rpx; color: var(--text-3); margin-top: 8rpx; }

/* 分区标题 */
.section-header { display: flex; justify-content: space-between; align-items: center; padding: 8rpx 28rpx 16rpx; }

/* 列表行内标签 */
.med-dosage {
  font-size: 21rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
}
.visit-diagnosis { color: var(--danger); }

/* 行内删除按钮 */
.record-del {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  color: var(--text-3);
  flex-shrink: 0;
}

/* 生理期行 */
.period-row { align-items: flex-start; }
.period-date { color: var(--primary-dark); }
.period-meta { padding: 6rpx 0 0; gap: 10rpx; }
.period-chip { padding: 6rpx 16rpx; font-size: 20rpx; }

/* 报告预览 */
.report-preview {
  max-height: 50vh;
  overflow-y: auto;
  padding: 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-2);
  background: var(--surface-2);
  border-radius: var(--radius-md);
  white-space: pre-wrap;
  word-break: break-all;
}
.report-hint { margin-top: 16rpx; font-size: 20rpx; color: var(--text-3); line-height: 1.5; }
