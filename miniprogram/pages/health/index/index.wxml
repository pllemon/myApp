    </view>

<!-- ===== 尿酸 ===== -->
    <view class="tab-content" wx:if="{{activeTab === 'cholesterol'}}">
      <view class="chart-card" wx:if="{{cholesterols.length > 0}}">
        <view class="chart-header">
          <text class="chart-title">血脂趋势</text>
          <view class="chart-range">
            <text class="range-btn {{cholDays === 30 ? 'active' : ''}}" data-tab="cholesterol" data-d="30" bindtap="setChartDays">30</text>
            <text class="range-btn {{cholDays === 90 ? 'active' : ''}}" data-tab="cholesterol" data-d="90" bindtap="setChartDays">90</text>
            <text class="range-btn {{cholDays === 180 ? 'active' : ''}}" data-tab="cholesterol" data-d="180" bindtap="setChartDays">WB</text>
      </view>
        </view>
        <canvas id="cholChart" class="chart-canvas" type="2d"></canvas>
        <view class="chart-summary" wx:if="{{cholStats.count > 0}}">
          <text class="cs-item">g?{{cholStats.avg}}mmol/L</text>
          <text class="cs-item" wx:if="{{cholTgStats.count > 0}}">TG g?{{cholTgStats.avg}}</text>
          <text class="cs-item">O?{{cholStats.count}} </text>
      </view>
      </view>
      <m-empty compact title="暂无血脂记录" />
      <view class="rec-item" wx:for="{{cholGroups}}" wx:for-item="group" wx:key="month">
        <view class="month-header"><text>{{group.month}}</text>
      </view>
        <view wx:for="{{group.items}}" wx:key="_id" bindtap="editChol" data-id="{{item._id}}">
          <view class="rec-item">
            <view class="bp-row">
              <text class="bp-val">{{item.total || '--'}} mmol/L</text>
              <m-status-badge text="{{item._statusLabel}}" color="{{item._statusColor}}" />
      </view>
            <view class="bp-meta">
              <text wx:if="{{item.ldl}}">LDL {{item.ldl}}</text>
              <text wx:if="{{item.hdl}}">HDL {{item.hdl}}</text>
              <text wx:if="{{item.tg}}">TG {{item.tg}}</text>
              <text class="bp-date">{{item.date}}</text>
      </view>
          </view>
        </view>
      </view>
      <view class="m-fab" bindtap="addChol">+</view>
    </view>

<!-- ===== 血脂 ===== -->
    <view class="tab-content" wx:if="{{activeTab === 'diet'}}">
      <view class="chart-card" wx:if="{{dietDaily.length > 0}}">
        <view class="chart-header">
          <text class="chart-title">饮食趋势</text>
          <view class="chart-range">
            <text class="range-btn {{dietDays === 7 ? 'active' : ''}}" data-tab="diet" data-d="7" bindtap="setChartDays">7</text>
            <text class="range-btn {{dietDays === 30 ? 'active' : ''}}" data-tab="diet" data-d="30" bindtap="setChartDays">30</text>
            <text class="range-btn {{dietDays === 90 ? 'active' : ''}}" data-tab="diet" data-d="90" bindtap="setChartDays">90</text>
      </view>
        </view>
        <canvas id="dietChart" class="chart-canvas" type="2d"></canvas>
        <view class="chart-summary">
          <text class="cs-item">今日 {{dietToday}} kcal</text>
          <text class="cs-item">O?{{dietCount}} </text>
          <text class="cs-item">U
 {{dietDaily.length}} </text>
      </view>
      </view>
      <m-empty compact title="暂无饮食记录" />
      <view class="rec-item" wx:for="{{dietGroups}}" wx:for-item="group" wx:key="month" wx:for-index="gi">
        <view class="month-header"><text>{{group.month}}</text>
      </view>
        <view wx:for="{{group.items}}" wx:key="_id" bindtap="editDiet" data-id="{{item._id}}">
          <view class="rec-item">
            <view class="bp-row">
              <text class="bp-val">{{item._mealIcon}} {{item.food}}</text>
              <m-status-badge wx:if="{{item.calories}}" text="{{item.calories}} kcal" color="#FFA726" />
      </view>
            <view class="bp-meta">
              <text class="bp-date">{{item.date}}</text>
              <text>{{item._mealLabel}}</text>
      </view>
          </view>
        </view>
      </view>
      <view class="m-fab" bindtap="addDiet">+</view>
    </view>

<!-- ===== 饮食 ===== -->
    <view class="tab-content" wx:if="{{activeTab === 'medication'}}">
      <m-empty compact wx:if="{{meds.length === 0}}" title="暂无用药记录" />
      <view wx:for="{{medGroups}}" wx:for-item="group" wx:key="month">
        <view class="month-header"><text>{{group.month}}</text>
      </view>
        <view class="rec-item" wx:for="{{group.items}}" wx:key="_id" bindtap="editMed" data-id="{{item._id}}">
          <view class="rec-main">
            <text class="rec-value" style="font-size: 32rpx;">💊 {{item.name}}</text>
      </view>
          <view class="rec-notes">
            {{item.dosage || ''}} {{item.frequency || ''}}
          </view>
          <view class="rec-date">{{item._dateRange}}</view>
          <view wx:if="{{item.reminderEnabled}}" class="med-reminder">点击设置用药提醒</view>
        </view>
      </view>
      <view class="m-fab" bindtap="addMed">+</view>
    </view>

<!-- ===== 用药 ===== -->
    <view class="tab-content" wx:if="{{activeTab === 'visit'}}">
      <m-empty compact wx:if="{{visits.length === 0}}" title="暂无看诊记录" />
      <view wx:for="{{visitGroups}}" wx:for-item="group" wx:key="month">
        <view class="month-header"><text>{{group.month}}</text>
      </view>
        <view class="rec-item" wx:for="{{group.items}}" wx:key="_id" bindtap="editVisit" data-id="{{item._id}}">
          <view class="rec-main">
            <text class="rec-value" style="font-size: 32rpx;">🏥 {{item.hospital || '*-'}}</text>
      </view>
          <view wx:if="{{item.doctor}}" class="rec-notes">VdS{item.doctor}}</view>
          <view wx:if="{{item.diagnosis}}" class="rec-notes">C{item.diagnosis}}</view>
          <view class="rec-date">{{item._dateLabel}}</view>
        </view>
      </view>
      <view class="m-fab" bindtap="addVisit">+</view>
    </view>

<!-- ===== 看诊 ===== -->
    <view class="tab-content" wx:if="{{activeTab === 'period'}}">
      <view class="cycle-card {{cycleStageClass}}" wx:if="{{cycleInfo}}">
        <view class="cycle-label">当前阶段</view>
        <view class="cycle-text">{{cycleStageText}}</view>
        <view class="cycle-meta">
          <text>周期第 {{cycleInfo.dayInCycle}}/{{cycleInfo.totalDays}} 天</text>
          <text wx:if="{{cycleInfo.daysUntilNext}}">+%i;A {{cycleInfo.daysUntilNext}} </text>
      </view>
      </view>
      <m-empty compact wx:if="{{periods.length === 0}}" title="暂无生理期记录" />
      <view wx:for="{{periods}}" wx:key="_id" bindtap="editPeriod" data-id="{{item._id}}">
        <view class="rec-item">
          <view class="rec-main">
            <text class="rec-value" style="font-size: 32rpx;">🌸 {{item._dateRange}}</text>
      </view>
          <view wx:if="{{item._duration}}" class="rec-notes">持续 {{item._duration}} 天 </view>
        </view>
      </view>
      <view class="m-fab" bindtap="addPeriod">+</view>
    </view>

  </block>
</view>
<m-tab-bar id="tabbar" />
