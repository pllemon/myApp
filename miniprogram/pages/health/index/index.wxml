          wx:for="{{tabs}}" wx:for-item="t" wx:key="key"
          data-key="{{t.key}}" bindtap="switchTab">
      <text class="tab-ico">{{t.icon}}</text>
      <text class="tab-label">{{t.label}}</text>
      </view>
  </scroll-view>

