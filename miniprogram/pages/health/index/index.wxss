/* 健康概览页 · 仅保留 m2-* 全局构件之外的独有样式 */

/* 档案切换 / 指标切换条 */
.profile-bar, .tab-bar {
  margin: 0 24rpx 20rpx;
  white-space: nowrap;
}
.profile-chip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 18rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-sm);
  vertical-align: middle;
}
.profile-chip.active {
  background: var(--primary-light);
  border-color: var(--primary);
}
.profile-chip.add {
  border: 2rpx dashed var(--border);
  background: var(--bg);
  color: var(--text-2);
  font-size: 26rpx;
}
.profile-chip .avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
.p-info { display: flex; flex-direction: column; }
.p-name { font-size: 27rpx; font-weight: 600; color: var(--text); }
.p-sub { font-size: 20rpx; color: var(--text-3); margin-top: 2rpx; }

.tab-bar {
  display: block;
  padding: 10rpx;
  border-radius: 999rpx;
}
.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 108rpx;
  padding: 10rpx 6rpx;
  border-radius: 20rpx;
  margin-right: 4rpx;
  vertical-align: middle;
}
.tab-item.active { background: var(--primary-light); }
.tab-ico { display: flex; align-items: center; justify-content: center; margin-bottom: 4rpx; }
.tab-item.active .tab-ico { transform: scale(1.12); }
.tab-label { font-size: 21rpx; color: var(--text-2); }
.tab-item.active .tab-label { color: var(--primary-dark); font-weight: 600; }

.tab-content { min-height: 400rpx; }

/* Hero 头像 */
.hero-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.hero-head-main { flex: 1; min-width: 0; }

/* 概览指标卡 */
.overview-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 0 24rpx 20rpx; }
.mini-card {
  flex: 1 1 calc(50% - 8rpx);
  min-width: calc(50% - 8rpx);
  padding: 20rpx;
  background: var(--surface);
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
  border-left: 6rpx solid var(--primary);
  box-sizing: border-box;
}
.mini-title { font-size: 24rpx; color: var(--text-3); margin-bottom: 8rpx; }
.mini-value { font-size: 40rpx; font-weight: 700; color: var(--text); line-height: 1.2; }
.mini-unit { font-size: 24rpx; font-weight: 400; color: var(--text-3); margin-left: 4rpx; }
.mini-sub { font-size: 22rpx; color: var(--text-3); margin-top: 6rpx; }

/* 今日用药 */
.today-med-card { border-left: 6rpx solid var(--warning); }
.today-med-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.today-med-item:last-child { border-bottom: none; }
.tm-left { flex: 1; }
.tm-name { font-size: 27rpx; font-weight: 600; color: var(--warning-dark); }
.tm-dose { font-size: 22rpx; color: var(--text-3); display: block; margin-top: 4rpx; }
.tm-times { display: flex; gap: 8rpx; flex-wrap: wrap; }
.tm-chip {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  background: var(--warning-light);
  color: var(--warning-dark);
  border-radius: 12rpx;
}

/* 生理周期卡 */
.cycle-card { border-left: 6rpx solid var(--primary); }
.cycle-text { font-size: 36rpx; font-weight: 700; color: var(--text); margin-bottom: 12rpx; }
.cycle-meta { display: flex; flex-direction: column; gap: 6rpx; font-size: 23rpx; color: var(--text-2); }
.cycle-card.period .cycle-text { color: var(--danger); }
.cycle-card.ovulation .cycle-text { color: var(--warning); }
.cycle-card.fertile .cycle-text { color: var(--success); }
.cycle-card.safe .cycle-text { color: var(--primary); }

/* 趋势图卡 */
.chart-card { padding: 28rpx; }
.chart-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.chart-range { display: flex; gap: 10rpx; }
.range-btn {
  font-size: 21rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  color: var(--text-2);
}
.range-btn.active { background: var(--primary); color: #FFFFFF; font-weight: 600; }
.chart-canvas { width: 100%; height: 320rpx; }
.chart-summary {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
  flex-wrap: wrap;
}
.cs-item { font-size: 23rpx; color: var(--text-3); margin-left: 4rpx; font-weight: 400; }

/* 列表行图标 chip 底色 */
.m2-row-icon { background: var(--surface-2); }

/* 血糖类型标签 */
.glu-type {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  background: var(--warning-light);
  color: var(--warning-dark);
  border-radius: 10rpx;
}
.glu-date { color: var(--text-3); font-size: 22rpx; }

/* 快捷入口卡 */
.sc-card { display: flex; align-items: center; gap: 18rpx; }
