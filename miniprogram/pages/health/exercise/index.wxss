.container { padding: 24rpx; padding-bottom: 140rpx; }

.chart-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.chart-title { font-size: 28rpx; font-weight: 600; color: #333; }
.chart-range { font-size: 24rpx; color: #43A047; }
.chart-canvas { width: 100%; height: 300rpx; }

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  padding: 16rpx 8rpx 12rpx;
}

.record-list {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.ex-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.ex-item:last-child { border-bottom: none; }

.ex-ico {
  width: 64rpx;
  height: 64rpx;
  background-color: rgba(76, 175, 80, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.ex-info { flex: 1; }

.ex-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ex-type {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.ex-duration {
  font-size: 24rpx;
  color: #43A047;
  background-color: rgba(76, 175, 80, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
}

.ex-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 6rpx;
}

.ex-date, .ex-distance {
  font-size: 24rpx;
  color: #999;
}

.ex-calories {
  font-size: 28rpx;
  font-weight: 600;
  color: #43A047;
}


