/* 运动列表独有：趋势图 / 时长与距离标签（Hero、列表、空态、FAB 走 m2-* 全局类） */
.chart-canvas { width: 100%; height: 300rpx; }
.chart-range { font-size: 22rpx; color: var(--success); }
.duration-tag { font-size: 20rpx; color: var(--success); background: var(--success-light); padding: 4rpx 12rpx; border-radius: var(--radius-full); margin-left: 12rpx; }
.distance-tag { margin-left: 12rpx; }
