<view class="m2-page" style="{{themeStyle}}">
  <!-- 运动概览 Hero -->
  <view class="m2-hero">
    <view class="m2-hero-head">
      <view>
        <view class="m2-hero-title">运动记录</view>
        <view class="m2-hero-sub">动起来，遇见更好的自己</view>
      </view>
    </view>
    <view class="m2-hero-value">{{records.length}}<text class="m2-hero-unit">次</text></view>
    <view class="m2-hero-note">累计运动打卡</view>
  </view>

  <!-- 运动趋势图（picker 保留原交互） -->
  <view class="m2-card">
    <view class="m2-card-head">
      <view class="m2-card-title">运动趋势</view>
      <picker mode="selector" range="{{ranges}}" range-key="label" value="{{chartRangeIdx}}" bindchange="onRangeChange">
        <view class="m2-card-action chart-range">{{ranges[chartRangeIdx].label}} ›</view>
      </picker>
    </view>
    <canvas canvas-id="exerciseChart" class="chart-canvas"></canvas>
  </view>

  <!-- 运动记录 -->
  <view class="m2-group">
    <view class="m2-group-head"><view class="m2-group-title">运动记录</view></view>
    <m-empty wx:if="{{records.length === 0}}" title="暂无运动记录，去记录第一次运动吧" />
    <view wx:else class="m2-list">
      <view class="m2-row" wx:for="{{records}}" wx:key="_id" bindtap="goEdit" data-id="{{item._id}}" bindlongpress="onItemLongPress">
        <view class="m2-row-icon" style="background:var(--success-light)"><m-icon name="sport" size="36" tone="health" healthKey="运动" /></view>
        <view class="m2-row-body">
          <view class="m2-row-title">
            <text>{{item._typeLabel}}</text>
            <text wx:if="{{item._durationStr}}" class="duration-tag">{{item._durationStr}}</text>
          </view>
          <view class="m2-row-sub">
            <text>{{item.date}} {{item.time || ''}}</text>
            <text wx:if="{{item._distanceStr}}" class="distance-tag">距离 {{item._distanceStr}}</text>
          </view>
        </view>
        <view wx:if="{{item._caloriesStr}}" class="m2-row-value m-text-success">{{item._caloriesStr}}</view>
      </view>
    </view>
  </view>

  <view class="m2-fab" bindtap="goNew"><m-icon name="add" size="44" inline /></view>
</view>
