<view class="m2-page m2-edit" style="{{themeStyle}}">
  <view class="m2-edit-hero">
    <view class="m2-edit-hero-icon" style="background: var(--primary-light)"><m-icon tone="health" healthKey="生理期" size="44" /></view>
    <view>
      <view class="m2-edit-title">{{isEdit ? '编辑生理期' : '新增生理期'}}</view>
      <view class="m2-edit-desc">记录经期状态，自动推算周期</view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">经期记录</view>
    <view class="m2-field-row">
      <view class="m2-field half">
        <view class="m2-field-label">开始日期</view>
        <picker mode="date" value="{{startDate}}" bindchange="onStartChange">
          <view class="m2-field-value {{startDate ? '' : 'placeholder'}}">{{startDate || '选择'}}</view>
        </picker>
        <view class="m2-field-arrow">›</view>
      </view>
      <view class="m2-field half">
        <view class="m2-field-label">结束日期</view>
        <picker mode="date" value="{{endDate}}" bindchange="onEndChange">
          <view class="m2-field-value {{endDate ? '' : 'placeholder'}}">{{endDate || '选择'}}</view>
        </picker>
        <view class="m2-field-arrow">›</view>
      </view>
    </view>
    <m-option-picker label="经量" options="{{flowOptions}}" currentValue="{{flow}}" bind:change="onFlowChange">
      {{flow || '选择量'}}
    </m-option-picker>
    <m-option-picker label="症状" options="{{symptomOptions}}" currentValue="{{symptoms}}" multiple bind:change="onSymptomsChange">
      {{symptoms.length > 0 ? symptoms.join('、') : '选填'}}
    </m-option-picker>
    <m-option-picker label="心情" options="{{moodOptions}}" currentValue="{{mood}}" closeOnSelect="{{false}}" bind:change="onMoodChange">
      {{moodLabel || '选填'}}
    </m-option-picker>
    <view class="m2-field">
      <view class="m2-field-label">腹痛程度</view>
      <view class="pain-slider-row">
        <slider class="pain-slider" min="0" max="10" value="{{painLevel}}" activeColor="var(--primary)" block-size="20" bindchange="onPainChange" show-value="{{false}}" />
        <view class="pain-text">{{painText}}</view>
      </view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">备注</view>
    <view class="m2-field textarea-field">
      <view class="m2-field-label">备注</view>
      <textarea class="m2-field-value" placeholder="选填" value="{{notes}}" bindinput="onNotesInput" auto-height maxlength="200" />
    </view>
  </view>

  <view class="m2-footer">
    <view class="m2-btn m2-btn-primary" bindtap="save">保存</view>
  </view>
</view>
