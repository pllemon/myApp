<view class="m2-page m2-edit" style="{{themeStyle}}">
  <view class="m2-edit-hero">
    <view class="m2-edit-hero-icon" style="background: var(--primary-light)"><m-icon tone="health" healthKey="睡眠" size="44" /></view>
    <view>
      <view class="m2-edit-title">{{isEdit ? '编辑睡眠' : '新增睡眠'}}</view>
      <view class="m2-edit-desc">记录作息时间，关注睡眠质量</view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">睡眠数据</view>
    <picker mode="date" value="{{date}}" bindchange="onDateChange">
      <view class="m2-field">
        <view class="m2-field-label">日期</view>
        <view class="m2-field-value">{{date}}</view>
        <view class="m2-field-arrow">›</view>
      </view>
    </picker>
    <picker mode="time" value="{{sleepTime}}" bindchange="onSleepChange">
      <view class="m2-field">
        <view class="m2-field-label">入睡时间</view>
        <view class="m2-field-value {{sleepTime ? '' : 'placeholder'}}">{{sleepTime || '未选择'}}</view>
        <view class="m2-field-arrow">›</view>
      </view>
    </picker>
    <picker mode="time" value="{{wakeTime}}" bindchange="onWakeChange">
      <view class="m2-field">
        <view class="m2-field-label">起床时间</view>
        <view class="m2-field-value {{wakeTime ? '' : 'placeholder'}}">{{wakeTime || '未选择'}}</view>
        <view class="m2-field-arrow">›</view>
      </view>
    </picker>
    <view class="m2-field">
      <view class="m2-field-label">总时长</view>
      <view class="m2-field-value">{{duration || '自动计算'}}</view>
    </view>
    <view class="m2-field">
      <view class="m2-field-label">深睡时长 (小时)</view>
      <input class="m2-field-value" type="digit" value="{{deepSleep}}" placeholder="选填" bindinput="onDeepInput" />
    </view>
    <m-option-picker label="睡眠质量" options="{{qualityOptions}}" currentValue="{{qualityIdx}}" activeBy="index" bind:change="onQualityChange">
      {{qualityOptions[qualityIdx].label}}
    </m-option-picker>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">备注</view>
    <view class="m2-field textarea-field">
      <view class="m2-field-label">备注</view>
      <textarea class="m2-field-value" placeholder="选填" value="{{notes}}" bindinput="onNoteInput" auto-height maxlength="200" />
    </view>
  </view>

  <view class="m2-footer">
    <view class="m2-btn m2-btn-primary" bindtap="save">保存</view>
  </view>
</view>
