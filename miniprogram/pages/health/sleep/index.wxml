<view class="m2-page" style="{{themeStyle}}">
  <!-- 睡眠概览 Hero -->
  <view class="m2-hero">
    <view class="m2-hero-head">
      <view>
        <view class="m2-hero-title">睡眠记录</view>
        <view class="m2-hero-sub">睡个好觉，元气满满</view>
      </view>
    </view>
    <view class="m2-hero-value">{{durationStats.avg || '--'}}<text class="m2-hero-unit">h</text></view>
    <view class="m2-hero-note">平均时长</view>
    <view class="m2-hero-stats">
      <view class="m2-hero-stat">
        <view class="m2-hero-stat-value">{{idealRate}}<text class="m2-hero-unit">%</text></view>
        <view class="m2-hero-stat-label">理想率</view>
      </view>
      <view class="m2-hero-stat">
        <view class="m2-hero-stat-value">{{avgQuality || '--'}}</view>
        <view class="m2-hero-stat-label">平均质量</view>
      </view>
    </view>
  </view>

  <!-- 睡眠趋势图（picker 保留原交互） -->
  <view class="m2-card">
    <view class="m2-card-head">
      <view class="m2-card-title">睡眠趋势</view>
      <picker mode="selector" range="{{ranges}}" range-key="label" value="{{chartRangeIdx}}" bindchange="onRangeChange">
        <view class="m2-card-action chart-range">{{ranges[chartRangeIdx].label}} ›</view>
      </picker>
    </view>
    <canvas canvas-id="sleepChart" class="chart-canvas"></canvas>
    <view wx:if="{{durationStats.count > 0}}" class="chart-summary">
      <text class="cs-item">最长 {{durationStats.max}}h</text>
      <text class="cs-item">最短 {{durationStats.min}}h</text>
      <text class="cs-item">共 {{durationStats.count}} 次</text>
    </view>
  </view>

  <!-- 睡眠记录 -->
  <view class="m2-group">
    <view class="m2-group-head"><view class="m2-group-title">睡眠记录</view></view>
    <m-empty wx:if="{{records.length === 0}}" title="暂无睡眠记录，去记录一次好眠吧" />
    <view wx:else class="m2-list">
      <view class="m2-row" wx:for="{{records}}" wx:key="_id" bindtap="goEdit" data-id="{{item._id}}" bindlongpress="onItemLongPress">
        <view class="m2-row-icon" style="background:var(--primary-light)"><m-icon name="moon" size="36" tone="health" healthKey="睡眠" /></view>
        <view class="m2-row-body">
          <view class="m2-row-title sleep-duration {{item._isEnough ? 'good' : 'warn'}}">{{item._durationStr}}</view>
          <view class="m2-row-sub">{{item.date}} {{item.sleepTime}} - {{item.wakeTime}}</view>
        </view>
        <view class="m2-row-value">
          <view class="m2-badge {{item._isEnough ? 'm2-badge-success' : 'm2-badge-warning'}}">{{item._qualityLabel}}</view>
          <view wx:if="{{item.deepSleep}}" class="deep-tag">深睡 {{item.deepSleep}}h</view>
        </view>
      </view>
    </view>
  </view>

  <view class="m2-fab" bindtap="goNew"><m-icon name="add" size="44" inline /></view>
</view>
