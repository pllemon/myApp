.container { padding: 24rpx; padding-bottom: 140rpx; }

.sleep-summary {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #EDE7F6 0%, #D1C4E9 100%);
  border-radius: 20rpx;
  padding: 28rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(126, 87, 194, 0.12);
}

.ss-item {
  flex: 1;
  text-align: center;
}

.ss-label {
  font-size: 22rpx;
  color: #5E35B1;
  display: block;
  margin-bottom: 6rpx;
}

.ss-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #4527A0;
}

.ss-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #5E35B1;
}

.ss-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: rgba(126, 87, 194, 0.2);
}

.chart-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.chart-title { font-size: 28rpx; font-weight: 600; color: #333; }
.chart-range { font-size: 24rpx; color: #7E57C2; }
.chart-canvas { width: 100%; height: 300rpx; }
.chart-summary {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #F5F5F5;
}
.cs-item { font-size: 24rpx; color: #999; }

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  padding: 16rpx 8rpx 12rpx;
}

.record-list {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.sleep-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.sleep-item:last-child { border-bottom: none; }

.si-left { flex: 1; }

.si-duration {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.si-duration.good { color: #7E57C2; }
.si-duration.warn { color: #E67E22; }

.si-datetime {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.si-right { text-align: right; }

.si-quality {
  font-size: 26rpx;
  color: #333;
}

.si-deep {
  font-size: 22rpx;
  color: #7E57C2;
  background-color: rgba(126, 87, 194, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-top: 6rpx;
  display: inline-block;
}


