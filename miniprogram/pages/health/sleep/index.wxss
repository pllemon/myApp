/* 睡眠列表独有：趋势图 / 质量标签（Hero、segment、列表、空态、FAB 走 m2-* 全局类） */
.chart-canvas { width: 100%; height: 300rpx; }
.chart-range { font-size: 22rpx; color: var(--primary); }
.chart-summary { display: flex; gap: 20rpx; margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid var(--border); }
.cs-item { font-size: 22rpx; color: var(--text-3); }

.sleep-duration { font-size: 32rpx; font-weight: 700; }
.sleep-duration.good { color: var(--success); }
.sleep-duration.warn { color: var(--warning-dark); }
.deep-tag { font-size: 20rpx; color: var(--primary-dark); background: var(--primary-light); padding: 4rpx 12rpx; border-radius: var(--radius-full); margin-top: 8rpx; }
