<view class="m2-page m2-edit" style="{{themeStyle}}">
  <view class="m2-edit-hero">
    <view class="m2-edit-hero-icon" style="background: var(--primary-light)"><m-icon tone="health" healthKey="看诊" size="44" /></view>
    <view>
      <view class="m2-edit-title">{{isEdit ? '编辑看诊' : '新增看诊'}}</view>
      <view class="m2-edit-desc">记录就诊过程与医嘱，健康档案更完整</view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">基本信息</view>
    <picker mode="date" value="{{date}}" bindchange="onDateChange">
      <view class="m2-field">
        <view class="m2-field-label">就诊日期</view>
        <view class="m2-field-value">{{date}}</view>
        <view class="m2-field-arrow">›</view>
      </view>
    </picker>
    <m-option-picker label="就诊类型" options="{{visitTypes}}" currentValue="{{visitType}}" bind:change="onTypeChange">
      {{visitType}}
    </m-option-picker>
    <view class="m2-field">
      <view class="m2-field-label">标题</view>
      <input class="m2-field-value" placeholder="自动或自定义" value="{{title}}" bindinput="onTitleInput" maxlength="30" />
    </view>
    <view class="m2-field">
      <view class="m2-field-label">医院</view>
      <input class="m2-field-value" placeholder="请输入医院名称" value="{{hospital}}" bindinput="onHospitalInput" maxlength="30" />
    </view>
    <view class="m2-field">
      <view class="m2-field-label">科室</view>
      <input class="m2-field-value" placeholder="例如 内科" value="{{department}}" bindinput="onDeptInput" maxlength="20" />
    </view>
    <view class="m2-field">
      <view class="m2-field-label">医生</view>
      <input class="m2-field-value" placeholder="医生姓名" value="{{doctor}}" bindinput="onDoctorInput" maxlength="20" />
    </view>
    <view class="m2-field">
      <view class="m2-field-label">费用 (元)</view>
      <input class="m2-field-value" type="digit" placeholder="选填" value="{{cost}}" bindinput="onCostInput" />
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">诊疗详情</view>
    <view class="m2-field textarea-field">
      <view class="m2-field-label">诊断结果</view>
      <textarea class="m2-field-value" placeholder="医生诊断的内容" value="{{diagnosis}}" bindinput="onDiagnosisInput" auto-height maxlength="300" />
    </view>
    <view class="m2-field textarea-field">
      <view class="m2-field-label">治疗方案</view>
      <textarea class="m2-field-value" placeholder="治疗、用药、复查等建议" value="{{treatment}}" bindinput="onTreatmentInput" auto-height maxlength="500" />
    </view>
    <view class="m2-field textarea-field">
      <view class="m2-field-label">备注</view>
      <textarea class="m2-field-value" placeholder="其他需要记录的内容（选填）" value="{{notes}}" bindinput="onNotesInput" auto-height maxlength="300" />
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">报告单 / 处方照片</view>
    <m-image-picker images="{{images}}" max="6" bind:change="onImagesChange" />
  </view>

  <view class="m2-footer">
    <view class="m2-btn m2-btn-primary" bindtap="save">保存</view>
    <view wx:if="{{isEdit}}" class="m2-btn m2-btn-danger" bindtap="remove">删除</view>
  </view>
</view>
