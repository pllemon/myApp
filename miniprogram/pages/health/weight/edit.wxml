<view class="container m-edit-page">
  <view class="m-form-card">
    <view class="m-form-title">⚖️ 体重记录</view>

    <m-field label="日期">
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="m-form-picker-value">{{date}}</view>
      </picker>
    </m-field>

    <m-field label="体重 (kg)">
      <input class="m-form-input" type="digit" value="{{weight}}" placeholder="例如 65.5" bindinput="onWeightInput" />
    </m-field>

    <m-field label="体脂率 (%)">
      <input class="m-form-input" type="digit" value="{{bodyFat}}" placeholder="选填" bindinput="onBodyFatInput" />
    </m-field>

    <m-field wx:if="{{bmiPreview}}" label="BMI 预览">
      <view class="m-form-picker-value">
        <m-status-badge text="{{bmiPreview.label}}" color="{{bmiPreview.color}}" />
      </view>
    </m-field>
  </view>

  <view class="m-form-card">
    <view class="m-form-title">📝 备注</view>
    <m-field block>
      <textarea class="m-form-textarea" placeholder="选填" value="{{notes}}" bindinput="onNotesInput" auto-height maxlength="200" />
    </m-field>
  </view>

  <m-save-bar save-text="{{isEdit ? '保存修改' : '保存记录'}}" bind:save="save" />
</view>