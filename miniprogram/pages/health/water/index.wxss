.container { padding: 24rpx; padding-bottom: 140rpx; }

.goal-card {
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(33, 150, 243, 0.12);
}

.goal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.goal-label { font-size: 28rpx; color: #1565C0; font-weight: 600; }
.goal-set { font-size: 24rpx; color: #1976D2; }

.goal-bar-wrap {
  height: 24rpx;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 12rpx;
  overflow: hidden;
}

.goal-bar {
  height: 100%;
  background: linear-gradient(90deg, #42A5F5, #1E88E5);
  border-radius: 12rpx;
  transition: width 0.3s ease;
}

.goal-text {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.goal-current { font-size: 48rpx; font-weight: 700; color: #1565C0; }
.goal-unit { font-size: 24rpx; color: #1976D2; }
.goal-divider { font-size: 24rpx; color: #90CAF9; margin: 0 6rpx; }
.goal-target { font-size: 26rpx; color: #1976D2; }

.goal-status {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #1976D2;
}

.quick-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.quick-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1976D2;
  box-shadow: 0 2rpx 8rpx rgba(33, 150, 243, 0.12);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  padding: 16rpx 8rpx 12rpx;
}

.water-list {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.water-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.water-item:last-child { border-bottom: none; }

.w-ico {
  width: 60rpx;
  height: 60rpx;
  background-color: rgba(33, 150, 243, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.w-info { flex: 1; }
.w-time, .w-date { font-size: 28rpx; color: #333; font-weight: 500; display: block; }
.w-note { font-size: 24rpx; color: #999; margin-top: 4rpx; display: block; }
.w-amount { font-size: 28rpx; font-weight: 600; color: #1E88E5; }

.month-group { margin-top: 8rpx; }
.month-header {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 8rpx 8rpx;
}
.month-label { font-size: 26rpx; font-weight: 600; color: #666; }
.month-total { font-size: 24rpx; color: #999; }


