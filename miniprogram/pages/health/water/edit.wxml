<view class="m2-page m2-edit" style="{{themeStyle}}">
  <view class="m2-edit-hero">
    <view class="m2-edit-hero-icon" style="background: var(--primary-light)"><m-icon tone="health" healthKey="饮水" size="44" /></view>
    <view>
      <view class="m2-edit-title">{{isEdit ? '编辑饮水' : '新增饮水'}}</view>
      <view class="m2-edit-desc">记录每一次饮水，达成每日目标</view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">饮水数据</view>
    <view class="m2-field">
      <view class="m2-field-label">日期</view>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="m2-field-value">{{date}}</view>
      </picker>
      <view class="m2-field-arrow">›</view>
    </view>
    <view class="m2-field">
      <view class="m2-field-label">时间</view>
      <picker mode="time" value="{{time}}" bindchange="onTimeChange">
        <view class="m2-field-value">{{time}}</view>
      </picker>
      <view class="m2-field-arrow">›</view>
    </view>
    <view class="m2-field">
      <view class="m2-field-label">饮水量 (ml)</view>
      <input class="m2-field-value" type="number" value="{{amount}}" placeholder="例如 250，范围 1-5000" bindinput="onAmountInput" />
    </view>
    <view class="m2-form-title">快捷量</view>
    <view class="m2-chip-row">
      <view
        wx:for="{{quickAmounts}}"
        wx:key="*this"
        class="m2-chip"
        data-val="{{item}}"
        bindtap="onQuickTap"
      >{{item}}ml</view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">备注</view>
    <view class="m2-field textarea-field">
      <view class="m2-field-label">备注</view>
      <textarea class="m2-field-value" placeholder="选填" value="{{notes}}" bindinput="onNoteInput" auto-height maxlength="200" />
    </view>
  </view>

  <view class="m2-footer">
    <view class="m2-btn m2-btn-primary" bindtap="save">保存</view>
  </view>
</view>
