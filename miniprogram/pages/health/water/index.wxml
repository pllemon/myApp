<view class="m2-page" style="{{themeStyle}}">
  <!-- 今日饮水 Hero -->
  <view class="m2-hero">
    <view class="m2-hero-head">
      <view>
        <view class="m2-hero-title">今日饮水</view>
        <view class="m2-hero-sub">多喝水，保持好状态</view>
      </view>
      <view class="m2-hero-action" bindtap="onGoalEdit">目标 {{goal}}ml ›</view>
    </view>
    <view class="m2-hero-value"><text class="m2-hero-unit">{{todayTotal}}</text>ml</view>
    <view class="m2-hero-note" wx:if="{{todayTotal >= goal}}">目标已达成！今日喝了 {{todayTotal}}ml</view>
    <view class="m2-hero-note" wx:else>还差 {{goal - todayTotal}}ml 加油！</view>
    <view class="hero-progress">
      <view class="hero-progress-fill" style="width: {{goal > 0 ? (todayTotal / goal * 100 > 100 ? 100 : todayTotal / goal * 100) : 0}}%;"></view>
    </view>
  </view>

  <!-- 快捷添加 -->
  <view class="m2-card quick-card">
    <view class="m2-card-head"><view class="m2-card-title">快捷添加</view></view>
    <view class="quick-row">
      <view class="quick-btn" wx:for="{{quickAmounts}}" wx:key="*this" data-val="{{item}}" bindtap="onAddQuick">+{{item}}</view>
    </view>
  </view>

  <!-- 今日饮水 -->
  <view class="m2-group">
    <view class="m2-group-head"><view class="m2-group-title">今日饮水</view></view>
    <m-empty wx:if="{{todayRecords.length === 0}}" title="还没喝水哦，快去添加吧" />
    <view wx:else class="m2-list">
      <view class="m2-row" wx:for="{{todayRecords}}" wx:key="_id" bindtap="goEdit" data-id="{{item._id}}" bindlongpress="onItemLongPress">
        <view class="m2-row-icon" style="background:var(--primary-light)"><m-icon name="droplet" size="36" tone="health" healthKey="饮水" /></view>
        <view class="m2-row-body">
          <view class="m2-row-title">{{item.time || ''}}</view>
          <view wx:if="{{item.note}}" class="m2-row-sub">{{item.note}}</view>
        </view>
        <view class="m2-row-value m-text-primary">+{{item.amount}}ml</view>
      </view>
    </view>
  </view>

  <!-- 历史记录 -->
  <block wx:if="{{monthGroups.length > 0}}">
    <view class="m2-group-head"><view class="m2-group-title">历史记录</view></view>
    <view class="m2-group" wx:for="{{monthGroups}}" wx:for-item="group" wx:key="month">
      <view class="m2-group-head">
        <view class="m2-group-title">{{group.month}}</view>
        <view class="m2-group-count">共 {{group.total}}ml</view>
      </view>
      <view class="m2-list">
        <view class="m2-row" wx:for="{{group.items}}" wx:for-item="item" wx:key="_id" bindtap="goEdit" data-id="{{item._id}}" bindlongpress="onItemLongPress">
          <view class="m2-row-icon" style="background:var(--primary-light)"><m-icon name="droplet" size="36" tone="health" healthKey="饮水" /></view>
          <view class="m2-row-body">
            <view class="m2-row-title">{{item.date}} {{item.time || ''}}</view>
            <view wx:if="{{item.note}}" class="m2-row-sub">{{item.note}}</view>
          </view>
          <view class="m2-row-value m-text-primary">+{{item.amount}}ml</view>
        </view>
      </view>
    </view>
  </block>

  <view class="m2-fab" bindtap="goNew"><m-icon name="add" size="44" inline /></view>
</view>
