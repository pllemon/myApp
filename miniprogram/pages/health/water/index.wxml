<view class="container">
  <view class="goal-card">
    <view class="goal-header">
      <text class="goal-label">今日目标</text>
      <text class="goal-set" bindtap="onGoalEdit">{{goal}}ml ›</text>
    </view>
    <view class="goal-bar-wrap">
      <view class="goal-bar" style="width: {{goal > 0 ? (todayTotal / goal * 100 > 100 ? 100 : todayTotal / goal * 100) : 0}}%;"></view>
    </view>
    <view class="goal-text">
      <text class="goal-current">{{todayTotal}}</text>
      <text class="goal-unit">ml</text>
      <text class="goal-divider">/</text>
      <text class="goal-target">{{goal}}ml</text>
    </view>
    <view class="goal-status">
      <text wx:if="{{todayTotal >= goal}}">🎉 目标已达成！今日喝了 {{todayTotal}}ml</text>
      <text wx:else>还差 {{goal - todayTotal}}ml 加油！</text>
    </view>
  </view>

  <view class="section-title">今日饮水</view>
  <m-empty compact wx:if="{{todayRecords.length === 0}}" title="还没喝水哦，快去添加吧" />
  <view wx:else class="water-list">
    <view class="water-item" wx:for="{{todayRecords}}" wx:key="_id" bindtap="goEdit" data-id="{{item._id}}" bindlongpress="deleteItem">
      <view class="w-ico">💧</view>
      <view class="w-info">
        <text class="w-time">{{item.time || ''}}</text>
        <text wx:if="{{item.note}}" class="w-note">{{item.note}}</text>
      </view>
      <view class="w-amount">+{{item.amount}}ml</view>
    </view>
  </view>

  <view wx:if="{{monthGroups.length > 0}}" class="section-title">历史记录</view>
  <view wx:for="{{monthGroups}}" wx:for-item="group" wx:key="month" class="month-group">
    <view class="month-header">
      <text class="month-label">{{group.month}}</text>
      <text class="month-total">共 {{group.total}}ml</text>
    </view>
    <view class="water-item" wx:for="{{group.items}}" wx:for-item="item" wx:key="_id" bindtap="goEdit" data-id="{{item._id}}" bindlongpress="deleteItem">
      <view class="w-ico">💧</view>
      <view class="w-info">
        <text class="w-date">{{item.date}} {{item.time || ''}}</text>
        <text wx:if="{{item.note}}" class="w-note">{{item.note}}</text>
      </view>
      <view class="w-amount">+{{item.amount}}ml</view>
    </view>
  </view>

  <view class="m-fab" bindtap="goNew">+</view>
</view>