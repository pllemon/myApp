<view class="container m-edit-page">
  <view class="m-form-card">
    <view class="m-form-title">🍱 饮食记录</view>

    <m-field label="日期">
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="m-form-picker-value">{{date}}</view>
      </picker>
    </m-field>

    <m-option-picker label="餐次" options="{{mealOptions}}" currentValue="{{mealType}}" bind:change="onMealChange">
      {{mealIcon}} {{mealLabel}}
    </m-option-picker>

    <m-field label="食物">
      <input class="m-form-input" placeholder="例如：米饭 + 西红柿炒蛋" value="{{food}}" bindinput="onFoodInput" maxlength="50" />
    </m-field>

    <m-field label="热量 (kcal)">
      <input class="m-form-input" type="number" placeholder="可选" value="{{calories}}" bindinput="onCaloriesInput" />
    </m-field>
  </view>

  <view class="m-form-card">
    <view class="m-form-title">📝 备注</view>
    <m-field block>
      <textarea class="m-form-textarea" placeholder="选填" value="{{notes}}" bindinput="onNotesInput" auto-height maxlength="200" />
    </m-field>
  </view>

  <m-save-bar save-text="{{isEdit ? '保存修改' : '保存记录'}}" bind:save="save" />
</view>