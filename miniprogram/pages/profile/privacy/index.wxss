.privacy-hero { text-align: center; }
.privacy-hero-icon { position: relative; z-index: 1; display: flex; justify-content: center; margin-bottom: 16rpx; }

/* 三要点摘要 */
.privacy-summary-card { background: var(--primary-light); }
.privacy-summary-item { display: flex; align-items: center; gap: 14rpx; padding: 10rpx 0; font-size: 26rpx; color: var(--text); }
.privacy-summary-icon { width: 48rpx; height: 48rpx; border-radius: 14rpx; background: var(--surface); }

/* 政策正文 */
.privacy-section-title { font-size: 30rpx; margin-bottom: 16rpx; }
.privacy-paragraph { font-size: 26rpx; line-height: 1.8; color: var(--text-2); margin-bottom: 12rpx; }
.privacy-paragraph:last-child { margin-bottom: 0; }

.privacy-footer { text-align: center; font-size: 22rpx; color: var(--text-3); line-height: 1.8; padding: 24rpx 0; }
