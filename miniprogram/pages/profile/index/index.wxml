<view class="m2-page with-tabbar" style="{{themeStyle}}">
  <!-- 用户卡：头像 + 昵称 + ID -->
  <view class="m2-hero">
    <view class="m2-hero-head">
      <view class="profile-user">
        <view class="profile-avatar"><m-icon name="user" size="56" color="var(--primary-dark)" /></view>
        <view class="profile-id">
          <view class="m2-hero-title profile-nickname" bindtap="editNickname">{{nickname}}<m-icon name="edit" size="28" inline color="var(--text-inverse)" /></view>
          <view class="m2-hero-sub profile-idline">ID: {{openIdTail}}{{openIdTail ? ' · ' : ''}}<m-icon name="storage" size="28" tone="system" inline />本地模式</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 记录概览：连续记录天数 + 本月概况，整卡可点击进入数据洞察 -->
  <view class="m2-card profile-overview" bindtap="goOverview">
    <view class="profile-overview-main">
      <view class="profile-overview-label">连续记录</view>
      <view class="profile-overview-value">{{streakDays}}<text class="profile-overview-unit">天</text></view>
      <view class="profile-overview-sub">本月 {{monthAccounting}} 笔账 · {{monthSummary.checkin}} 次打卡</view>
    </view>
    <view class="profile-overview-arrow"><m-icon name="chevronRight" size="32" inline /></view>
  </view>

  <!-- 快捷操作 -->
  <view class="m2-card">
    <view class="m2-card-head">
      <view class="m2-card-title">快捷操作</view>
    </view>
    <view class="m2-row" bindtap="goTheme">
      <view class="m2-row-icon profile-menu-icon"><m-icon name="palette" size="36" /></view>
      <view class="m2-row-body"><view class="m2-row-title">切换主题</view></view>
      <view class="m2-row-arrow"><m-icon name="chevronRight" size="28" inline /></view>
    </view>
    <view class="m2-row" bindtap="goExport">
      <view class="m2-row-icon profile-menu-icon"><m-icon name="export" size="36" /></view>
      <view class="m2-row-body"><view class="m2-row-title">导出数据</view></view>
      <view class="m2-row-arrow"><m-icon name="chevronRight" size="28" inline /></view>
    </view>
    <view class="m2-row" bindtap="onFeedback">
      <view class="m2-row-icon profile-menu-icon"><m-icon name="feedback" size="36" /></view>
      <view class="m2-row-body"><view class="m2-row-title">意见反馈</view></view>
      <view class="m2-row-arrow"><m-icon name="chevronRight" size="28" inline /></view>
    </view>
  </view>

  <!-- 功能入口列表 -->
  <view class="m2-list">
    <view
      class="m2-row"
      wx:for="{{menus}}"
      wx:key="id"
      data-path="{{item.path}}"
      catchtap="goMenu"
    >
      <view class="m2-row-icon profile-menu-icon"><m-icon value="{{item.icon}}" size="36" /></view>
      <view class="m2-row-body">
        <view class="m2-row-title">{{item.title}}</view>
      </view>
      <view class="m2-row-arrow"><m-icon name="chevronRight" size="28" inline /></view>
    </view>
  </view>
</view>
<m-tab-bar id="tabbar" />
