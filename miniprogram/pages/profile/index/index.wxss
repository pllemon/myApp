/* 用户卡：头像与昵称信息组 */
.profile-user { display: flex; align-items: center; gap: 20rpx; }
.profile-avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%; flex-shrink: 0;
  background: var(--surface); display: flex; align-items: center; justify-content: center;
}
.profile-id { min-width: 0; }
.profile-nickname { display: flex; align-items: center; gap: 10rpx; }
.profile-idline { display: flex; align-items: center; gap: 6rpx; }

/* 功能入口图标底色 */
.profile-menu-icon { background: var(--primary-light); }

/* 记录概览卡：连续记录天数 + 本月概况 */
.profile-overview { display: flex; align-items: center; justify-content: space-between; }
.profile-overview-main { min-width: 0; }
.profile-overview-label { font-size: 24rpx; color: var(--text-3); }
.profile-overview-value {
  font-size: 68rpx; font-weight: 700; line-height: 1.15; color: var(--primary-dark);
  margin: 6rpx 0 8rpx; font-variant-numeric: tabular-nums;
}
.profile-overview-unit { font-size: 26rpx; font-weight: 500; margin-left: 8rpx; }
.profile-overview-sub { font-size: 23rpx; color: var(--text-3); }
.profile-overview-arrow { display: flex; color: var(--text-3); }
