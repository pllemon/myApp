.profile-header { display: flex; align-items: center; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); border-radius: 16rpx; padding: 40rpx 32rpx; margin-bottom: 24rpx; color: #fff; }
.avatar { width: 110rpx; height: 110rpx; border-radius: 50%; background: rgba(255,255,255,0.25); display: flex; align-items: center; justify-content: center; font-size: 56rpx; margin-right: 28rpx; }
.profile-info { flex: 1; }
.nickname { font-size: 36rpx; font-weight: 600; }
.uid { font-size: 24rpx; opacity: 0.8; margin-top: 8rpx; }

.month-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.mc-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}
.mc-grid {
  display: flex;
}
.mc-cell {
  flex: 1;
  text-align: center;
}
.mc-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}
.mc-value.expense { color: #F5A623; }
.mc-value.income { color: #4CAF50; }
.mc-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.summary-grid {
  display: flex;
  flex-wrap: wrap;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx 0;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.summary-cell {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}
.sum-num { font-size: 40rpx; font-weight: 600; color: var(--text); }
.sum-label { font-size: 24rpx; color: var(--text-secondary); margin-top: 8rpx; }

.sec-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin: 16rpx 0 16rpx;
  padding-left: 4rpx;
}
.quick-grid-wrap {
  display: flex;
  flex-wrap: wrap;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.quick-cell {
  width: 33.33%;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.qc-icon { font-size: 44rpx; margin-bottom: 8rpx; }
.qc-label { font-size: 24rpx; color: #555; }

.menu-list { background: var(--bg-card); border-radius: 16rpx; overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.menu-item { display: flex; align-items: center; padding: 32rpx; border-bottom: 1rpx solid var(--divider); }
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 40rpx; margin-right: 24rpx; }
.menu-title { flex: 1; font-size: 30rpx; color: var(--text); }
.menu-arrow { font-size: 40rpx; color: var(--text-secondary); }