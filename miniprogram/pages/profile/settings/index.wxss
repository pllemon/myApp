.section { margin-bottom: 16rpx; }
.section-label { font-size: 26rpx; color: var(--text-secondary); margin: 8rpx 8rpx 16rpx; }
.card { background: var(--bg-card); border-radius: 16rpx; padding: 28rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }

.theme-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.theme-item { display: flex; align-items: center; padding: 8rpx 0; }
.theme-swatch { width: 56rpx; height: 56rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15); }
.theme-check { color: #fff; font-size: 28rpx; font-weight: 600; }
.theme-name { font-size: 28rpx; color: var(--text); }
.theme-selected .theme-name { font-weight: 600; color: var(--primary); }

.row-label { font-size: 26rpx; color: var(--text-secondary); margin-bottom: 16rpx; }
.mode-row { display: flex; gap: 20rpx; }
.mode-chip { flex: 1; text-align: center; padding: 18rpx 0; font-size: 28rpx; border-radius: 40rpx; background: var(--bg); color: var(--text-secondary); border: 1rpx solid var(--divider); }
.mode-on { background: var(--primary); color: #fff; border-color: var(--primary); font-weight: 600; }

.action-card { display: flex; align-items: center; }
.action-icon { font-size: 36rpx; margin-right: 20rpx; }
.action-text { flex: 1; font-size: 28rpx; color: var(--text); }
.action-card.danger .action-text { color: var(--danger); }
.action-arrow { font-size: 36rpx; color: var(--text-secondary); }

.about-card { padding: 8rpx 28rpx; }
.about-row { display: flex; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid var(--divider); font-size: 28rpx; color: var(--text); }
.about-row:last-child { border-bottom: none; }
.about-row text:last-child { color: var(--text-secondary); }