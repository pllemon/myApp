/* 主题卡片 */
.theme-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.theme-item {
  display: flex; align-items: center; gap: 12rpx; padding: 16rpx;
  border-radius: 20rpx; background: var(--surface-2); border: 2rpx solid transparent;
}
.theme-item.theme-selected { border-color: var(--primary); background: var(--primary-light); }
.theme-preview { display: flex; align-items: center; margin-right: 4rpx; }
.theme-dot { width: 20rpx; height: 20rpx; border-radius: 50%; margin-right: -6rpx; border: 2rpx solid var(--surface); }
.theme-dot:first-child { width: 26rpx; height: 26rpx; z-index: 2; }
.theme-meta { flex: 1; min-width: 0; }
.theme-name { font-size: 26rpx; color: var(--text); }
.theme-item.theme-selected .theme-name { font-weight: 600; color: var(--primary-dark); }
.theme-current { font-size: 20rpx; color: var(--primary-dark); margin-top: 2rpx; }

/* 存储模式切换 */
.mode-row { gap: 16rpx; padding-top: 4rpx; }
.mode-chip { display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.mode-chip.mode-on { background: var(--primary); color: var(--text-inverse); border-color: var(--primary); font-weight: 600; }

/* 行入口 */
.setting-icon { background: var(--surface-2); }
.setting-action:active { opacity: .68; }
.setting-danger .m2-row-title { color: var(--danger); }
.setting-danger .setting-icon { background: var(--danger-light); }
