.preview-hint {
  font-size: 22rpx;
  color: var(--text-3);
  margin: 8rpx 0 16rpx;
}

/* 5 格预览条：拖拽只在这里发生 */
.preview-bar {
  display: flex;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: 20rpx;
  padding: 10rpx 0;
  overflow: hidden;
}
.preview-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 12rpx 0 8rpx;
  border-radius: 16rpx;
  position: relative;
  transition: opacity .16s var(--ease), transform .16s var(--ease);
}
.preview-item.fixed { opacity: .88; }
.preview-item.dragging {
  opacity: .55;
  transform: scale(1.06);
  background: var(--surface-2);
  box-shadow: var(--shadow);
  z-index: 2;
}
.preview-grip {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  color: var(--text-3);
}
.preview-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.preview-label {
  font-size: 20rpx;
  color: var(--text-2);
  white-space: nowrap;
}
.preview-item.dragging .preview-label { color: var(--primary-dark); font-weight: 600; }

/* 14 模块候选池 */
.module-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-top: 8rpx;
}
.module-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 4rpx 12rpx;
  border-radius: 18rpx;
  background: var(--surface-2);
  border: 2rpx solid transparent;
  transition: all .16s var(--ease);
}
.module-card.selected {
  background: var(--primary-light);
  border-color: var(--primary);
}
.module-card.fixed { opacity: .86; }
.module-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.module-name {
  font-size: 22rpx;
  color: var(--text);
  margin-top: 6rpx;
  white-space: nowrap;
}
.module-card.selected .module-name {
  color: var(--primary-dark);
  font-weight: 600;
}
.module-state {
  font-size: 18rpx;
  color: var(--text-3);
  margin-top: 2rpx;
}
.module-card.selected .module-state { color: var(--primary-dark); }

/* 首页「更多」自动结果 */
.more-desc {
  font-size: 22rpx;
  color: var(--text-3);
  margin: 8rpx 0 14rpx;
}
.more-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.more-tag {
  font-size: 22rpx;
  color: var(--text-2);
  background: var(--surface-2);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}
