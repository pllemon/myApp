.page {
  padding: 24rpx;
  padding-bottom: 180rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.section-desc {
  font-size: 22rpx;
  color: #999;
  font-weight: normal;
  margin-left: 12rpx;
}

.list {
  margin-top: 8rpx;
}

.tabbar-item {
  display: flex;
  align-items: center;
  padding: 24rpx 12rpx;
  border-radius: 12rpx;
  background: #FAFBFC;
  margin-bottom: 8rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.tabbar-item.selected {
  background: #F0F7FF;
  border-color: rgba(24, 144, 255, 0.15);
}

.tabbar-item.dragging {
  opacity: 0.5;
  transform: scale(0.98);
}

.tabbar-item.fixed {
  background: #F5F6F8;
  border-color: #eee;
  opacity: 0.75;
}

.drag-handle {
  width: 48rpx;
  font-size: 28rpx;
  color: #ccc;
  text-align: center;
  padding: 0 4rpx;
  line-height: 1;
}

.drag-handle-placeholder {
  width: 48rpx;
}

.item-icon {
  font-size: 44rpx;
  width: 64rpx;
  text-align: center;
}

.item-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #F0F0F0;
  color: #999;
  margin-right: 16rpx;
}

.check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #d9d9d9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  transition: all 0.2s;
  flex-shrink: 0;
}

.check.checked {
  background: #1890ff;
  border-color: #1890ff;
}

.check.disabled {
  background: #d9d9d9 !important;
  border-color: #d9d9d9 !important;
  color: #fff;
}

.shortcut-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.shortcut-item {
  width: calc((100% - 36rpx) / 4);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 8rpx;
  border-radius: 12rpx;
  background: #FAFBFC;
  border: 2rpx solid transparent;
  transition: all 0.2s;
  position: relative;
}

.shortcut-item.selected {
  background: #F0F7FF;
  border-color: rgba(24, 144, 255, 0.15);
}

.shortcut-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.shortcut-text {
  font-size: 24rpx;
  color: #555;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shortcut-item .check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 36rpx;
  height: 36rpx;
  font-size: 20rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-reset {
  background: #F5F6F8;
  color: #666;
}

.btn-save {
  background: #1890ff;
  color: #fff;
}