.progress-header { background: var(--bg-card); border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.progress-title { font-size: 30rpx; font-weight: 600; color: var(--text); margin-bottom: 16rpx; }
.progress-bar { height: 14rpx; background: var(--divider); border-radius: 7rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%); border-radius: 7rpx; transition: width 0.4s; }

.badge-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.badge-card { background: var(--bg-card); border-radius: 16rpx; padding: 28rpx 20rpx; display: flex; flex-direction: column; align-items: center; text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); border: 2rpx solid transparent; }
.badge-unlocked { border-color: var(--primary); box-shadow: 0 4rpx 16rpx rgba(74,144,217,0.15); }
.badge-locked { opacity: 0.55; }
.badge-icon { font-size: 64rpx; margin-bottom: 12rpx; }
.badge-title { font-size: 28rpx; font-weight: 600; color: var(--text); }
.badge-desc { font-size: 22rpx; color: var(--text-secondary); margin-top: 6rpx; }
.badge-progress-track { width: 100%; height: 10rpx; background: var(--divider); border-radius: 5rpx; margin-top: 16rpx; overflow: hidden; }
.badge-progress-fill { height: 100%; background: var(--primary); border-radius: 5rpx; }
.badge-progress-text { font-size: 20rpx; color: var(--text-secondary); margin-top: 8rpx; }