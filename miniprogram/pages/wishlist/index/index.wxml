<view class="m2-page with-tabbar" style="{{themeStyle}}">
  <!-- 愿望概览 Hero -->
  <view class="m2-hero">
    <view class="m2-hero-head">
      <view>
        <view class="m2-hero-title">我的愿望清单</view>
        <view class="m2-hero-sub">把想要的生活，一件件变成现实</view>
      </view>
    </view>
    <view class="m2-hero-value">{{summary.achieved}}<text class="m2-hero-unit">/{{summary.total}}</text></view>
    <view class="m2-hero-note">已实现愿望</view>
    <view class="hero-progress">
      <view class="hero-progress-fill" style="width: {{summary.rate}}%;"></view>
    </view>
    <view class="m2-hero-stats">
      <view class="m2-hero-stat">
        <view class="m2-hero-stat-value">{{summary.active}}</view>
        <view class="m2-hero-stat-label">进行中</view>
      </view>
      <view class="m2-hero-stat">
        <view class="m2-hero-stat-value">{{summary.rate}}<text class="m2-hero-unit">%</text></view>
        <view class="m2-hero-stat-label">完成率</view>
      </view>
    </view>
  </view>

  <!-- 分段筛选 -->
  <view class="m2-segment">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="m2-seg-item {{activeFilter === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchFilter"
    >{{item.label}}</view>
  </view>

  <!-- 空态 -->
  <m-empty
    wx:if="{{showEmpty}}"
    title="暂无愿望"
    desc="点击右下角 + 许个愿吧"
    action="去添加"
    bindaction="goNew"
  />

  <!-- 愿望列表 -->
  <view wx:else class="m2-list">
    <view
      wx:for="{{list}}"
      wx:key="_id"
      class="m2-row {{item.achieved ? 'done' : ''}}"
      data-id="{{item._id}}"
      bindtap="goDetail"
    >
      <view
        class="wish-check {{item.achieved ? 'wish-check-done' : ''}}"
        data-id="{{item._id}}"
        catchtap="toggleAchieved"
      >
        <m-icon wx:if="{{item.achieved}}" name="check" size="28" />
      </view>
      <view class="m2-row-icon wish-row-icon" style="{{item.images && item.images.length > 0 ? '' : 'background:' + item.categoryTile + ';color:' + item.categoryColor}}">
        <image wx:if="{{item.images && item.images.length > 0}}" class="wish-icon-img" src="{{item.images[0]}}" mode="aspectFill" />
        <m-icon wx:else value="{{item.icon || item.categoryIcon}}" size="36" />
      </view>
      <view class="m2-row-body">
        <view class="m2-row-title">{{item.title}}</view>
        <view class="wish-meta">
          <view class="wish-tag" style="color:{{item.categoryColor}};background:{{item.categorySoft}}">{{item.categoryLabel}}</view>
          <text wx:if="{{item.budget}}" class="wish-budget">预算 ¥{{item.budget}}</text>
          <text wx:if="{{item.dueLabel}}" class="wish-due {{item.overdue ? 'wish-overdue' : ''}}"><m-icon name="clock" size="24" inline /> {{item.dueLabel}}</text>
        </view>
        <view class="wish-progress">
          <view class="m-progress-bar wish-progress-track">
            <view class="m-progress-fill wish-progress-fill" style="width:{{item.progress}}%;background:{{item.achieved ? 'var(--success)' : item.categoryColor}}"></view>
          </view>
          <text class="wish-progress-text">{{item.progress}}%</text>
        </view>
      </view>
    </view>
  </view>

  <view class="m2-fab" bindtap="goNew"><m-icon name="add" size="44" inline /></view>
</view>
<m-tab-bar id="tabbar" />
