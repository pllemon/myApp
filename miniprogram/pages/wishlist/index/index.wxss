/* 愿望列表独有：Hero 进度条 / 勾选圈 / 分类标签与进度（segment、列表、空态、FAB 走 m2-* 全局类） */
.hero-progress { position: relative; z-index: 1; height: 14rpx; border-radius: var(--radius-full); background: var(--surface-3); overflow: hidden; margin-top: 24rpx; opacity: .6; }
.hero-progress-fill { height: 100%; border-radius: var(--radius-full); background: var(--text-inverse); transition: width .4s var(--ease); }

.wish-check { width: 44rpx; height: 44rpx; border-radius: 50%; border: 3rpx solid var(--primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-sizing: border-box; }
.wish-check-done { background: var(--success); border-color: var(--success); color: var(--text-inverse); }
.wish-row-icon { width: 72rpx; height: 72rpx; border-radius: 18rpx; }
.wish-icon-img { width: 100%; height: 100%; border-radius: 18rpx; }

.wish-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; margin-top: 10rpx; }
.wish-tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: var(--radius-full); }
.wish-budget { font-size: 22rpx; color: var(--text-3); }
.wish-due { font-size: 22rpx; color: var(--text-3); }
.wish-overdue { color: var(--danger); font-weight: 500; }
.wish-progress { display: flex; align-items: center; margin-top: 12rpx; }
.wish-progress-track { flex: 1; height: 8rpx; background: var(--border); }
.wish-progress-text { font-size: 22rpx; color: var(--text-3); margin-left: 12rpx; flex-shrink: 0; }
