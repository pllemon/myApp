.wish-summary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: #FFFFFF;
}
.wish-summary-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.wish-summary-num {
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.2;
}
.wish-summary-total {
  font-size: 32rpx;
  font-weight: 400;
  opacity: 0.8;
}
.wish-summary-label {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}
.wish-summary-progress {
  margin-top: 24rpx;
}
.wish-summary-progress .m-progress-bar {
  background: rgba(255, 255, 255, 0.25);
}
.wish-summary-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 12rpx;
}

.wish-list { padding-bottom: 180rpx; }
.wish-card {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.wish-done .wish-title {
  text-decoration: line-through;
  color: var(--text-secondary);
}
.wish-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}
.wish-check-done {
  background: var(--success);
  border-color: var(--success);
}
.wish-check-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
.wish-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: #F0F0F0;
}
.wish-icon-img {
  width: 100%;
  height: 100%;
}
.wish-body { flex: 1; min-width: 0; }
.wish-title {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
  word-break: break-all;
}
.wish-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  flex-wrap: wrap;
}
.wish-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}
.wish-budget {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-right: 16rpx;
}
.wish-due {
  font-size: 22rpx;
  color: var(--text-secondary);
}
.wish-overdue { color: var(--danger); font-weight: 500; }
.wish-progress {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}
.wish-progress-track {
  flex: 1;
  height: 8rpx;
  background: var(--divider);
}
.wish-progress-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-left: 12rpx;
  flex-shrink: 0;
}