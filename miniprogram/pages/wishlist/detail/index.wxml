<view class="m2-page" wx:if="{{item}}" style="{{themeStyle}}">
  <!-- 详情 Hero -->
  <view class="m2-detail-hero">
    <image wx:if="{{item.images && item.images.length > 0}}" class="m2-detail-hero-img" src="{{item.images[0]}}" mode="aspectFill" data-index="0" bindtap="previewImage" />
    <view wx:else class="m2-detail-icon" style="background:{{item.categoryTile}};color:{{item.categoryColor}}"><m-icon value="{{item.icon || item.categoryIcon}}" size="56" /></view>
    <view class="m2-detail-main">
      <view class="m2-detail-title">{{item.title}}</view>
      <view wx:if="{{item.dueLabel}}" class="m2-detail-sub">目标日期 · {{item.dueLabel}}</view>
      <view class="m2-badge-row">
        <view wx:if="{{item.achieved}}" class="m2-badge m2-badge-success"><m-icon name="check" size="26" inline />已实现</view>
        <view wx:else class="m2-badge" style="color:{{item.categoryColor}};background:{{item.categorySoft}}">{{item.categoryLabel}}</view>
      </view>
    </view>
  </view>

  <!-- 心愿进度 -->
  <view class="m2-card">
    <view class="m2-card-head"><view class="m2-card-title">心愿进度</view></view>
    <view class="m2-detail-row">
      <view class="m2-detail-label">完成度</view>
      <view class="m2-detail-value">{{item.progress}}%</view>
    </view>
    <view class="m2-detail-progress">
      <view class="m2-detail-progress-fill" style="width:{{item.progress}}%;background:{{item.categoryColor}}"></view>
    </view>
  </view>

  <!-- 心愿信息 -->
  <view class="m2-card">
    <view class="m2-card-head"><view class="m2-card-title">心愿信息</view></view>
    <view class="m2-detail-row">
      <view class="m2-detail-label">分类</view>
      <view class="m2-detail-value">{{item.categoryLabel}}</view>
    </view>
    <view class="m2-detail-row">
      <view class="m2-detail-label">预算</view>
      <view class="m2-detail-value">{{item.budgetText || '未设置'}}</view>
    </view>
    <view class="m2-detail-row">
      <view class="m2-detail-label">目标日期</view>
      <view class="m2-detail-value">{{item.targetDate || '未设置'}}</view>
    </view>
    <view wx:if="{{item.achievedAt}}" class="m2-detail-row">
      <view class="m2-detail-label">实现时间</view>
      <view class="m2-detail-value">{{item.achievedAtLabel || '已实现'}}</view>
    </view>
  </view>

  <!-- 备注 -->
  <view wx:if="{{item.note}}" class="m2-card">
    <view class="m2-card-head"><view class="m2-card-title">备注</view></view>
    <view class="m2-note">{{item.note}}</view>
  </view>

  <!-- 图片 -->
  <view wx:if="{{item.images && item.images.length > 0}}" class="m2-card">
    <view class="m2-card-head"><view class="m2-card-title">图片</view></view>
    <view class="m2-detail-images">
      <image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" class="m2-detail-image" src="{{img}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage" />
    </view>
  </view>

  <!-- 时间信息 -->
  <view class="m2-card">
    <view class="m2-detail-row">
      <view class="m2-detail-label">创建时间</view>
      <view class="m2-detail-value">{{createdAtLabel || '—'}}</view>
    </view>
    <view wx:if="{{updatedAtLabel}}" class="m2-detail-row">
      <view class="m2-detail-label">最近编辑</view>
      <view class="m2-detail-value">{{updatedAtLabel}}</view>
    </view>
  </view>

  <view class="m2-footer">
    <view class="m2-btn m2-btn-ghost" bindtap="quickAction">{{quickLabel}}</view>
    <view class="m2-btn m2-btn-primary" bindtap="goEdit"><m-icon name="edit" size="28" inline /> 编辑</view>
    <view class="m2-btn m2-btn-danger" bindtap="deleteItem"><m-icon name="trash" size="28" inline /> 删除</view>
  </view>
</view>
