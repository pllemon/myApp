/* 愿望编辑独有：预算输入行 / 清除按钮（字段、chip、底部按钮走 m2-* 全局类） */
.m2-field > m-icon-picker { flex: 1; min-width: 0; }
.budget-row { display: flex; align-items: center; flex: 1; }
.budget-prefix { font-size: 32rpx; color: var(--text); font-weight: 600; margin-right: 12rpx; }
.date-clear { font-size: 24rpx; color: var(--danger); padding: 8rpx 16rpx; }
.m2-field slider { flex: 1; }
