<view class="m2-page m2-edit" style="{{themeStyle}}">
  <!-- 编辑 Hero -->
  <view class="m2-edit-hero">
    <view class="m2-edit-hero-icon" style="background: var(--primary-light)"><m-icon name="gift" size="48" tone="category" /></view>
    <view>
      <view class="m2-edit-title">{{isEdit ? '编辑愿望' : '新建愿望'}}</view>
      <view class="m2-edit-desc">写下心愿，一步步把它变成现实</view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">心愿信息</view>
    <view class="m2-field">
      <view class="m2-field-label">愿望</view>
      <input class="m2-field-value" placeholder="例如：去日本看樱花" value="{{title}}" maxlength="40" bindinput="onTitleInput" focus="{{!isEdit}}" />
    </view>
    <view class="m2-field">
      <view class="m2-field-label">分类</view>
      <view class="m2-chip-row">
        <view
          wx:for="{{categoryOptions}}"
          wx:key="key"
          class="m2-chip {{category === item.key ? 'active' : ''}}"
          style="{{category === item.key ? 'color:' + item.color + ';border-color:' + item.color + ';background:' + item.soft : ''}}"
          data-key="{{item.key}}"
          bindtap="selectCategory"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="m2-field">
      <view class="m2-field-label">图标</view>
      <m-icon-picker icons="{{icons}}" value="{{icon}}" bind:select="selectIcon" />
    </view>
    <view class="m2-field">
      <view class="m2-field-label">目标日期</view>
      <picker mode="date" value="{{targetDate}}" start="{{today}}" bindchange="onDateChange">
        <view class="m2-field-value {{targetDate ? '' : 'placeholder'}}">{{targetDate || '选填'}}</view>
      </picker>
      <view wx:if="{{targetDate}}" class="date-clear" catchtap="clearDate"><m-icon name="close" size="24" inline /> 清除</view>
    </view>
    <view class="m2-field">
      <view class="m2-field-label">预算</view>
      <view class="budget-row">
        <text class="budget-prefix">¥</text>
        <input class="m2-field-value" type="digit" placeholder="例如：10000" value="{{budget}}" bindinput="onBudgetInput" />
      </view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">心愿进度 · {{progressDisplay}}%</view>
    <view class="m2-field">
      <view class="m2-field-label">完成进度</view>
      <slider min="0" max="100" step="5" value="{{progressDisplay}}" activeColor="var(--primary)" disabled="{{achieved}}" bindchange="onProgressChange" />
    </view>
    <view class="m2-field">
      <view class="m2-field-label">已实现</view>
      <switch checked="{{achieved}}" color="var(--success)" bindchange="toggleAchieved" />
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">备注</view>
    <textarea class="m2-field-value" placeholder="补充说明（可选）" value="{{note}}" maxlength="200" bindinput="onNoteInput" auto-height />
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">愿望图片</view>
    <m-image-picker images="{{images}}" bind:change="onImagesChange" />
  </view>

  <view class="m2-footer">
    <view class="m2-btn m2-btn-primary" bindtap="save">保存</view>
    <view wx:if="{{isEdit}}" class="m2-btn m2-btn-danger" bindtap="remove">删除</view>
  </view>
</view>
