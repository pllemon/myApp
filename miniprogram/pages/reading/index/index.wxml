<view class="m2-page with-tabbar" style="{{themeStyle}}">
  <!-- 阅读概览 Hero -->
  <view class="m2-hero">
    <view class="m2-hero-head">
      <view>
        <view class="m2-hero-title">我的书架</view>
        <view class="m2-hero-sub">一页一页，读出更辽阔的世界</view>
      </view>
    </view>
    <view class="m2-hero-stats">
      <view class="m2-hero-stat" wx:for="{{summaryItems}}" wx:key="label">
        <view class="m2-hero-stat-value">{{item.value}}<text wx:if="{{item.total}}" class="m2-hero-unit">/{{item.total}}</text></view>
        <view class="m2-hero-stat-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 分段筛选 -->
  <view class="m2-segment">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="m2-seg-item {{activeFilter === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchFilter"
    >{{item.label}}</view>
  </view>

  <!-- 空态 -->
  <m-empty
    wx:if="{{showEmpty}}"
    title="暂无书籍"
    desc="点击右下角 + 添加你的书架"
    action="去添加"
    bindaction="goNew"
  />

  <!-- 书籍列表（封面图） -->
  <view wx:else class="m2-list">
    <view
      wx:for="{{list}}"
      wx:key="_id"
      class="m2-row reading-card"
      data-id="{{item._id}}"
      bindtap="goDetail"
    >
      <view class="book-cover" style="{{item.images && item.images.length > 0 ? '' : 'background:' + item.categoryTile + ';color:' + item.categoryColor}}">
        <image wx:if="{{item.images && item.images.length > 0}}" class="cover-img" src="{{item.images[0]}}" mode="aspectFill" />
        <view wx:else class="cover-emoji"><m-icon value="{{item.categoryIcon}}" size="56" color="{{item.categoryColor}}" /></view>
      </view>
      <view class="m2-row-body">
        <view class="m2-row-title reading-title">{{item.title}}</view>
        <view class="reading-meta">
          <text wx:if="{{item.author}}" class="reading-author">{{item.author}}</text>
          <text wx:if="{{item.author && item.publisher}}" class="reading-sep">·</text>
          <text wx:if="{{item.publisher}}" class="reading-publisher">{{item.publisher}}</text>
        </view>
        <view class="reading-tags">
          <view class="reading-tag" style="color:{{item.categoryColor}};background:{{item.categorySoft}}">{{item.categoryLabel}}</view>
          <view class="reading-tag reading-status" style="color:{{item.statusColor}};background:{{item.statusSoft}}"
            data-id="{{item._id}}" catchtap="toggleStatus"><m-icon name="{{item.status === 'finished' ? 'checkCircle' : (item.status === 'reading' ? 'playCircle' : 'bookmark')}}" tone="system" size="24" inline /> {{item.statusLabel}}</view>
        </view>

        <view wx:if="{{item.status !== 'plan'}}" class="reading-progress-row">
          <view class="m-progress-bar reading-progress-track">
            <view class="m-progress-fill reading-progress-fill" style="width:{{item.progress}}%;background:{{item.status === 'finished' ? 'var(--success)' : item.categoryColor}}"></view>
          </view>
          <text class="reading-progress-text">{{item.progress}}%</text>
        </view>

        <view wx:if="{{item.status === 'finished'}}" class="reading-rating">
          <view class="stars">
            <view wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:key="*this" class="star-wrap {{s <= item.rating ? 'star-on' : ''}}">
              <m-icon name="star" size="32" tone="system" />
            </view>
          </view>
          <text wx:if="{{item.finishDate}}" class="reading-date">读完于 {{item.finishDate}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="m2-fab" bindtap="goNew"><m-icon name="add" size="44" inline /></view>
</view>
<m-tab-bar id="tabbar" />
