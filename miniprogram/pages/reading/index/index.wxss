/* 阅读列表独有：封面 / 元信息标签 / 进度条 / 星级（segment、列表、空态、FAB 走 m2-* 全局类） */
.reading-card { align-items: flex-start; }
.book-cover { width: 110rpx; height: 160rpx; border-radius: 10rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 24rpx; overflow: hidden; background: var(--surface-3); }
.cover-img { width: 100%; height: 100%; }
.cover-emoji { display: flex; align-items: center; justify-content: center; }
.reading-title { font-size: 30rpx; font-weight: 600; word-break: break-all; }
.reading-meta { font-size: 24rpx; color: var(--text-3); margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.reading-sep { margin: 0 8rpx; }
.reading-tags { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; margin-top: 10rpx; }
.reading-tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: var(--radius-full); }
.reading-progress-row { display: flex; align-items: center; margin-top: 12rpx; }
.reading-progress-track { flex: 1; height: 8rpx; background: var(--border); border-radius: var(--radius-full); overflow: hidden; }
.reading-progress-text { font-size: 22rpx; color: var(--text-3); margin-left: 12rpx; flex-shrink: 0; }
.reading-rating { display: flex; align-items: center; justify-content: space-between; margin-top: 10rpx; }
.stars { display: flex; gap: 4rpx; }
.star-wrap { opacity: .3; }
.star-wrap.star-on { opacity: 1; }
.reading-date { font-size: 22rpx; color: var(--text-3); }
