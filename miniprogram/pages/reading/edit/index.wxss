.m-form-label:first-child { margin-top: 0; }




.chip {
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  border-radius: 40rpx;
  border: 2rpx solid var(--divider);
  color: var(--text-secondary);
  background: var(--bg-card);
}

.date-row-inline {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.date-inline {
  font-size: 28rpx;
  color: var(--text);
}
.date-clear-inline {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-left: 12rpx;
}

.m-rating-star.star-on { color: #F5A623; }
