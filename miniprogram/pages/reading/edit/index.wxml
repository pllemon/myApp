<view class="m2-page m2-edit" style="{{themeStyle}}">
  <!-- 编辑 Hero -->
  <view class="m2-edit-hero">
    <view class="m2-edit-hero-icon" style="background: var(--primary-light)"><m-icon name="book" size="48" /></view>
    <view>
      <view class="m2-edit-title">{{isEdit ? '编辑书籍' : '添加书籍'}}</view>
      <view class="m2-edit-desc">记录书名与阅读进度，留住每一次翻页</view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">封面 / 插图</view>
    <m-image-picker images="{{images}}" bind:change="onImagesChange" />
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">书籍信息</view>
    <view class="m2-field">
      <view class="m2-field-label">书名</view>
      <input class="m2-field-value" placeholder="例如：人类简史" value="{{title}}" maxlength="60" bindinput="onTitleInput" focus="{{!isEdit}}" />
    </view>
    <view class="m2-field">
      <view class="m2-field-label">分类</view>
      <view class="m2-chip-row">
        <view
          wx:for="{{categoryOptions}}"
          wx:key="key"
          class="m2-chip {{category === item.key ? 'active' : ''}}"
          style="{{category === item.key ? 'color:' + item.color + ';border-color:' + item.color + ';background:' + item.soft : ''}}"
          data-key="{{item.key}}"
          bindtap="selectCategory"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="m2-field">
      <view class="m2-field-label">阅读状态</view>
      <view class="m2-chip-row">
        <view
          wx:for="{{statusOptions}}"
          wx:key="key"
          class="m2-chip {{status === item.key ? 'active' : ''}}"
          style="{{status === item.key ? 'color:' + item.color + ';border-color:' + item.color + ';background:' + item.soft : ''}}"
          data-key="{{item.key}}"
          bindtap="selectStatus"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="m2-field">
      <view class="m2-field-label">作者</view>
      <input class="m2-field-value" placeholder="可选" value="{{author}}" maxlength="30" bindinput="onAuthorInput" />
    </view>
    <view class="m2-field">
      <view class="m2-field-label">出版社</view>
      <input class="m2-field-value" placeholder="可选" value="{{publisher}}" maxlength="30" bindinput="onPublisherInput" />
    </view>
  </view>

  <view class="m2-form-card" wx:if="{{status !== 'plan'}}">
    <view class="m2-form-title">阅读时间</view>
    <view class="field-row">
      <view class="m2-field">
        <view class="m2-field-label">开始日期</view>
        <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
          <view class="m2-field-value {{startDate ? '' : 'placeholder'}}">{{startDate || '选填'}}</view>
        </picker>
        <view wx:if="{{startDate}}" class="date-clear" catchtap="clearStartDate"><m-icon name="close" size="24" inline /> 清除</view>
      </view>
      <view wx:if="{{status === 'finished'}}" class="m2-field">
        <view class="m2-field-label">完成日期</view>
        <picker mode="date" value="{{finishDate}}" bindchange="onFinishDateChange">
          <view class="m2-field-value {{finishDate ? '' : 'placeholder'}}">{{finishDate || '今天'}}</view>
        </picker>
        <view wx:if="{{finishDate}}" class="date-clear" catchtap="clearFinishDate"><m-icon name="close" size="24" inline /> 清除</view>
      </view>
    </view>
  </view>

  <view class="m2-form-card" wx:if="{{status === 'reading'}}">
    <view class="m2-form-title">阅读进度</view>
    <view class="field-row">
      <view class="m2-field">
        <view class="m2-field-label">总页数</view>
        <input class="m2-field-value" type="number" placeholder="可选" value="{{totalPages}}" maxlength="5" bindinput="onTotalPagesInput" />
      </view>
      <view class="m2-field">
        <view class="m2-field-label">当前页</view>
        <input class="m2-field-value" type="number" placeholder="可选" value="{{currentPage}}" maxlength="5" bindinput="onCurrentPageInput" />
      </view>
    </view>
  </view>

  <view class="m2-form-card" wx:if="{{showProgressSlider}}">
    <view class="m2-form-title">进度 · {{progress}}%</view>
    <view class="m2-field">
      <view class="m2-field-label">完成度</view>
      <slider min="0" max="100" step="5" value="{{progress}}" activeColor="var(--primary)" bindchange="onProgressChange" />
    </view>
  </view>

  <view class="m2-form-card" wx:if="{{status === 'finished'}}">
    <view class="m2-form-title">评分 · {{rating > 0 ? rating + ' / 5' : '未评分'}}</view>
    <view class="m2-field">
      <view class="m2-field-label">我的评分</view>
      <view class="rating-row">
        <view
          wx:for="{{stars}}"
          wx:key="*this"
          class="star-wrap {{item <= rating ? 'star-on' : ''}}"
          data-r="{{item}}"
          bindtap="selectRating"
        ><m-icon name="star" size="44" tone="system" /></view>
        <text wx:if="{{rating > 0}}" class="rating-num">{{rating}} / 5</text>
      </view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">笔记 / 感想</view>
    <textarea class="m2-field-value" placeholder="记录你的阅读笔记（可选）" value="{{note}}" maxlength="500" bindinput="onNoteInput" auto-height />
  </view>

  <view class="m2-footer">
    <view class="m2-btn m2-btn-primary" bindtap="save">保存</view>
    <view wx:if="{{isEdit}}" class="m2-btn m2-btn-danger" bindtap="remove">删除</view>
  </view>
</view>
