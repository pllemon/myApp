<view class="m2-page" style="{{themeStyle}}">
  <view class="m2-segment">
    <view
      class="m2-seg-item {{viewType === 'month' ? 'active' : ''}}"
      data-view="month"
      bindtap="onSwitchView"
    >月视图</view>
    <view
      class="m2-seg-item {{viewType === 'year' ? 'active' : ''}}"
      data-view="year"
      bindtap="onSwitchView"
    >年度热力图</view>
  </view>

  <view wx:if="{{!habitId && habits.length > 0}}" class="m2-card">
    <view class="m2-card-head"><view class="m2-card-title">选择习惯</view></view>
    <view class="picker-title">选择习惯后可点日期补签</view>
    <view class="m2-chip-row">
      <view
        class="m2-chip"
        wx:for="{{habits}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="selectHabit"
      ><m-icon value="{{item.icon}}" size="28" inline /> {{item.name}}</view>
    </view>
  </view>

  <view wx:if="{{habitName}}" class="m2-badge habit-badge" style="background-color: {{habitColor}}20; color: {{habitColor}};">
    <m-icon name="target" size="28" tone="category" inline /> {{habitName}}
  </view>

  <view wx:if="{{viewType === 'month'}}">
    <view class="month-header">
      <view class="nav-btn" bindtap="prevMonth"><m-icon name="chevronRight" size="36" class="cal-prev" /></view>
      <view class="month-label">{{monthLabel}}</view>
      <view class="nav-btn" bindtap="nextMonth"><m-icon name="chevronRight" size="36" /></view>
    </view>

    <view class="month-grid">
      <view wx:for="{{weekdayLabels}}" wx:key="*this" class="weekday">{{item}}</view>
      <view
        wx:for="{{cells}}"
        wx:key="*this"
        class="day-cell {{item.empty ? 'empty' : ''}} {{item.checked ? 'checked' : ''}} {{item.isToday ? 'today' : ''}} {{item.isFuture ? 'future' : ''}}"
        style="{{item.checked ? 'background-color: ' + habitColor + ';' : ''}}"
        data-date="{{item.date}}"
        bindtap="toggleDay"
      >
        <text wx:if="{{!item.empty && item.day}}">{{item.day}}</text>
        <m-icon wx:if="{{item.checked}}" name="check" size="24" color="#FFFFFF" class="day-check" />
      </view>
    </view>

    <view class="m2-card month-stats">
      <view class="m2-stat-grid">
        <view class="m2-stat-cell">
          <view class="m2-stat-num">{{monthStats.checkedDays}}</view>
          <view class="m2-stat-label">本月已打卡</view>
        </view>
        <view class="m2-stat-cell">
          <view class="m2-stat-num">{{monthStats.recordsCount}}</view>
          <view class="m2-stat-label">累计打卡次数</view>
        </view>
        <view class="m2-stat-cell">
          <view class="m2-stat-num">{{monthStats.totalDays}}</view>
          <view class="m2-stat-label">本月天数</view>
        </view>
      </view>
    </view>

    <view class="calendar-tip" wx:if="{{habitId}}">
      <m-icon name="idea" size="28" tone="category" inline />点击今天或之前的日期可以补签
    </view>
  </view>

  <view wx:if="{{viewType === 'year'}}">
    <view wx:if="{{yearStats}}" class="m2-hero year-summary">
      <view class="m2-hero-head">
        <view>
          <view class="m2-hero-title">{{yearStats.year}} 年度回顾</view>
          <view class="m2-hero-sub">每一次坚持都算数</view>
        </view>
      </view>
      <view class="m2-hero-stats">
        <view class="m2-hero-stat">
          <view class="m2-hero-stat-value">{{yearStats.activeDays}}</view>
          <view class="m2-hero-stat-label">活跃天数</view>
        </view>
        <view class="m2-hero-stat">
          <view class="m2-hero-stat-value">{{yearStats.totalCount}}</view>
          <view class="m2-hero-stat-label">总打卡次数</view>
        </view>
      </view>
      <view class="m2-hero-note"><m-icon name="trophy" size="26" inline /> {{yearStats.bestMonth}}</view>
    </view>

    <view class="m2-card heatmap-section">
      <view class="m2-card-head"><view class="m2-card-title">{{habitName || '全部习惯'}} 年度热力图</view></view>
      <view class="heatmap-body">
        <view class="hm-row" wx:for="{{heatmap}}" wx:for-item="month" wx:key="label">
          <view class="hm-month-label">{{month.label}}</view>
          <view class="hm-cells">
            <view
              wx:for="{{month.cells}}"
              wx:for-item="cell"
              wx:key="day"
              class="hm-cell {{cell && cell.count > 0 ? 'active' : ''}} {{!cell ? 'empty' : ''}}"
              style="{{cell && cell.count > 0 ? 'background-color: ' + (cell.count >= 4 ? habitColor : cell.count >= 2 ? habitColor + '80' : habitColor + '40') : ''}}"
              data-date="{{cell ? cell.date : ''}}"
              bindtap="onHeatmapDay"
            ></view>
          </view>
        </view>
      </view>
      <view class="heatmap-legend">
        <text class="legend-label">少</text>
        <view class="legend-cells">
          <view class="lg-cell" style="background-color: var(--surface-3);"></view>
          <view class="lg-cell" style="background-color: {{habitColor}}40;"></view>
          <view class="lg-cell" style="background-color: {{habitColor}}80;"></view>
          <view class="lg-cell" style="background-color: {{habitColor}};"></view>
        </view>
        <text class="legend-label">多</text>
      </view>
    </view>
  </view>

  <m-modal
    show="{{showRecordDetail}}"
    title="{{selectedRecord.habitName || '打卡'}} · {{selectedRecord.date}}"
    bind:close="closeRecordDetail"
  >
    <view class="modal-body">
      <view class="m2-form-title">打卡图片</view>
      <m-image-picker images="{{selectedRecord.images}}" bind:change="onRecordImagesChange" />
      <m-empty wx:if="{{!selectedRecord.images || selectedRecord.images.length === 0}}" title="点下方添加按钮，记录这一天的照片" />
    </view>
    <view slot="footer" class="modal-footer">
      <button class="m2-btn m2-btn-danger" bindtap="uncheckinDay">取消此日打卡</button>
    </view>
  </m-modal>
</view>
