.view-tabs {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 50rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-radius: 44rpx;
  transition: all 0.2s ease;
}

.tab.active {
  background-color: var(--primary);
  color: #FFFFFF;
  font-weight: 600;
}

.habit-badge {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.month-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--primary);
  background-color: #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.month-label {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
}

.weekday-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  padding: 16rpx 0;
}

.weekday {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.month-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.day-cell {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text);
  border-radius: 12rpx;
  background-color: #FAFAFA;
  transition: all 0.15s ease;
}

.day-cell.empty {
  background-color: transparent;
}

.day-cell.checked {
  color: #FFFFFF;
  font-weight: 600;
}

.day-cell.today {
  border: 3rpx solid var(--primary);
  font-weight: 700;
}

.day-cell.today.checked {
  box-shadow: 0 0 0 4rpx rgba(74, 144, 217, 0.2);
}

.day-cell.future {
  color: #DDDDDD;
}

.month-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-top: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #EEEEEE;
}

.calendar-tip {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
}

.year-summary {
  background: linear-gradient(135deg, var(--primary-light) 0%, #FFFFFF 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.year-main {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.year-num {
  font-size: 80rpx;
  font-weight: 800;
  color: var(--primary);
}

.year-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-left: 12rpx;
}

.year-stats {
  display: flex;
  gap: 40rpx;
  margin-bottom: 20rpx;
}

.year-stat {
  display: flex;
  align-items: baseline;
}

.yr-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  margin-right: 8rpx;
}

.yr-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.best-month {
  font-size: 26rpx;
  color: var(--success);
  font-weight: 500;
}

.heatmap-section {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.heatmap-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.heatmap-body {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hm-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.hm-month-label {
  width: 48rpx;
  font-size: 20rpx;
  color: var(--text-secondary);
  text-align: right;
  flex-shrink: 0;
}

.hm-cells {
  flex: 1;
  display: flex;
  gap: 2rpx;
}

.hm-cell {
  flex: 1;
  aspect-ratio: 1;
  background-color: #F0F0F0;
  border-radius: 3rpx;
}

.hm-cell.empty {
  background-color: transparent;
}

.hm-cell.active {
  background-color: var(--primary);
}

.heatmap-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  margin-top: 16rpx;
}

.legend-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.legend-cells {
  display: flex;
  gap: 6rpx;
}

.lg-cell {
  width: 28rpx;
  height: 28rpx;
  border-radius: 4rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}
.modal-panel {
  width: 100%;
  max-height: 80vh;
  background: var(--bg, #fff);
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text, #333);
}
.modal-close {
  font-size: 48rpx;
  color: var(--text-secondary, #999);
  line-height: 1;
  padding: 0 8rpx;
}
.modal-body {
  padding: 0 32rpx;
  flex: 1;
  overflow-y: auto;
}
.modal-footer {
  padding: 24rpx 32rpx 48rpx;
}
.m-form-label {
  font-size: 26rpx;
  color: var(--text-secondary, #888);
  margin-bottom: 16rpx;
}
.btn-danger {
  background: #FFF0F0;
  color: #E74C3C;
  font-size: 28rpx;
  border-radius: 16rpx;
  padding: 20rpx 0;
  border: none;
}
.btn-danger::after { border: none; }