/* 打卡日历独有：月历 / 热力图 / 弹窗（segment、卡片、统计走 m2-* 全局类） */
.habit-badge { margin: 0 24rpx 20rpx; }
.cal-prev { transform: rotate(180deg); }

.month-header { display: flex; justify-content: space-between; align-items: center; margin: 0 24rpx 8rpx; }
.nav-btn { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--surface); box-shadow: var(--shadow-sm); }
.month-label { font-size: var(--font-xl); font-weight: 700; color: var(--text); }

.month-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx; margin: 0 24rpx 20rpx; padding: 20rpx; background: var(--surface); border-radius: 28rpx; box-shadow: var(--shadow-sm); }
.weekday { text-align: center; font-size: var(--font-sm); color: var(--text-3); padding-bottom: 8rpx; }
.day-cell { position: relative; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-size: var(--font-md); color: var(--text); border-radius: var(--radius-sm); background: var(--bg); }
.day-cell.empty { background: transparent; }
.day-cell.checked { color: var(--text-inverse); font-weight: 600; }
.day-cell.today { border: 3rpx solid var(--primary); font-weight: 700; }
.day-cell.today.checked { box-shadow: 0 0 0 4rpx var(--primary-light); }
.day-cell.future { color: var(--text-3); opacity: .55; }
.day-check { position: absolute; right: 4rpx; bottom: 2rpx; }

.month-stats { padding: 8rpx 20rpx; }
.calendar-tip { margin: 8rpx 24rpx 0; font-size: var(--font-md); color: var(--text-3); text-align: center; }

.year-summary { margin-bottom: 20rpx; }
.heatmap-body { display: flex; flex-direction: column; gap: 6rpx; }
.hm-row { display: flex; align-items: center; gap: 6rpx; }
.hm-month-label { width: 48rpx; font-size: var(--font-xs); color: var(--text-3); text-align: right; flex-shrink: 0; }
.hm-cells { flex: 1; display: flex; gap: 2rpx; }
.hm-cell { flex: 1; aspect-ratio: 1; background: var(--surface-3); border-radius: 4rpx; }
.hm-cell.empty { background: transparent; }
.heatmap-legend { display: flex; align-items: center; justify-content: flex-end; gap: 10rpx; margin-top: 16rpx; }
.legend-label { font-size: var(--font-sm); color: var(--text-3); }
.legend-cells { display: flex; gap: 6rpx; }
.lg-cell { width: 28rpx; height: 28rpx; border-radius: var(--radius-xs); }

.modal-body { padding: 0 32rpx; flex: 1; overflow-y: auto; }
.modal-footer { padding: 24rpx 32rpx 48rpx; }
.modal-footer .m2-btn { width: 100%; }
