/* 打卡列表独有：进度条 / 打卡圈 / 连击信息（页面骨架走 m2-* 全局类） */
.hero-progress { position: relative; z-index: 1; height: 14rpx; border-radius: var(--radius-full); background: var(--surface-3); overflow: hidden; margin-top: 24rpx; opacity: .6; }
.hero-progress-fill { height: 100%; border-radius: var(--radius-full); background: var(--text-inverse); transition: width .4s var(--ease); }
.hero-all-done { position: relative; z-index: 1; margin-top: 16rpx; font-size: var(--font-md); font-weight: 600; color: var(--text-inverse); }

.section-header { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 28rpx 16rpx; }

.habit-card { display: flex; align-items: center; gap: 18rpx; border-left: 8rpx solid var(--primary); }
.habit-card.checked { background: var(--success-light); }
.check-btn {
  width: 88rpx; height: 88rpx; border-radius: 50%; border: 4rpx solid var(--primary);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  transition: all .2s var(--ease);
}
.check-btn.checked { transform: scale(1.06); box-shadow: var(--shadow-md); }
.check-plus { font-size: 52rpx; font-weight: 300; line-height: 1; color: var(--primary-dark); }
.habit-main { flex: 1; min-width: 0; }
.habit-name-row { display: flex; align-items: center; gap: 10rpx; margin-bottom: 10rpx; }
.habit-name { font-size: var(--font-lg); font-weight: 600; color: var(--text); }
.habit-meta { font-size: var(--font-sm); color: var(--text-3); }
.streak-row { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; margin-bottom: 8rpx; }
.streak { color: var(--warning-dark); font-weight: 600; }
.longest { color: var(--warning-dark); }
.target-row { display: flex; align-items: center; gap: 12rpx; }
.target-bar { flex: 1; height: 8rpx; background: var(--surface-3); border-radius: var(--radius-full); overflow: hidden; max-width: 200rpx; }
.target-fill { height: 100%; border-radius: var(--radius-full); }
.target-text { font-size: var(--font-sm); color: var(--text-3); flex-shrink: 0; }
.habit-actions { display: flex; flex-direction: column; gap: 8rpx; flex-shrink: 0; }
.act-btn { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); background: var(--surface-2); }
