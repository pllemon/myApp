<view class="m2-page m2-edit" style="{{themeStyle}}">
  <view class="m2-edit-hero preview-card" style="border-left-color: {{color}};">
    <view class="m2-edit-hero-icon preview-icon" style="background-color: {{color}}20;"><m-icon value="{{icon}}" size="48" /></view>
    <view>
      <view class="m2-edit-title">{{name || '习惯名称'}}</view>
      <view class="m2-edit-desc">目标 {{targetDays}} 天</view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-form-title">快捷模板</view>
    <view class="preset-trigger" bindtap="togglePresets">{{showPresets ? '收起' : '选择模板'}} ›</view>
    <view wx:if="{{showPresets}}" class="preset-grid">
      <view
        wx:for="{{12}}"
        wx:for-item="idx"
        wx:key="*this"
        class="preset-item {{presetIndex === idx ? 'active' : ''}}"
        style="border-color: {{idx >= 0 && idx < presetList.length ? presetList[idx].color : 'var(--border)'}};"
        data-index="{{idx}}"
        bindtap="selectPreset"
      >
        <view wx:if="{{idx < 12}}" class="preset-icon"><m-icon value="{{presetList[idx].icon}}" size="40" /></view>
        <view wx:if="{{idx < 12}}" class="preset-name">{{presetList[idx].name}}</view>
      </view>
    </view>
  </view>

  <view class="m2-form-card">
    <view class="m2-field">
      <view class="m2-field-label">习惯名称</view>
      <input class="m2-field-value" placeholder="例如：每日喝水" value="{{name}}" bindinput="onNameInput" maxlength="12" />
    </view>
  </view>

  <view class="m2-form-card">
    <m-field label="图标" click bind:fieldtap="toggleIcons">
      <view class="m-form-picker-value">
        <view class="current-icon"><m-icon value="{{icon}}" size="36" /></view>
        <text class="m-picker-arrow">{{showIcons ? '▲' : '▼'}}</text>
      </view>
    </m-field>
    <m-icon-picker wx:if="{{showIcons}}" icons="{{iconOptions}}" value="{{icon}}" bind:select="selectIcon" />
  </view>

  <view class="m2-form-card">
    <m-field label="主题色" click bind:fieldtap="toggleColors">
      <view class="m-form-picker-value">
        <view class="current-color" style="background-color: {{color}};"></view>
        <text class="m-picker-arrow">{{showColors ? '▲' : '▼'}}</text>
      </view>
    </m-field>
    <m-color-picker wx:if="{{showColors}}" colors="{{colorOptions}}" color="{{color}}" bind:change="selectColor" />
  </view>

  <view class="m2-form-card">
    <view class="m2-field">
      <view class="m2-field-label">目标天数</view>
      <input class="m2-field-value" type="number" placeholder="30" value="{{targetDays}}" bindinput="onTargetInput" />
    </view>
    <view class="target-hint">常见目标：21 天养成习惯，30 天巩固，100 天坚持。</view>
  </view>

  <m-save-bar save-text="保存" show-delete="{{isEdit}}" bind:save="save" bind:delete="onDelete" />
</view>
