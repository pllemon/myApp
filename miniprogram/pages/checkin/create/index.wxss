/* 创建/编辑习惯独有：预览卡 / 模板宫格 / 选择器（表单骨架走 m2-* 全局类） */
.preview-card { border-left: 8rpx solid var(--primary); }
.preview-icon { background: var(--surface-2); }
.preset-trigger { font-size: var(--font-md); color: var(--primary-dark); margin-bottom: 12rpx; }
.preset-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; padding-bottom: 12rpx; }
.preset-item { display: flex; flex-direction: column; align-items: center; padding: 20rpx 8rpx; border-radius: var(--radius-md); border: 3rpx solid transparent; background: var(--bg); }
.preset-item.active { border-color: var(--primary); background: var(--primary-light); }
.preset-icon { display: flex; align-items: center; justify-content: center; margin-bottom: 6rpx; }
.preset-name { font-size: var(--font-sm); color: var(--text-2); }

.m-form-picker-value { display: flex; align-items: center; gap: 12rpx; }
.current-icon, .current-color { display: flex; align-items: center; justify-content: center; }
.current-color { width: 44rpx; height: 44rpx; border-radius: 50%; }
.m-picker-arrow { font-size: var(--font-sm); color: var(--text-3); }
.target-hint { font-size: var(--font-sm); color: var(--text-3); padding: 4rpx 0 20rpx; }
