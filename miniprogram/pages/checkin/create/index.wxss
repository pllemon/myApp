.preview-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 28rpx;
  border-left: 8rpx solid var(--primary);
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.preview-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
}

.preview-info {
  flex: 1;
}

.preview-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6rpx;
}

.preview-target {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.m-form-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}


.m-form-input {
  font-size: 30rpx;
  color: var(--text);
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.preset-trigger {
  font-size: 26rpx;
  color: var(--primary);
  margin-bottom: 16rpx;
}

.preset-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.preset-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  background-color: #FAFAFA;
}

.preset-item.active {
  border-color: var(--primary);
  background-color: rgba(74, 144, 217, 0.08);
}

.preset-icon {
  font-size: 40rpx;
  margin-bottom: 6rpx;
}

.preset-name {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.icon-picker, .color-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.current-icon {
  font-size: 48rpx;
}

.current-color {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.picker-arrow {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.icon-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 12rpx;
  padding-top: 16rpx;
}

.icon-item {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.icon-item.active {
  border-color: var(--primary);
  background-color: rgba(74, 144, 217, 0.08);
}

.color-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  padding-top: 16rpx;
}

.color-item {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
}

.color-item.active {
  border-color: var(--text);
  transform: scale(1.1);
}

.color-check {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
}

.target-hint {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}
