.cal-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 20rpx 24rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.cal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0 16rpx;
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--primary);
  background: var(--primary-light);
  border-radius: 50%;
  line-height: 1;
}

.month-label {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.weekday-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  padding: 12rpx 0;
}

.weekday {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.month-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.day-cell {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: var(--bg);
  transition: all 0.15s ease;
}

.day-cell.empty {
  background: transparent;
}

.day-num {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.2;
}

.day-cell.today .day-num {
  color: var(--primary);
  font-weight: 700;
}

.day-cell.today {
  border: 2rpx solid var(--primary);
}

.day-cell.selected {
  background: var(--primary);
}

.day-cell.selected .day-num {
  color: #fff;
  font-weight: 700;
}

.day-cell.selected.today {
  border-color: var(--primary-dark);
}

.day-marks {
  display: flex;
  justify-content: center;
  margin-top: 4rpx;
  min-height: 10rpx;
}

.day-mark {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin: 0 2rpx;
}

.day-cell.selected .day-mark {
  opacity: 0.85;
}

.cal-legend {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--divider);
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.legend-item .dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.detail {
  padding-bottom: 40rpx;
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.detail-date {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.detail-summary {
  display: flex;
  gap: 28rpx;
}

.sum-item {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.sum-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.sum-val {
  font-size: 30rpx;
  font-weight: 600;
}

.sum-val.expense {
  color: var(--danger);
}

.sum-val.income {
  color: var(--success);
}

.empty-day {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 60rpx 32rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 28rpx;
}

.empty-actions {
  display: flex;
  justify-content: center;
  gap: 24rpx;
}

.empty-btn {
  padding: 14rpx 36rpx;
  background: var(--primary-light);
  color: var(--primary);
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.section {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 8rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  padding: 20rpx 28rpx 12rpx;
}

.section-list {
  padding: 0 28rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--divider);
}

.section-list .row:first-child {
  border-top: none;
}

.row-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.diary-item .row-icon {
  background: var(--primary-light);
}

.row-body {
  flex: 1;
  min-width: 0;
}

.row-title {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-title.done {
  color: var(--text-secondary);
  text-decoration: line-through;
}

.row-title.overdue {
  color: var(--danger);
}

.row-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-arrow {
  font-size: 36rpx;
  color: var(--text-secondary);
  margin-left: 12rpx;
  flex-shrink: 0;
}

.row-amount {
  font-size: 30rpx;
  font-weight: 600;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.row-amount.expense {
  color: var(--danger);
}

.row-amount.income {
  color: var(--success);
}

.checkin-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 12rpx 28rpx 20rpx;
}

.checkin-chip {
  display: flex;
  align-items: center;
  padding: 10rpx 22rpx;
  border-radius: 32rpx;
  border: 2rpx solid var(--divider);
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--bg);
}

.checkin-chip.on {
  font-weight: 500;
  background: var(--bg-card);
}

.checkin-chip.off {
  opacity: 0.55;
}

.chip-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.todo-row {
  padding: 18rpx 28rpx;
}

.todo-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.todo-check.checked {
  background: var(--success);
  border-color: var(--success);
}

.check-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.todo-body {
  padding: 0;
}

.todo-tags {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.todo-tag {
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

.todo-overdue {
  font-size: 20rpx;
  color: var(--danger);
}