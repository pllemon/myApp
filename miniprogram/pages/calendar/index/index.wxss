/* 日历工具独有：月历网格 / 图例 / 打卡与待办子项（页面骨架、列表行、空态走 m2-* 全局类） */
.cal-card { padding: 20rpx 24rpx 24rpx; }
.cal-header { padding: 0 0 16rpx; align-items: center; }
.nav-btn { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--primary-light); color: var(--primary); }
.nav-prev { transform: rotate(180deg); }

.weekday-row { display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; padding: 12rpx 0; }
.weekday { font-size: 24rpx; color: var(--text-3); }
.month-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx; }
.day-cell { aspect-ratio: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 14rpx; background: var(--bg); box-sizing: border-box; transition: all .15s ease; }
.day-cell.empty { background: transparent; }
.day-num { font-size: 28rpx; color: var(--text); line-height: 1.2; }
.day-cell.today .day-num { color: var(--primary); font-weight: 700; }
.day-cell.today { border: 2rpx solid var(--primary); }
.day-cell.selected { background: var(--primary); }
.day-cell.selected .day-num { color: var(--text-inverse); font-weight: 700; }
.day-marks { display: flex; justify-content: center; margin-top: 4rpx; min-height: 10rpx; }
.day-mark { width: 10rpx; height: 10rpx; border-radius: 50%; margin: 0 2rpx; }
.day-cell.selected .day-mark { opacity: .85; }

.cal-legend { display: flex; justify-content: center; flex-wrap: wrap; gap: 24rpx; margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid var(--border); }
.legend-item { display: flex; align-items: center; font-size: 22rpx; color: var(--text-2); }
.legend-item .dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-right: 8rpx; }

.detail-header { display: flex; align-items: center; justify-content: space-between; }
.detail-summary { display: flex; gap: 28rpx; }
.sum-item { display: flex; flex-direction: column; align-items: flex-end; }
.sum-label { font-size: 22rpx; color: var(--text-3); }
.sum-val { font-size: 30rpx; font-weight: 600; }
.empty-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.empty-action-btn { padding: 16rpx 40rpx; border-radius: 999rpx; background: var(--primary); color: #FFFFFF; font-size: 26rpx; font-weight: 600; }

.inner-list { margin: 0; padding: 0 28rpx; background: transparent; box-shadow: none; border-radius: 0; }
.todo-row { min-height: 88rpx; }
.checkin-grid { display: flex; flex-wrap: wrap; gap: 14rpx; padding: 12rpx 0 4rpx; }
.checkin-chip { display: flex; align-items: center; padding: 10rpx 22rpx; border-radius: var(--radius-full); border: 2rpx solid var(--border); font-size: 24rpx; color: var(--text-2); background: var(--bg); }
.checkin-chip.on { font-weight: 500; background: var(--surface); }
.checkin-chip.off { opacity: .55; }
.chip-icon { display: flex; align-items: center; justify-content: center; margin-right: 8rpx; }

.todo-check { width: 40rpx; height: 40rpx; border-radius: 50%; border: 2rpx solid var(--text-3); display: flex; align-items: center; justify-content: center; margin-right: 20rpx; flex-shrink: 0; box-sizing: border-box; }
.todo-check.checked { background: var(--success); border-color: var(--success); color: var(--text-inverse); }
.todo-tags { display: flex; align-items: center; margin-top: 8rpx; }
.todo-tag { font-size: 20rpx; padding: 2rpx 14rpx; border-radius: var(--radius-full); margin-right: 12rpx; }
.todo-overdue { font-size: 20rpx; color: var(--danger); }
