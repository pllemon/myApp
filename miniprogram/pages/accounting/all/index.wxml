<view class="m2-page" style="{{themeStyle}}">
  <!-- 收支筛选 -->
  <view class="m2-segment">
    <view class="m2-seg-item {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="changeFilter">全部</view>
    <view class="m2-seg-item {{filter === 'expense' ? 'active' : ''}}" data-filter="expense" bindtap="changeFilter">支出</view>
    <view class="m2-seg-item {{filter === 'income' ? 'active' : ''}}" data-filter="income" bindtap="changeFilter">收入</view>
  </view>
  <view class="m2-wrap count-bar">共 {{totalAll}} 条</view>

  <!-- 加载骨架 -->
  <view wx:if="{{loading}}" class="m2-wrap">
    <view class="m-skeleton skeleton-row"></view>
    <view class="m-skeleton skeleton-row"></view>
    <view class="m-skeleton skeleton-row"></view>
    <view class="m-skeleton skeleton-row"></view>
  </view>

  <!-- 空态 -->
  <m-empty wx:if="{{groups.length === 0 && !loading}}" title="暂无记录，还没有任何记账" />

  <!-- 按日分组 -->
  <m-day-group
    class="day-group-wrap"
    wx:for="{{groups}}"
    wx:key="date"
    label="{{item.label}}"
    expense="{{item.dayExpense}}"
    income="{{item.dayIncome}}"
    sticky="{{true}}"
  >
    <view class="record-list">
      <view
        wx:for="{{item.items}}"
        wx:for-item="record"
        wx:key="_id"
        class="m2-row"
        data-id="{{record._id}}"
        bindtap="goToEdit"
      >
        <view class="m2-row-icon"><m-icon value="{{record.categoryIcon || 'other'}}" flatKey="{{record.category}}" size="36" tone="flat" /></view>
        <view class="m2-row-body">
          <view class="m2-row-title">{{record.category || '未分类'}}</view>
          <view class="m2-row-sub" wx:if="{{record.note}}">{{record.note}}</view>
        </view>
        <view class="m2-row-value {{record.type === 'expense' ? 'm-text-danger' : 'm-text-success'}}">{{record.type === 'expense' ? '-' : '+'}}¥{{record.amount}}</view>
      </view>
    </view>
  </m-day-group>

  <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
  <view class="loading-tip" wx:if="{{!hasMore && groups.length > 0}}">已加载全部 {{totalAll}} 条</view>
</view>
