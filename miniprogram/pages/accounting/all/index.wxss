.filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #F0F0F0;
}

.filter-chip {
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #F5F5F5;
}

.filter-chip.active {
  background: #4A90D9;
  color: #FFFFFF;
  font-weight: 500;
}

.filter-count {
  margin-left: auto;
  font-size: 24rpx;
  color: #999;
}

.day-group {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 16rpx 24rpx;
  overflow: hidden;
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 28rpx;
  background: #FAFAFA;
}

.day-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.day-summary {
  font-size: 24rpx;
}

.day-summary .sep {
  color: #DDD;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-top: 1rpx solid #F5F5F5;
}

.record-icon {
  font-size: 40rpx;
  width: 64rpx;
  text-align: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-category {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.record-note {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-amount {
  font-size: 30rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.loading-tip {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #BBB;
}

.pos { color: #27AE60; }
.neg { color: #E74C3C; }
