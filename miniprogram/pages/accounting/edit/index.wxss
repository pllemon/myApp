.m2-edit-main { flex: 1; min-width: 0; }

/* 收支类型：支出红 / 收入绿 */
.m2-seg-item.active.expense-active { background: var(--danger); color: var(--text-inverse); }
.m2-seg-item.active.income-active { background: var(--success); color: var(--text-inverse); }

/* 金额大字输入 */
.amount-field { min-height: 120rpx; }
.amount-currency { font-size: var(--font-xl); font-weight: 700; color: var(--text); margin-right: 12rpx; }
.amount-input { flex: 1; width: 100%; }

/* 一级分类 */
.parent-scroll { white-space: nowrap; margin: 4rpx 0 20rpx; }
.parent-chip {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 12rpx 22rpx; margin-right: 14rpx;
  border-radius: var(--radius-full); background: var(--surface-2);
  font-size: var(--font-md); color: var(--text-2);
  border: 2rpx solid transparent;
}
.parent-chip.active { background: var(--primary-light); color: var(--primary-dark); border-color: var(--primary); font-weight: 600; }
.parent-chip-name { max-width: 160rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 二级分类 */
.child-grid { display: flex; flex-wrap: wrap; gap: 14rpx; padding-bottom: 12rpx; }
.child-item {
  width: calc(25% - 11rpx); box-sizing: border-box;
  background: var(--surface-2); border-radius: var(--radius-md);
  padding: 22rpx 8rpx; text-align: center;
  border: 2rpx solid transparent;
}
.child-item.active { background: var(--primary-light); border-color: var(--primary); }
.child-icon { display: flex; align-items: center; justify-content: center; margin-bottom: 10rpx; }
.child-name { font-size: var(--font-sm); color: var(--text-2); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.child-item.active .child-name { color: var(--primary-dark); font-weight: 600; }
.child-item.add { border-style: dashed; border-color: var(--border); background: var(--bg); color: var(--text-3); }
