.type-switch {
  display: flex;
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 32rpx;
}

.type-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #999;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.type-btn.active.expense {
  background: #FFFFFF;
  color: #E74C3C;
  box-shadow: 0 2rpx 12rpx rgba(231,76,60,0.15);
}

.type-btn.active.income {
  background: #FFFFFF;
  color: #27AE60;
  box-shadow: 0 2rpx 12rpx rgba(39,174,96,0.15);
}

.amount-section {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
}

.currency {
  font-size: 60rpx;
  font-weight: 700;
  color: #333;
  margin-right: 16rpx;
}

.amount-input {
  font-size: 80rpx;
  font-weight: 700;
  color: #333;
  width: 400rpx;
  text-align: left;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 16rpx 0 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
}

.manage-btn {
  font-size: 26rpx;
  color: #4A90D9;
}

.parent-tabs {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.parent-tab {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 24rpx;
  margin-right: 12rpx;
  background: #F5F7FA;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.parent-tab.active {
  background: #FFFFFF;
  border-color: #4A90D9;
  color: #4A90D9;
  box-shadow: 0 2rpx 8rpx rgba(74,144,217,0.15);
}

.parent-icon {
  margin-right: 6rpx;
}

.child-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.child-item {
  width: calc(25% - 12rpx);
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.child-item.active {
  border-color: #4A90D9;
  background: #F0F8FF;
}

.child-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.child-name {
  font-size: 24rpx;
  color: #666;
}

.child-item.active .child-name {
  color: #4A90D9;
  font-weight: 600;
}

.child-item.add-child {
  border-style: dashed;
  border-color: #DDD;
  background: #FAFAFA;
}

.child-item.add-child .child-icon {
  font-size: 36rpx;
}

.m-form-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.form-item:last-child {
  border-bottom: none;
}


.form-value {
  font-size: 28rpx;
  color: #4A90D9;
}

.m-form-input {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}


.expense-bg {
  background: linear-gradient(135deg, #E74C3C 0%, #F1948A 100%);
}

.income-bg {
  background: linear-gradient(135deg, #27AE60 0%, #7DCEA0 100%);
}


.image-section {
  margin-top: 32rpx;
}

.image-section .section-title {
  margin-bottom: 16rpx;
}

.image-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.image-thumb {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 38rpx;
  text-align: center;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #DDD;
  background: #FAFAFA;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 56rpx;
  color: #CCC;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #BBB;
  margin-top: 8rpx;
}
