<view class="m2-page" style="{{themeStyle}}">
  <!-- 月度结余 Hero -->
  <view class="m2-hero">
    <view class="m2-hero-head">
      <view class="m2-hero-title">{{year}}年{{month}}月</view>
      <view class="m2-hero-sub">{{title}}</view>
    </view>
    <view class="m2-hero-value {{summary.balance >= 0 ? 'hero-pos' : 'hero-neg'}}">¥{{summary.balance}}</view>
    <view class="m2-hero-note">当月结余</view>
    <view class="m2-hero-stats">
      <view class="m2-hero-stat">
        <view class="m2-hero-stat-value m-text-danger">-¥{{summary.expense}}</view>
        <view class="m2-hero-stat-label">支出</view>
      </view>
      <view class="m2-hero-stat">
        <view class="m2-hero-stat-value m-text-success">+¥{{summary.income}}</view>
        <view class="m2-hero-stat-label">收入</view>
      </view>
    </view>
  </view>

  <!-- 空态 -->
  <m-empty wx:if="{{groupedByDay.length === 0}}" title="该月无记录" />

  <!-- 按日分组明细 -->
  <m-day-group
    class="day-group-wrap"
    wx:for="{{groupedByDay}}"
    wx:key="date"
    label="{{item.label}}"
    weekday="{{item.weekday}}"
    expense="{{item.dayExpense}}"
    income="{{item.dayIncome}}"
  >
    <view class="record-list">
      <view
        wx:for="{{item.items}}"
        wx:for-item="record"
        wx:key="_id"
        class="m2-row record-row"
        data-id="{{record._id}}"
        bindtap="goToEdit"
      >
        <view class="m2-row-icon"><m-icon value="{{record.categoryIcon || 'other'}}" flatKey="{{record.category}}" size="36" tone="flat" /></view>
        <view class="m2-row-body">
          <view class="m2-row-title">{{record.category || '未分类'}}</view>
          <view class="m2-row-sub" wx:if="{{record.note}}">{{record.note}}</view>
          <view class="record-imgs" wx:if="{{record.images && record.images.length}}">
            <image
              wx:for="{{record.images}}"
              wx:for-item="img"
              wx:key="*this"
              src="{{img}}"
              mode="aspectFill"
              class="record-img"
              data-src="{{img}}"
              data-urls="{{record.images}}"
              catchtap="previewImage"
            />
          </view>
        </view>
        <view class="m2-row-value {{record.type === 'expense' ? 'm-text-danger' : 'm-text-success'}}">{{record.type === 'expense' ? '-' : '+'}}¥{{record.amount}}</view>
      </view>
    </view>
  </m-day-group>
</view>
