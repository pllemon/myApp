.hero-pos { color: var(--surface); }
.hero-neg { color: var(--danger-light); }

.day-group-wrap { margin-left: 24rpx; margin-right: 24rpx; }
.record-list { padding: 0 24rpx; }
.record-row { align-items: flex-start; }

.record-imgs { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-top: 10rpx; }
.record-img { width: 100rpx; height: 100rpx; border-radius: var(--radius-xs); }
