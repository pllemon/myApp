.month-summary {
  background: linear-gradient(135deg, #4A90D9 0%, #6BB5F0 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

.ms-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.ms-label {
  font-size: 26rpx;
  opacity: 0.85;
}

.ms-main {
  font-size: 52rpx;
  font-weight: 700;
}

.ms-main.pos { color: #FFFFFF; }
.ms-main.neg { color: #FFDAD6; }

.ms-detail {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.15);
  border-radius: 12rpx;
  padding: 16rpx 0;
}

.ms-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
}

.ms-item-label {
  font-size: 22rpx;
  opacity: 0.8;
  margin-right: 8rpx;
}

.ms-item-sep {
  width: 2rpx;
  height: 40rpx;
  background: rgba(255,255,255,0.3);
}

.day-group {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  background: #FAFAFA;
}

.day-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.day-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.day-weekday {
  font-size: 22rpx;
  color: #999;
}

.day-summary {
  font-size: 24rpx;
}

.day-summary .sep {
  color: #DDD;
}

.record-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 28rpx;
  border-top: 1rpx solid #F5F5F5;
}

.record-icon {
  font-size: 44rpx;
  width: 64rpx;
  text-align: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-category {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.record-note {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-imgs {
  display: flex;
  gap: 8rpx;
  margin-top: 10rpx;
}

.record-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
}

.record-amount {
  font-size: 30rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
  margin-top: 4rpx;
}

.pos { color: #27AE60; }
.neg { color: #E74C3C; }
