<view class="m2-page" style="{{themeStyle}}">
  <!-- 加载骨架 -->
  <view wx:if="{{loading}}" class="m2-wrap">
    <view class="m-skeleton skeleton-hero"></view>
    <view class="m-skeleton skeleton-card"></view>
    <view class="m-skeleton skeleton-card"></view>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 累计收支 Hero -->
    <view class="m2-hero">
      <view class="m2-hero-head">
        <view class="m2-hero-title">累计统计</view>
        <view class="m2-hero-sub">全部账本</view>
      </view>
      <view class="m2-hero-value {{total.balance >= 0 ? 'hero-pos' : 'hero-neg'}}">¥{{total.balance}}</view>
      <view class="m2-hero-note">累计结余</view>
      <view class="m2-hero-stats">
        <view class="m2-hero-stat">
          <view class="m2-hero-stat-value m-text-danger">-¥{{total.expense}}</view>
          <view class="m2-hero-stat-label">累计支出</view>
        </view>
        <view class="m2-hero-stat">
          <view class="m2-hero-stat-value m-text-success">+¥{{total.income}}</view>
          <view class="m2-hero-stat-label">累计收入</view>
        </view>
      </view>
    </view>

    <!-- 图表 -->
    <m-chart-card wx:if="{{chartsReady && chartData.pieData.length > 0}}" title="本月支出分类">
      <view class="chart-wrap-pie">
        <canvas canvas-id="pieChart" class="canvas-pie" disable-scroll="true" bindtap="onPieTap"></canvas>
      </view>
      <view class="chart-legend">
        <view
          wx:for="{{categoryLegend}}"
          wx:key="id"
          class="legend-item"
          data-id="{{item.id}}"
          bindtap="goCategoryDetail"
        >
          <view class="legend-dot" style="background:{{item.color}}"></view>
          <view class="legend-name">{{item.name}}</view>
          <view class="legend-val">¥{{item.value.toFixed(0)}}</view>
        </view>
      </view>
    </m-chart-card>

    <m-chart-card wx:if="{{chartsReady && chartData.barData.length > 0}}" title="近6月收支对比">
      <view class="chart-legend-inline">
        <view class="legend-inline-item"><view class="legend-inline-dot neg-bg"></view>支出</view>
        <view class="legend-inline-item"><view class="legend-inline-dot pos-bg"></view>收入</view>
      </view>
      <view class="chart-wrap">
        <canvas canvas-id="barChart" class="canvas-bar" disable-scroll="true"></canvas>
      </view>
    </m-chart-card>

    <m-chart-card wx:if="{{chartsReady && chartData.trendData.length > 0}}" title="近6月结余走势">
      <view class="chart-wrap">
        <canvas canvas-id="trendChart" class="canvas-bar" disable-scroll="true"></canvas>
      </view>
    </m-chart-card>

    <!-- 空态 -->
    <m-empty wx:if="{{years.length === 0}}" title="还没有统计数据，先去记一笔账吧" />

    <!-- 年度 / 月度明细 -->
    <view class="m2-card year-card" wx:for="{{years}}" wx:key="year">
      <view class="m2-row-between year-header" data-index="{{index}}" bindtap="toggleYear">
        <view class="year-left">
          <view class="m2-card-title">{{item.year}}年</view>
          <view class="year-meta">
            支出 <text class="neg">¥{{item.expenseStr}}</text>
            <text class="sep">·</text>
            收入 <text class="pos">¥{{item.incomeStr}}</text>
            <text class="sep">·</text>
            结余 <text class="{{item.balanceStr >= 0 ? 'pos' : 'neg'}}">¥{{item.balanceStr}}</text>
          </view>
        </view>
        <view class="year-arrow {{item.expanded ? 'up' : ''}}">›</view>
      </view>

      <view wx:if="{{item.expanded}}" class="month-list">
        <view
          class="month-item"
          wx:for="{{item.months}}"
          wx:for-item="m"
          wx:key="month"
          data-year="{{item.year}}"
          data-month="{{m.month}}"
          bindtap="goMonthDetail"
        >
          <view class="month-name">{{item.year}}年{{m.month}}月</view>
          <view class="month-meta">
            支出 <text class="neg">¥{{m.expenseStr}}</text>
            <text class="sep">·</text>
            收入 <text class="pos">¥{{m.incomeStr}}</text>
            <text class="sep">·</text>
            结余 <text class="{{m.balanceStr >= 0 ? 'pos' : 'neg'}}">¥{{m.balanceStr}}</text>
          </view>
          <view class="month-arrow">›</view>
        </view>
        <view wx:if="{{item.months.length === 0}}" class="no-month">暂无月份数据</view>
      </view>
    </view>
  </block>
</view>
