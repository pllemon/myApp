.summary-title {
  font-size: 26rpx;
  opacity: 0.85;
  margin-bottom: 16rpx;
}

.summary-main {
  margin-bottom: 32rpx;
}

.main-label {
  font-size: 24rpx;
  opacity: 0.8;
}

.main-amount {
  font-size: 64rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.main-amount.pos { color: #FFFFFF; }
.main-amount.neg { color: #FFDAD6; }

.summary-row {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 20rpx 0;
}

.sum-item {
  flex: 1;
  text-align: center;
}

.sum-label {
  font-size: 24rpx;
  opacity: 0.8;
}

.sum-value {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.sum-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.3);
}

.empty-hint {
  font-size: 24rpx;
  color: #CCC;
  margin-top: 12rpx;
}

.year-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.year-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
}

.year-left {
  flex: 1;
}

.year-label {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

.year-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.year-meta .sep {
  margin: 0 12rpx;
  color: #DDD;
}

.year-arrow {
  font-size: 36rpx;
  color: #CCC;
  transition: transform 0.25s;
  transform: rotate(90deg);
}

.year-arrow.up {
  transform: rotate(-90deg);
}

.month-list {
  padding: 0 28rpx 8rpx;
  border-top: 1rpx solid #F0F0F0;
}

.month-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.month-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  width: 160rpx;
  flex-shrink: 0;
}

.month-meta {
  flex: 1;
  font-size: 24rpx;
  color: #999;
}

.month-meta .sep {
  margin: 0 10rpx;
  color: #DDD;
}

.month-arrow {
  font-size: 32rpx;
  color: #CCC;
  margin-left: 12rpx;
}

.no-month {
  text-align: center;
  color: #CCC;
  padding: 20rpx 0;
  font-size: 26rpx;
}

.pos { color: #27AE60; }
.neg { color: #E74C3C; }
.chart-card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.chart-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 20rpx;
}
.chart-wrap {
  display: flex;
  justify-content: center;
}
.chart-wrap-pie {
  display: flex;
  justify-content: center;
}
.canvas-pie {
  width: 260px;
  height: 220px;
}
.canvas-bar {
  width: 320px;
  height: 190px;
}
.chart-legend {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
}
.legend-item {
  display: flex;
  align-items: center;
  width: 50%;
  padding: 8rpx 0;
  box-sizing: border-box;
}
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.legend-name {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.legend-val {
  font-size: 24rpx;
  color: var(--text);
  font-weight: 500;
}
.chart-legend-inline {
  display: flex;
  gap: 32rpx;
  margin-bottom: 8rpx;
}
.legend-inline-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-secondary);
}
.legend-inline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}

