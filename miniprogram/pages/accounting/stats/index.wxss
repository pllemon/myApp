/* 骨架屏 */
.skeleton-hero { height: 280rpx; border-radius: var(--radius-lg); margin-bottom: var(--space-md); }
.skeleton-card { height: 200rpx; border-radius: var(--radius-md); margin-bottom: var(--space-md); }

/* Hero 语义色 */
.hero-pos { color: var(--surface); }
.hero-neg { color: var(--danger-light); }

/* 收支语义色：支出红 / 收入绿 */
.pos { color: var(--success); }
.neg { color: var(--danger); }
.pos-bg { background: var(--success); }
.neg-bg { background: var(--danger); }

/* 图表 */
.chart-wrap, .chart-wrap-pie { display: flex; justify-content: center; }
.canvas-pie { width: 260px; height: 220px; }
.canvas-bar { width: 320px; height: 190px; }
.chart-legend { margin-top: var(--space-sm); display: flex; flex-wrap: wrap; }
.legend-item { display: flex; align-items: center; width: 50%; padding: 8rpx 0; box-sizing: border-box; }
.legend-dot { width: 16rpx; height: 16rpx; border-radius: var(--radius-full); margin-right: 12rpx; flex-shrink: 0; }
.legend-name { flex: 1; font-size: var(--font-sm); color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.legend-val { font-size: var(--font-sm); color: var(--text); font-weight: 500; }
.chart-legend-inline { display: flex; gap: var(--space-lg); margin-bottom: var(--space-xs); }
.legend-inline-item { display: flex; align-items: center; font-size: var(--font-sm); color: var(--text-2); }
.legend-inline-dot { width: 16rpx; height: 16rpx; border-radius: var(--radius-xs); margin-right: 8rpx; }

/* 年度卡片 */
.year-card { padding: 0 28rpx; }
.year-header { padding: 28rpx 0; }
.year-left { flex: 1; min-width: 0; }
.year-meta { font-size: var(--font-sm); color: var(--text-3); margin-top: 8rpx; }
.year-meta .sep { margin: 0 12rpx; color: var(--border); }
.year-arrow { font-size: var(--font-xl); color: var(--text-3); transition: transform var(--duration) var(--ease); transform: rotate(90deg); }
.year-arrow.up { transform: rotate(-90deg); }

/* 月份列表 */
.month-list { padding-bottom: var(--space-xs); border-top: 1rpx solid var(--border); }
.month-item { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid var(--border); }
.month-name { font-size: var(--font-base); color: var(--text); font-weight: 600; width: 180rpx; flex-shrink: 0; }
.month-meta { flex: 1; font-size: var(--font-sm); color: var(--text-3); }
.month-meta .sep { margin: 0 10rpx; color: var(--border); }
.month-arrow { font-size: var(--font-lg); color: var(--text-3); margin-left: 12rpx; }
.no-month { text-align: center; color: var(--text-3); padding: 20rpx 0; font-size: var(--font-md); }
