.book-switcher {
  margin: 16rpx 0 8rpx;
}

.book-scroll {
  white-space: nowrap;
  padding: 4rpx 0;
}

.book-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.book-chip.active {
  border-color: var(--theme-primary, #4A90D9);
  background: rgba(74, 144, 217, 0.08);
}

.book-chip .book-icon {
  font-size: 30rpx;
}

.book-chip .book-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-chip.add {
  padding: 14rpx 24rpx;
  background: rgba(74, 144, 217, 0.08);
  color: var(--theme-primary, #4A90D9);
  font-size: 30rpx;
  border-style: dashed;
}

.month-header {
  background: linear-gradient(135deg, #4A90D9 0%, #6BB5F0 100%);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  color: #FFFFFF;
  margin: 24rpx 0;
}

.month-label {
  font-size: 32rpx;
  font-weight: 600;
  opacity: 0.9;
}

.mh-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 32rpx;
}

.mh-nav {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  font-size: 36rpx;
  color: #FFFFFF;
}

.mh-nav.disabled {
  opacity: 0.3;
  pointer-events: none;
}

.mh-sub-row {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
  margin-top: 8rpx;
}

.mh-stats-btn {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 24rpx;
}

.month-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.month-stat {
  flex: 1;
  text-align: center;
}

.ms-label {
  font-size: 24rpx;
  opacity: 0.8;
  display: block;
}

.ms-value {
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 8rpx;
  display: block;
}

.month-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.3);
}

.filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  margin-bottom: 8rpx;
}

.filter-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.filter-btn {
  font-size: 26rpx;
  color: #4A90D9;
  padding: 8rpx 16rpx;
}

.filter-dropdown {
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  padding: 8rpx 0;
  margin-bottom: 16rpx;
}

.filter-option {
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  color: #666;
}

.filter-option.active {
  color: #4A90D9;
  background: #F0F8FF;
  font-weight: 600;
}

.day-group {
  margin-bottom: 24rpx;
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 8rpx 12rpx;
}

.day-label {
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
}

.day-summary {
  font-size: 24rpx;
}

.day-summary .expense {
  color: #E74C3C;
}

.day-summary .income {
  color: #27AE60;
}

.day-summary .sep {
  color: #DDD;
  margin: 0 8rpx;
}

.record-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.record-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #F5F7FA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
}

.record-info {
  flex: 1;
}

.record-category {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.record-note {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-amount {
  font-size: 32rpx;
  font-weight: 700;
}

.record-amount.expense {
  color: #E74C3C;
}

.record-amount.income {
  color: #27AE60;
}


