/* Hero 内月份翻页与账本入口 */
.hero-head-right { display: flex; align-items: center; gap: 12rpx; }
.hero-book-btn {
  width: 52rpx; height: 52rpx; border-radius: var(--radius-full);
  background: var(--surface);
  display: flex; align-items: center; justify-content: center;
}
.hero-nav-group { display: flex; gap: 12rpx; }
.hero-nav {
  width: 52rpx; height: 52rpx; line-height: 48rpx; text-align: center;
  border-radius: var(--radius-full); background: var(--surface);
  font-size: var(--font-xl); color: var(--primary-dark);
}
.hero-nav.disabled { opacity: .35; pointer-events: none; }

/* Hero 内预算细条与警告角标 */
.hero-budget {
  position: relative; z-index: 1;
  margin-top: 24rpx; padding-top: 18rpx;
  border-top: 1rpx solid var(--primary-light);
}
.hero-budget-label { font-size: var(--font-base); font-weight: 600; color: var(--surface); }
.hero-budget-percent { font-size: var(--font-md); color: var(--surface); opacity: .85; }
.hero-budget-track { margin-top: 12rpx; background: var(--primary-light); }
.hero-progress-fill { background: var(--surface); }
.hero-progress-fill.warning { background: var(--warning); }
.hero-progress-fill.danger { background: var(--danger); }
.hero-warning {
  position: relative; z-index: 1;
  display: inline-flex; align-items: center; gap: 8rpx;
  margin-top: 16rpx; padding: 8rpx 16rpx;
  background: var(--primary-light); color: var(--primary-dark);
  border-radius: var(--radius-full);
}
.hero-warning-text { font-size: var(--font-sm); color: var(--primary-dark); }

/* 工具条：搜索 / 筛选 */
.tool-bar { display: flex; gap: 16rpx; padding: 4rpx 0 16rpx; }
.tool-btn {
  width: 64rpx; height: 64rpx; border-radius: var(--radius-full);
  background: var(--surface); box-shadow: var(--shadow-sm);
  display: flex; align-items: center; justify-content: center;
}
.tool-btn.active { background: var(--primary-light); }
.search-cancel { flex-shrink: 0; }
.filter-segment { margin-top: 0; }

/* 分组内列表与笔数 */
.day-group-wrap { margin-left: 24rpx; margin-right: 24rpx; }
.record-list { padding: 0 24rpx; }
.count-bar { text-align: center; font-size: var(--font-sm); color: var(--text-3); padding: 20rpx 0 8rpx; }
