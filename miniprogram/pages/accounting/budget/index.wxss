/* 月份切换 */
.month-nav { display: flex; align-items: center; justify-content: space-between; }
.mn-btn {
  width: 64rpx; height: 64rpx; border-radius: var(--radius-md);
  background: var(--surface-2); color: var(--text-2);
  font-size: var(--font-xl); line-height: 58rpx; text-align: center;
}
.mn-title { font-size: var(--font-lg); font-weight: 600; color: var(--text); }

/* 总预算输入与进度 */
.total-input-row { display: flex; align-items: center; border-bottom: 1rpx solid var(--border); padding: var(--space-sm) 0; }
.amount-input { flex: 1; width: 100%; }
.budget-progress { margin-top: var(--space-md); }
.bp-meta { font-size: var(--font-sm); color: var(--text-3); margin-bottom: 12rpx; }
.bp-track { height: 12rpx; }
.fill-primary { background: var(--primary); }
.fill-warning { background: var(--warning); }
.fill-danger { background: var(--danger); }
.bp-hint { margin-top: 12rpx; font-size: var(--font-sm); color: var(--warning); }
.bp-hint.danger { color: var(--danger); }

/* 分类预算 */
.cat-tip { margin: -4rpx 0 12rpx; }
.cat-row { padding: 16rpx 0; }
.cat-icon { background: var(--surface-2); }
.cat-info { min-width: 0; }
.cat-input {
  width: 140rpx; height: 56rpx; padding: 0 12rpx;
  border-radius: var(--radius-sm); background: var(--surface-2);
  font-size: var(--font-md); color: var(--text); text-align: right;
}
.cat-unit { font-size: var(--font-sm); color: var(--text-3); width: 28rpx; text-align: right; }
