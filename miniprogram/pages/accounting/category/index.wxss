.m2-seg-item.active.expense-active { background: var(--danger); color: var(--text-inverse); }
.m2-seg-item.active.income-active { background: var(--success); color: var(--text-inverse); }

.bar-wrap { padding: 8rpx 4rpx 16rpx; }
.bar-actions { display: flex; align-items: center; gap: 20rpx; }
.bar-action-danger { font-size: var(--font-base); color: var(--danger); }

.parent-card { padding: 24rpx 28rpx; }
.parent-head { padding-bottom: 18rpx; border-bottom: 1rpx solid var(--border); }
.parent-main { display: flex; align-items: center; gap: 16rpx; min-width: 0; }
.parent-icon-box {
  width: 72rpx; height: 72rpx; flex-shrink: 0; border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  background: var(--surface-2); border: 2rpx dashed transparent;
}
.parent-icon-box:active { border-color: var(--primary); }
.parent-info { min-width: 0; }
.parent-name { font-size: var(--font-lg); font-weight: 600; color: var(--text); }

.row-actions { display: flex; align-items: center; gap: 10rpx; flex-shrink: 0; }
.action-btn {
  padding: 8rpx 18rpx; border-radius: var(--radius-full);
  background: var(--surface-2); color: var(--primary);
  font-size: var(--font-sm);
}
.action-btn.small { padding: 6rpx 14rpx; }
.action-btn.del { background: var(--danger-light); color: var(--danger); }

.child-list { padding-top: 6rpx; }
.child-row { min-height: 88rpx; padding: 14rpx 0; }
.child-icon-box {
  width: 56rpx; height: 56rpx; flex-shrink: 0; border-radius: var(--radius-sm);
  display: flex; align-items: center; justify-content: center; background: var(--surface-2);
}
.child-name { font-size: var(--font-base); color: var(--text); }
.child-row.add .child-icon-box { background: transparent; color: var(--primary); }
