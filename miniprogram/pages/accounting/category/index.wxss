.type-switch {
  display: flex;
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.type-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #999;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.type-btn.active.expense {
  background: #FFFFFF;
  color: #E74C3C;
  box-shadow: 0 2rpx 12rpx rgba(231,76,60,0.15);
}

.type-btn.active.income {
  background: #FFFFFF;
  color: #27AE60;
  box-shadow: 0 2rpx 12rpx rgba(39,174,96,0.15);
}

.section-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 26rpx;
  color: #999;
}

.bar-btns {
  display: flex;
  gap: 16rpx;
}

.bar-btn {
  font-size: 26rpx;
  color: #4A90D9;
}

.bar-btn.danger {
  color: #E74C3C;
}

.parent-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.parent-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.parent-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F0F0F0;
  margin-bottom: 16rpx;
}

.parent-main {
  display: flex;
  align-items: center;
}

.parent-icon-box {
  width: 72rpx;
  height: 72rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 16rpx;
  border: 2rpx dashed transparent;
  transition: all 0.2s;
}

.parent-icon-box:active {
  border-color: #4A90D9;
}

.parent-info {
  display: flex;
  flex-direction: column;
}

.parent-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.parent-count {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.parent-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border-radius: 24rpx;
  background: #F5F7FA;
  color: #4A90D9;
}

.action-btn.small {
  padding: 4rpx 14rpx;
  font-size: 22rpx;
}

.action-btn.danger {
  background: #FDF0EE;
  color: #E74C3C;
}

.child-list {
  display: flex;
  flex-direction: column;
}

.child-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.child-row.add {
  border-top: 1rpx dashed #EEE;
  margin-top: 8rpx;
  padding-top: 20rpx;
}

.child-icon-box {
  width: 56rpx;
  height: 56rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.child-row.add .child-icon-box {
  background: #FAFAFA;
}

.child-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.child-actions {
  display: flex;
  gap: 12rpx;
}

.icon-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.icon-picker {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.picker-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.icon-cell {
  width: calc((100% - 112rpx) / 8);
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
}

.picker-cancel {
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #999;
  border-top: 1rpx solid #F0F0F0;
}