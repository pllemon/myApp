<view class="container">
  <view class="type-switch">
    <view 
      class="type-btn {{type === 'expense' ? 'expense active' : ''}}"
      data-type="expense"
      bindtap="switchType"
    >支出类目</view>
    <view 
      class="type-btn {{type === 'income' ? 'income active' : ''}}"
      data-type="income"
      bindtap="switchType"
    >收入类目</view>
  </view>

  <view class="section-bar">
    <view class="section-title">共 {{parents.length}} 个一级类目</view>
    <view class="bar-btns">
      <view class="bar-btn" bindtap="addParent">+ 新建类目</view>
      <view class="bar-btn danger" bindtap="resetAll">恢复默认</view>
    </view>
  </view>

  <view class="parent-list">
    <view wx:for="{{parents}}" wx:key="_id" class="parent-card">
      <view class="parent-header">
        <view class="parent-main">
          <view class="parent-icon-box" data-id="{{item._id}}" catchtap="pickParentIcon">{{item.icon}}</view>
          <view class="parent-info">
            <view class="parent-name">{{item.name}}</view>
            <view class="parent-count">{{item.children.length}} 个子类目</view>
          </view>
        </view>
        <view class="parent-actions">
          <view class="action-btn edit" data-id="{{item._id}}" catchtap="editParent">改名称</view>
          <view wx:if="{{!item.isDefault}}" class="action-btn del" data-id="{{item._id}}" catchtap="deleteParent">删除</view>
        </view>
      </view>

      <view class="child-list">
        <view wx:for="{{item.children}}" wx:for-item="child" wx:key="_id" class="child-row">
          <view class="child-icon-box" data-parentid="{{item._id}}" data-id="{{child._id}}" catchtap="pickChildIcon">{{child.icon}}</view>
          <view class="child-name">{{child.name}}</view>
          <view class="child-actions">
            <view class="action-btn small" data-parentid="{{item._id}}" data-id="{{child._id}}" catchtap="editChild">改</view>
            <view class="action-btn small del" data-parentid="{{item._id}}" data-id="{{child._id}}" catchtap="deleteChild">删</view>
          </view>
        </view>
        <view class="child-row add" data-parentid="{{item._id}}" catchtap="addChild">
          <view class="child-icon-box">➕</view>
          <view class="child-name">添加子类目</view>
        </view>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{showIconPicker}}" class="icon-picker-mask" bindtap="closeIconPicker">
  <view class="icon-picker" catchtap="">
    <view class="picker-title">选择图标</view>
    <view class="icon-grid">
      <view 
        wx:for="{{currentIcons}}" 
        wx:key="*this"
        class="icon-cell"
        data-icon="{{item}}"
        catchtap="selectIcon"
      >{{item}}</view>
    </view>
    <view class="picker-cancel" bindtap="closeIconPicker">取消</view>
  </view>
</view>