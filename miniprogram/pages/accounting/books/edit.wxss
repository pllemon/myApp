.form-item:last-child {
  border-bottom: none;
}




.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.icon-item {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #F5F7FA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s ease;
}

.icon-item.active {
  border-color: var(--theme-primary, #4A90D9);
  background: rgba(74, 144, 217, 0.1);
}

.color-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.color-item {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
}

.color-item.active {
  border-color: #333;
}

.color-check {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.3);
}

.preview-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
}

.preview-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid;
}

.preview-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.preview-info {
  flex: 1;
  min-width: 0;
}

.preview-name {
  font-size: 32rpx;
  font-weight: 600;
}

.preview-note {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}