.m2-edit-main { flex: 1; min-width: 0; }

.preview-card {
  display: flex; align-items: center; gap: var(--space-md);
  padding: var(--space-md); border-radius: var(--radius-md); border: 2rpx solid;
}
.preview-icon {
  width: 88rpx; height: 88rpx; flex-shrink: 0; border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
}
.preview-info { flex: 1; min-width: 0; }
.preview-name { font-size: var(--font-lg); font-weight: 600; }
