.hint { font-size: var(--font-sm); color: var(--text-3); text-align: center; padding: var(--space-sm) 0 var(--space-md); }
.skeleton-card { height: 140rpx; border-radius: var(--radius-md); margin-bottom: var(--space-md); }

.book-card.active { border: 2rpx solid var(--primary); background: var(--primary-light); }
.book-left { display: flex; align-items: center; gap: var(--space-md); min-width: 0; flex: 1; }
.book-icon {
  width: 88rpx; height: 88rpx; flex-shrink: 0; border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
}
.book-info { min-width: 0; }
.book-name { display: flex; align-items: center; gap: 12rpx; font-size: var(--font-lg); font-weight: 600; color: var(--text); }
.current-tag { font-size: var(--font-xs); background: var(--primary); color: var(--text-inverse); padding: 4rpx 14rpx; border-radius: var(--radius-full); }

.row-actions { display: flex; gap: 10rpx; flex-shrink: 0; margin-left: var(--space-sm); }
.action-btn { padding: 8rpx 18rpx; border-radius: var(--radius-full); background: var(--primary-light); color: var(--primary-dark); font-size: var(--font-sm); }
.action-btn.del { background: var(--danger-light); color: var(--danger); }
