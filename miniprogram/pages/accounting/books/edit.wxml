<view class="m2-page" style="{{themeStyle}}">
  <!-- 页面标题 -->
  <view class="m2-edit-hero">
    <view class="m2-edit-hero-icon" style="background: var(--primary-light)">
      <m-icon name="wallet" size="44" />
    </view>
    <view class="m2-edit-main">
      <view class="m2-edit-title">{{isEdit ? '编辑账本' : '新建账本'}}</view>
      <view class="m2-edit-desc">设置名称、图标与颜色</view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="m2-form-card">
    <view class="m2-field">
      <view class="m2-field-label">账本名称</view>
      <input
        class="m2-field-value"
        placeholder="如：家庭账本"
        value="{{name}}"
        bindinput="onNameInput"
        maxlength="20"
      />
    </view>
    <view class="m2-field">
      <view class="m2-field-label">备注</view>
      <input
        class="m2-field-value"
        placeholder="账本说明（可选）"
        value="{{note}}"
        bindinput="onNoteInput"
        maxlength="50"
      />
    </view>
  </view>

  <!-- 图标 -->
  <view class="m2-form-card">
    <view class="m2-form-title">选择图标</view>
    <m-icon-picker icons="{{iconChoices}}" value="{{icon}}" bind:select="selectIcon" />
  </view>

  <!-- 颜色 -->
  <view class="m2-form-card">
    <view class="m2-form-title">选择颜色</view>
    <m-color-picker colors="{{colorChoices}}" color="{{color}}" bind:change="selectColor" />
  </view>

  <!-- 预览 -->
  <view class="m2-form-card">
    <view class="m2-form-title">预览</view>
    <view class="preview-card" style="background: {{color}}15; border-color: {{color}};">
      <view class="preview-icon" style="background: {{color}}20;">
        <m-icon value="{{icon}}" size="36" />
      </view>
      <view class="preview-info">
        <view class="preview-name" style="color: {{color}};">{{name || '账本名称'}}</view>
        <view class="m2-row-sub" wx:if="{{note}}">{{note}}</view>
      </view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="m2-footer">
    <view class="m2-btn m2-btn-primary" bindtap="save">保存</view>
  </view>
</view>
