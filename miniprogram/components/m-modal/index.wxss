.m-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: var(--z-modal);
  background: var(--mask);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-lg);
  box-sizing: border-box;
  animation: m-modal-fade var(--duration) var(--ease);
}

.m-modal-bottom {
  align-items: flex-end;
  padding: 0;
}

.m-modal-panel {
  width: 100%;
  max-width: 640rpx;
  max-height: 80vh;
  background: var(--surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: m-modal-rise var(--duration) var(--ease);
}

.m-modal-bottom .m-modal-panel {
  max-width: none;
  max-height: 86vh;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.m-modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: var(--space-md) var(--space-md) var(--space-sm);
  border-bottom: 1rpx solid var(--border);
}

.m-modal-heading {
  flex: 1;
  min-width: 0;
}

.m-modal-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text);
}

.m-modal-subtitle {
  display: block;
  margin-top: var(--space-xs);
  font-size: var(--font-md);
  color: var(--text-3);
}

.m-modal-close {
  width: 48rpx;
  height: 48rpx;
  margin-left: var(--space-sm);
  text-align: center;
  line-height: 44rpx;
  font-size: 40rpx;
  color: var(--text-3);
}

.m-modal-body {
  padding: var(--space-md);
  overflow-y: auto;
  box-sizing: border-box;
}

.m-modal-footer {
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-md) var(--space-md);
  border-top: 1rpx solid var(--border);
}

.m-modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: var(--radius-full);
  font-size: var(--font-base);
  font-weight: 600;
}

.m-modal-btn:active {
  opacity: 0.85;
}

.m-modal-btn-cancel {
  color: var(--text-2);
  background: var(--surface-2);
}

.m-modal-btn-confirm {
  color: var(--text-inverse);
  background: var(--primary);
  box-shadow: var(--shadow-primary);
}

.m-modal-btn-confirm.is-disabled {
  opacity: 0.5;
}

@keyframes m-modal-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes m-modal-rise {
  from { transform: translateY(32rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
