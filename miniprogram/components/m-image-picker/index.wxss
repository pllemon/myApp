/* 组件私有样式：不再依赖 app.wxss 的类选择器（自定义组件默认样式隔离） */
.mp-root { width: 100%; }

.mp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.mp-label { font-size: 26rpx; color: var(--text-2); font-weight: 600; }

.mp-count {
  font-size: 24rpx;
  color: var(--primary-dark);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  background: var(--primary-light);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.mp-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }

.mp-item {
  width: calc((100% - 32rpx) / 3);
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: visible;
  position: relative;
  background: var(--surface-2);
}

.mp-thumb {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  display: block;
}

.mp-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.62);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.mp-add {
  width: calc((100% - 32rpx) / 3);
  aspect-ratio: 1;
  border-radius: 16rpx;
  border: 2rpx dashed var(--border);
  background: var(--bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.mp-add-icon { font-size: 56rpx; color: var(--text-3); line-height: 1; }

.mp-add-text { font-size: 24rpx; color: var(--text-3); margin-top: 8rpx; }

/* 小尺寸：待办附件 */
.mp-grid-sm .mp-item,
.mp-grid-sm .mp-add { width: 140rpx; height: 140rpx; }

/* 大尺寸：预留 */
.mp-grid-lg .mp-item,
.mp-grid-lg .mp-add { width: 280rpx; height: 280rpx; }

.mp-tip { font-size: 22rpx; color: var(--text-3); margin-top: 12rpx; line-height: 1.5; }
