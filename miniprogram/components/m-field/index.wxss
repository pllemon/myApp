.m-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.m-field:last-child {
  border-bottom: none;
}

.m-field-click {
  cursor: pointer;
}

.m-field-click:active {
  background: #f9f9f9;
}

.m-field-block {
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.m-field-block .m-field-label {
  font-size: 28rpx;
  color: #333;
}

.m-field-block .m-field-content {
  width: 100%;
}

.m-field-half {
  flex: 1;
  min-width: 0;
}

.m-field-label {
  color: #666;
  flex-shrink: 0;
  margin-right: 20rpx;
  font-size: 28rpx;
}

.m-field-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
  gap: 8rpx;
}