.m-empty {
  padding: 100rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.m-empty.compact {
  padding: 40rpx 0;
}

.m-empty-icon {
  font-size: 120rpx;
  line-height: 1;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.m-empty.compact .m-empty-icon {
  display: none;
}

.m-empty-title {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.m-empty.compact .m-empty-title {
  font-size: 26rpx;
  margin-bottom: 0;
  font-weight: normal;
}

.m-empty-desc {
  font-size: 26rpx;
  color: #bbb;
  line-height: 1.6;
}

.m-empty-action {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  background: var(--primary, #4A90D9);
  border-radius: 48rpx;
}

.m-empty-action-text {
  color: #fff;
  font-size: 28rpx;
}