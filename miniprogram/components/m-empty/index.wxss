.m-empty {
  padding: 100rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.m-empty.compact {
  padding: 40rpx 0;
}

.m-empty-fixed-icon { width: 128rpx; height: 128rpx; margin-bottom: 24rpx; }

.m-empty.compact .m-empty-fixed-icon { display: none }

.m-empty-title {
  font-size: 30rpx;
  color: var(--text-3);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.m-empty.compact .m-empty-title {
  font-size: 26rpx;
  margin-bottom: 0;
  font-weight: normal;
}

.m-empty-desc {
  font-size: 26rpx;
  color: var(--text-3);
  line-height: 1.6;
}

.m-empty-action {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  background: var(--primary);
  border-radius: 48rpx;
}

.m-empty-action-text {
  color: var(--text-inverse);
  font-size: 28rpx;
}