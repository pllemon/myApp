.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
  display: flex;
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: relative;
}

.tab-icon-wrap {
  position: relative;
  width: 64rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  font-size: 44rpx;
  line-height: 1;
}

.tab-text {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

.tab-item.active .tab-text {
  font-weight: 600;
}

.tab-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  font-size: 20rpx;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 0 8rpx;
  text-align: center;
}

.tab-dot {
  position: absolute;
  top: -4rpx;
  right: -12rpx;
  width: 16rpx;
  height: 16rpx;
  background: #ff4d4f;
  border-radius: 8rpx;
}