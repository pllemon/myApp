.m-option-picker {
  font-size: 28rpx;
}

.m-option-picker .m-form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--surface-3);
}

.m-option-picker .m-form-item:last-child {
  border-bottom: none;
}

.m-option-picker .m-form-item.click:active {
  background: var(--surface-2);
}

.m-option-picker .m-form-key {
  color: var(--text-2);
  flex-shrink: 0;
  margin-right: 20rpx;
  font-size: 28rpx;
}

.m-option-picker .m-form-picker-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
  gap: 8rpx;
  color: var(--text);
}

.m-option-picker .m-picker-arrow {
  font-size: 24rpx;
  color: var(--text-3);
}

.m-option-picker .option-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 8rpx 28rpx 16rpx;
}

.m-option-picker .option-item {
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
  background-color: var(--surface-3);
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 1rpx solid transparent;
  transition: all 0.15s;
}

.m-option-picker .option-item.active {
  background-color: var(--primary-light);
  color: var(--primary);
  border-color: var(--primary);
}