.m-loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 56rpx 24rpx;
}

.m-loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--divider);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: m-loading-spin 0.8s linear infinite;
}

.m-loading-text {
  font-size: 26rpx;
  color: var(--text-3);
}

@keyframes m-loading-spin {
  to { transform: rotate(360deg); }
}
