<view class="m-save-bar {{fixed ? 'm-save-bar-fixed' : ''}}">
  <view wx:if="{{showDelete}}" class="m-save-bar-delete" bindtap="onDelete">
    <text class="m-save-bar-delete-text">🗑 删除</text>
  </view>
  <view class="m-save-bar-save" bindtap="onSave">
    <text>{{saveText}}</text>
  </view>
</view>