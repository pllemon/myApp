.m-save-bar {
  padding: 20rpx 28rpx 40rpx;
  display: flex;
  gap: 20rpx;
  background: transparent;
}

.m-save-bar-fixed {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  padding-top: 16rpx;
  background: var(--surface);
  backdrop-filter: blur(10px);
  z-index: 999;
  border-top: 1rpx solid var(--divider);
}

.m-save-bar-save {
  flex: 1;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: var(--text-inverse);
  text-align: center;
  padding: 24rpx 0;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: var(--shadow-primary);
}

.m-save-bar-expense {
  background: linear-gradient(135deg, var(--accent) 0%, var(--danger) 100%);
  box-shadow: var(--shadow-md);
}

.m-save-bar-income {
  background: var(--success);
  box-shadow: var(--shadow-md);
}

.m-save-bar-save:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.m-save-bar-saving {
  opacity: 0.68;
}

.m-save-bar-delete {
  background: var(--surface);
  border: 1rpx solid var(--danger);
  padding: 0 32rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.m-save-bar-delete:active {
  background: var(--danger-light);
}

.m-save-bar-delete-text {
  color: var(--danger);
  font-size: 28rpx;
}